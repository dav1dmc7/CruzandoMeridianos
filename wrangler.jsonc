{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cruzandomeridianos",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "cruzandomeridianos_leads",
      "database_name": "cruzandomeridianos-leads",
      "database_id": "92e9d032-4a04-4161-81fc-cfce9094dc58",
      "migrations_dir": "./migrations"
    }
  ]
}
