---
interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  type?: "website" | "article";
  noindex?: boolean;
}

const {
  title = "Cruzando Meridianos | Viajes con investigación y criterio",
  description = "Investigamos destinos, contrastamos información y contamos lo que realmente importa para que puedas decidir mejor cómo viajar.",
  canonical,
  ogImage = "/brujula.png",
  type = "website",
  noindex = false,
} = Astro.props;

const siteUrl = "https://www.cruzandomeridianos.com";

const canonicalUrl = canonical
  ? new URL(canonical, siteUrl).href
  : new URL(Astro.url.pathname, siteUrl).href;

const ogImageUrl = new URL(ogImage, siteUrl).href;
const currentPath = Astro.url.pathname;
const isCostaRicaGuide = currentPath.startsWith("/viajes/costa-rica");

const costaRicaDecisionLabels: Record<string, string> = {
  "/viajes/costa-rica": "Guía de Costa Rica",
  "/viajes/costa-rica/mejor-epoca": "Mejor época para viajar a Costa Rica",
  "/viajes/costa-rica/alquilar-coche": "Alquilar coche en Costa Rica",
  "/viajes/costa-rica/caribe-o-pacifico": "Caribe o Pacífico en Costa Rica",
  "/viajes/costa-rica/cuanto-tiempo": "Cuánto tiempo viajar a Costa Rica",
  "/viajes/costa-rica/parques-nacionales": "Parques nacionales de Costa Rica",
};

const costaRicaBreadcrumbLabel = costaRicaDecisionLabels[currentPath];
const costaRicaBreadcrumbSchema = costaRicaBreadcrumbLabel
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Inicio",
          item: `${siteUrl}/`,
        },
        ...(currentPath === "/viajes/costa-rica"
          ? []
          : [
              {
                "@type": "ListItem",
                position: 2,
                name: "Guía de Costa Rica",
                item: `${siteUrl}/viajes/costa-rica`,
              },
              {
                "@type": "ListItem",
                position: 3,
                name: costaRicaBreadcrumbLabel,
                item: canonicalUrl,
              },
            ]),
      ],
    }
  : null;

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Cruzando Meridianos",
  url: `${siteUrl}/`,
  inLanguage: "es",
  description:
    "Investigación, experiencias y criterio para viajar mejor.",
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Cruzando Meridianos",
  url: `${siteUrl}/`,
  logo: new URL("/brujula.png", siteUrl).href,
  founder: [
    {
      "@type": "Person",
      name: "David",
    },
    {
      "@type": "Person",
      name: "Itciar",
    },
  ],
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": type === "article" ? "Article" : "WebPage",
  name: title,
  description,
  url: canonicalUrl,
  inLanguage: "es",
  isPartOf: {
    "@type": "WebSite",
    name: "Cruzando Meridianos",
    url: `${siteUrl}/`,
  },
  publisher: {
    "@type": "Organization",
    name: "Cruzando Meridianos",
    url: `${siteUrl}/`,
  },
};

import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import CostaRicaDecisionNav from "../components/sections/CostaRicaDecisionNav.astro";
import RelatedGuides from "../components/sections/RelatedGuides.astro";
import LiveGuideStatus from "../components/guides/LiveGuideStatus.astro";
import GeoTransition from "../components/interaction/GeoTransition.astro";
import SiteInstrumentation from "../components/analytics/SiteInstrumentation.astro";
import "../styles/visual-polish.css";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>

    <meta name="description" content={description} />
    <meta name="author" content="Cruzando Meridianos" />

    <meta
      name="robots"
      content={noindex ? "noindex, nofollow" : "index, follow"}
    />

    <meta name="theme-color" content="#FBF9F5" />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Cruzando Meridianos" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={title} />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify([
        websiteSchema,
        organizationSchema,
        webPageSchema,
        ...(costaRicaBreadcrumbSchema ? [costaRicaBreadcrumbSchema] : []),
      ])}
    />

    <link rel="icon" type="image/png" href="/brujula.png" />
    <link rel="apple-touch-icon" href="/brujula.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Newsreader:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <a class="skip-link" href="#main-content">Saltar al contenido</a>
    <Header />
    {isCostaRicaGuide && <CostaRicaDecisionNav />}
    <LiveGuideStatus />
    <div id="main-content"><slot /></div>
    <RelatedGuides />
    <GeoTransition />
    <SiteInstrumentation />
  </body>
</html>
