  --resources-bg:
    var(--color-papel);

  --resources-text:
    var(--color-bosque);

  --resources-muted:
    #666;

  --resources-border:
    rgba(
      28,
      48,
      38,
      .13
    );

  --resources-accent:
    var(--color-cobre);

  padding:
    8rem 0;

  background:
    var(--resources-bg);
}


.travel-resources__shell {
  width:
    min(
      var(--content-width),
      calc(100% - 4rem)
    );

  margin-inline:
    auto;
}


/* ============================================================
   HEADER
   ============================================================ */

.travel-resources__header {
  display:
    grid;

  grid-template-columns:
    1fr .65fr;

  gap:
    5rem;

  align-items:
    end;

  margin-bottom:
    3rem;
}


.travel-resources__header h2 {
  max-width:
    850px;

  margin:
    0;

  font-family:
    var(--font-serif);

  font-size:
    clamp(
      3rem,
      5.5vw,
      5.8rem
    );

  font-weight:
    400;

  line-height:
    .95;

  letter-spacing:
    -.04em;

  color:
    var(--resources-text);
}


.travel-resources__intro {
  margin:
    0;

  color:
    var(--resources-muted);

  line-height:
    1.8;
}


/* ============================================================
   TRANSPARENCY
   ============================================================ */

.travel-resources__disclosure {
  display:
    grid;

  grid-template-columns:
    140px 1fr;

  gap:
    2rem;

  padding:
    1.4rem 0;

  border-top:
    1px solid
    var(--resources-border);

  border-bottom:
    1px solid
    var(--resources-border);
}


.travel-resources__disclosure > span {
  color:
    var(--resources-accent);

  font-size:
    .66rem;

  font-weight:
    600;

  letter-spacing:
    .13em;

  text-transform:
    uppercase;
}


.travel-resources__disclosure p {
  max-width:
    760px;

  margin:
    0;

  color:
    #777;

  font-size:
    .78rem;

  line-height:
    1.65;
}


/* ============================================================
   FILTERS
   ============================================================ */

.travel-resources__filters {
  display:
    flex;

  flex-wrap:
    wrap;

  gap:
    .55rem;

  margin:
    2rem 0 2.5rem;
}


.travel-resource-filter {
  padding:
    .65rem .9rem;

  border:
    1px solid
    var(--resources-border);

