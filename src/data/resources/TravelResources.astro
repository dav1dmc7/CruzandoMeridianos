---
/**
 * ============================================================
 * CRUZANDO MERIDIANOS
 * TRAVEL RESOURCES — SAFE DATA ADAPTER
 * ============================================================
 *
 * Este componente está diseñado para convivir con el sistema
 * actual de recursos sin imponerle un contrato distinto.
 *
 * IMPORTANTE
 * ------------------------------------------------------------
 *
 * No asumimos nombres concretos de exports dentro de:
 *
 *   src/data/resources/index.ts
 *
 * ni propiedades adicionales que no formen parte del modelo real.
 *
 * El módulo se inspecciona de forma segura y los datos se
 * normalizan para presentación.
 *
 * Esto evita que una mejora visual rompa el sistema de tipos.
 * ============================================================
 */

 import * as resourceModule from "../../data/resources";


/* ============================================================
   PROPS
   ============================================================ */

interface Props {
  destinationSlug?: string;
  category?: string;
  limit?: number;
  showFilters?: boolean;
  title?: string;
  description?: string;
  variant?: "default" | "compact" | "featured";
}

const {
  destinationSlug,
  category,
  limit,
  showFilters = true,
  title =
    "Recursos que utilizamos cuando viajamos",
  description =
    "Herramientas y servicios que pueden ayudarte durante un viaje. Los mostramos separados del contenido editorial y con transparencia cuando existe una relación comercial.",
  variant = "default",
} = Astro.props;


/* ============================================================
   GENERIC SAFE TYPES
   ============================================================ */

type ResourceRecord =
  Record<string, unknown>;

type ResourceViewModel = {
  id: string;
  name: string;
  description: string;
  category: string;
  categoryLabel: string;
  url: string | null;
  buttonLabel: string;
  featured: boolean;
  logo: string | null;
  tagline: string | null;
  features: string[];
  typeLabel: string;
  disclosure: string | null;
  destinations: string[];
};


/* ============================================================
   HELPERS — SAFE DATA ACCESS
   ============================================================ */

const isRecord = (
  value: unknown
): value is ResourceRecord => {
  return (
    typeof value === "object" &&
    value !== null &&
    !Array.isArray(value)
  );
};


const toStringValue = (
  value: unknown
): string | null => {
  if (
    typeof value === "string" &&
    value.trim().length > 0
  ) {
    return value.trim();
  }

  return null;
};


const toBooleanValue = (
  value: unknown
): boolean => {
  return value === true;
};


const toStringArray = (
  value: unknown
): string[] => {

  if (!Array.isArray(value)) {
    return [];
  }

  return value
    .filter(
      (
        item
      ): item is string =>
        typeof item === "string"
    )
    .map(
      (item) =>
        item.trim()
    )
    .filter(
      (item) =>
        item.length > 0
    );
};


const firstString = (
  record: ResourceRecord,
  keys: string[]
): string | null => {

  for (const key of keys) {

    const value =
      toStringValue(
        record[key]
      );

    if (value) {
      return value;
    }
  }

  return null;
};


const firstBoolean = (
  record: ResourceRecord,
  keys: string[]
): boolean => {

  for (const key of keys) {

    if (
      typeof record[key] ===
      "boolean"
    ) {
      return Boolean(
        record[key]
      );
    }
  }

  return false;
};


const firstArray = (
  record: ResourceRecord,
  keys: string[]
): string[] => {

  for (const key of keys) {

    const value =
      toStringArray(
        record[key]
      );

    if (value.length > 0) {
      return value;
    }
  }

  return [];
};


/* ============================================================
   RESOURCE TYPE
   ============================================================ */

const getResourceTypeLabel = (
  value: unknown
): string => {

  const type =
    toStringValue(value);

  switch (type) {

    case "official":
      return "Fuente oficial";

    case "primary":
      return "Fuente primaria";

    case "secondary":
      return "Fuente secundaria";

    case "affiliate":
      return "Afiliación";

    case "referral":
      return "Referido";

    case "tool":
      return "Herramienta";

    case "service":
      return "Servicio";

    case "editorial":
      return "Editorial";

    default:
      return "Recurso";
  }
};


/* ============================================================
   CATEGORY LABEL
   ============================================================ */

const categoryLabels:
  Record<string, string> = {

  connectivity:
    "Conectividad",

  esim:
    "eSIM",

  money:
    "Dinero",

  insurance:
    "Seguro",

  transport:
    "Transporte",

  accommodation:
    "Alojamiento",

  flights:
    "Vuelos",

  maps:
    "Mapas",

  tools:
    "Herramientas",

  official:
    "Fuentes oficiales",

  health:
    "Salud",

  safety:
    "Seguridad",

  planning:
    "Planificación",

  other:
    "Otros",
};


const humanizeCategory = (
  value: string
): string => {

  if (
    categoryLabels[value]
  ) {
    return categoryLabels[
      value
    ];
  }

  return value
    .replace(
      /[-_]+/g,
      " "
    )
    .replace(
      /\b\w/g,
      (letter) =>
        letter.toUpperCase()
    );
};


/* ============================================================
   FIND RESOURCE COLLECTION
   ============================================================ */

const moduleEntries =
  Object.entries(
    resourceModule
  );


const findResourceCollection =
  (): unknown[] => {

    const preferredKeys = [
      "resources",
      "travelResources",
      "allResources",
      "resourceList",
      "travelResourceList",
    ];

    for (
      const key of preferredKeys
    ) {

      const value =
        resourceModule[
          key as keyof typeof resourceModule
        ];

      if (
        Array.isArray(value)
      ) {
        return value;
      }
    }

    for (
      const [
        key,
        value,
      ] of moduleEntries
    ) {

      if (
        key
          .toLowerCase()
          .includes("resource") &&
        Array.isArray(value)
      ) {
        return value;
      }
    }

    return [];
  };


/* ============================================================
   FIND CATEGORY COLLECTION
   ============================================================ */

const findCategoryCollection =
  (): unknown[] => {

    const preferredKeys = [
      "resourceCategories",
      "categories",
      "allResourceCategories",
      "resourceCategoryList",
    ];

    for (
      const key of preferredKeys
    ) {

      const value =
        resourceModule[
          key as keyof typeof resourceModule
        ];

      if (
        Array.isArray(value)
      ) {
        return value;
      }
    }

    for (
      const [
        key,
        value,
      ] of moduleEntries
    ) {

      const normalized =
        key.toLowerCase();

      if (
        normalized.includes(
          "categor"
        ) &&
        Array.isArray(value)
      ) {
        return value;
      }
    }

    return [];
  };


/* ============================================================
   RAW DATA
   ============================================================ */

const rawResources =
  findResourceCollection();

const rawCategories =
  findCategoryCollection();


/* ============================================================
   CATEGORY MAP
   ============================================================ */

const categoryMap =
  new Map<
    string,
    string
  >();


for (
  const item of rawCategories
) {

  if (
    !isRecord(item)
  ) {
    continue;
  }

  const id =
    firstString(
      item,
      [
        "id",
        "slug",
        "code",
        "value",
      ]
    );

  if (!id) {
    continue;
  }

  const label =
    firstString(
      item,
      [
        "label",
        "name",
        "title",
      ]
    ) ??
    humanizeCategory(
      id
    );

  categoryMap.set(
    id,
    label
  );
}


/* ============================================================
   NORMALIZE RESOURCE
   ============================================================ */

const normalizeResource = (
  value: unknown,
  index: number
): ResourceViewModel | null => {

  if (
    !isRecord(value)
  ) {
    return null;
  }

  const id =
    firstString(
      value,
      [
        "id",
        "slug",
        "code",
      ]
    ) ??
    `resource-${index + 1}`;


  const name =
    firstString(
      value,
      [
        "name",
        "title",
        "label",
        "provider",
      ]
    ) ??
    "Recurso";


  const description =
    firstString(
      value,
      [
        "description",
        "summary",
        "content",
        "text",
      ]
    ) ??
    "";


  const categoryValue =
    firstString(
      value,
      [
        "category",
        "categoryId",
        "categorySlug",
        "group",
      ]
    ) ??
    "other";


  const categoryLabel =
    categoryMap.get(
      categoryValue
    ) ??
    humanizeCategory(
      categoryValue
    );


  const url =
    firstString(
      value,
      [
        "url",
        "href",
        "link",
      ]
    );


  const buttonLabel =
    firstString(
      value,
      [
        "buttonLabel",
        "ctaLabel",
        "linkLabel",
        "actionLabel",
      ]
    ) ??
    "Ver recurso";


  const featured =
    firstBoolean(
      value,
      [
        "featured",
        "isFeatured",
        "highlighted",
      ]
    );


  const logo =
    firstString(
      value,
      [
        "logo",
        "logoUrl",
        "image",
        "imageUrl",
        "icon",
      ]
    );


  const tagline =
    firstString(
      value,
      [
        "tagline",
        "subtitle",
        "shortDescription",
      ]
    );


  const features =
    firstArray(
      value,
      [
        "features",
        "benefits",
        "highlights",
      ]
    );


  const disclosure =
    firstString(
      value,
      [
        "disclosure",
        "affiliateDisclosure",
        "legalDisclosure",
      ]
    );


  const destinations =
    firstArray(
      value,
      [
        "destinations",
        "destinationSlugs",
      ]
    );


  const active =
    !(
      "active" in value
    ) ||
    toBooleanValue(
      value.active
    );


  if (!active) {
    return null;
  }


  return {
    id,
    name,
    description,
    category:
      categoryValue,
    categoryLabel,
    url,
    buttonLabel,
    featured,
    logo,
    tagline,
    features,
    typeLabel:
      getResourceTypeLabel(
        value.type ??
        value.resourceType
      ),
    disclosure,
    destinations,
  };
};


/* ============================================================
   NORMALIZED RESOURCES
   ============================================================ */

const normalizedResources =
  rawResources
    .map(
      normalizeResource
    )
    .filter(
      (
        item
      ): item is ResourceViewModel =>
        item !== null
    );


/* ============================================================
   DESTINATION FILTER
   ============================================================ */

const destinationResources =
  normalizedResources.filter(
    (
      resource
    ) => {

      if (
        !destinationSlug
      ) {
        return true;
      }

      if (
        resource.destinations.length ===
        0
      ) {
        return true;
      }

      return resource.destinations.includes(
        destinationSlug
      );
    }
  );


/* ============================================================
   CATEGORY FILTER
   ============================================================ */

const categoryResources =
  destinationResources.filter(
    (
      resource
    ) => {

      if (
        !category
      ) {
        return true;
      }

      return (
        resource.category ===
        category
      );
    }
  );


/* ============================================================
   SORT
   ============================================================ */

const sortedResources =
  [
    ...categoryResources,
  ].sort(
    (
      a,
      b
    ) => {

      if (
        a.featured &&
        !b.featured
      ) {
        return -1;
      }

      if (
        !a.featured &&
        b.featured
      ) {
        return 1;
      }

      return a.name.localeCompare(
        b.name,
        "es"
      );
    }
  );


/* ============================================================
   LIMIT
   ============================================================ */

const resources =
  typeof limit ===
  "number" &&
  limit > 0
    ? sortedResources.slice(
        0,
        limit
      )
    : sortedResources;


/* ============================================================
   FILTER CATEGORIES
   ============================================================ */

const usedCategories =
  Array.from(
    new Set(
      resources.map(
        (
          resource
        ) =>
          resource.category
      )
    )
  );


const filterCategories =
  usedCategories.map(
    (
      id
    ) => ({
      id,
      label:
        categoryMap.get(
          id
        ) ??
        humanizeCategory(
          id
        ),
    })
  );


/* ============================================================
   JSON-LD
   ============================================================ */

const itemListSchema =
  resources.length > 0
    ? {
        "@context":
          "https://schema.org",

        "@type":
          "ItemList",

        itemListElement:
          resources.map(
            (
              resource,
              index
            ) => {

              const item: Record<
                string,
                unknown
              > = {

                "@type":
                  "ListItem",

                position:
                  index + 1,

                name:
                  resource.name,
              };

              if (
                resource.url
              ) {
                item.url =
                  resource.url;
              }

              return item;
            }
          ),
      }
    : null;
---


{
  resources.length > 0 ? (

    <section
      class:list={[
        "travel-resources",
        `travel-resources--${variant}`,
      ]}
      aria-labelledby="travel-resources-title"
    >

      {
        itemListSchema && (
          <script
            type="application/ld+json"
            is:inline
            set:html={JSON.stringify(
              itemListSchema
            )}
          />
        )
      }


      <div class="travel-resources__shell">


        <!-- ==================================================
             HEADER
        =================================================== -->

        <header
          class="travel-resources__header"
        >

          <div>

            <p class="eyebrow">
              Recursos de viaje
            </p>

            <h2
              id="travel-resources-title"
            >
              {title}
            </h2>

          </div>


          <p class="travel-resources__intro">
            {description}
          </p>

        </header>


        <!-- ==================================================
             TRANSPARENCY
        =================================================== -->

        <div
          class="travel-resources__disclosure"
          role="note"
        >

          <span>
            Transparencia
          </span>

          <p>
            Algunos enlaces pueden corresponder
            a servicios con los que tenemos una
            relación comercial, de afiliación o
            de referido. Cuando sea relevante,
            lo indicaremos claramente.
          </p>

        </div>


        <!-- ==================================================
             FILTERS
        =================================================== -->

        {
          showFilters &&
          filterCategories.length > 1 && (

            <div
              class="travel-resources__filters"
              data-resource-filters
            >

              <button
                type="button"
                class="travel-resource-filter is-active"
                data-resource-filter="all"
                aria-pressed="true"
              >
                Todos
              </button>


              {
                filterCategories.map(
                  (
                    resourceCategory
                  ) => (

                    <button
                      type="button"
                      class="travel-resource-filter"
                      data-resource-filter={
                        resourceCategory.id
                      }
                      aria-pressed="false"
                    >
                      {
                        resourceCategory.label
                      }
                    </button>

                  )
                )
              }

            </div>

          )
        }


        <!-- ==================================================
             RESOURCE GRID
        =================================================== -->

        <div
          class="travel-resources__grid"
          data-resource-grid
        >

          {
            resources.map(
              (
                resource,
                index
              ) => (

                <article
                  class:list={[
                    "travel-resource-card",

                    {
                      "travel-resource-card--featured":
                        resource.featured,

                      "travel-resource-card--hero":
                        variant ===
                          "featured" &&
                        index === 0,
                    },
                  ]}
                  data-resource-card
                  data-resource-category={
                    resource.category
                  }
                >

                  <div
                    class="travel-resource-card__top"
                  >

                    <span
                      class="travel-resource-card__category"
                    >
                      {
                        resource.categoryLabel
                      }
                    </span>


                    {
                      resource.featured && (
                        <span
                          class="travel-resource-card__featured"
                        >
                          Seleccionado
                        </span>
                      )
                    }

                  </div>


                  {
                    resource.logo && (
                      <div
                        class="travel-resource-card__logo"
                      >

                        <img
                          src={
                            resource.logo
                          }
                          alt=""
                          loading="lazy"
                          decoding="async"
                        />

                      </div>
                    )
                  }


                  <p
                    class="travel-resource-card__type"
                  >
                    {
                      resource.typeLabel
                    }
                  </p>


                  <h3>
                    {resource.name}
                  </h3>


                  {
                    resource.tagline && (
                      <p
                        class="travel-resource-card__tagline"
                      >
                        {
                          resource.tagline
                        }
                      </p>
                    )
                  }


                  {
                    resource.description && (
                      <p
                        class="travel-resource-card__description"
                      >
                        {
                          resource.description
                        }
                      </p>
                    )
                  }


                  {
                    resource.features.length >
                      0 && (

                      <ul
                        class="travel-resource-card__features"
                      >

                        {
                          resource.features.map(
                            (
                              feature
                            ) => (

                              <li>
                                <span
                                  aria-hidden="true"
                                >
                                  ✓
                                </span>

                                {
                                  feature
                                }
                              </li>

                            )
                          )
                        }

                      </ul>

                    )
                  }


                  <div
                    class="travel-resource-card__footer"
                  >

                    {
                      resource.url ? (

                        <a
                          href={
                            resource.url
                          }
                          target="_blank"
                          rel="noopener noreferrer"
                          class="travel-resource-card__link"
                        >

                          {
                            resource.buttonLabel
                          }

                          <span
                            aria-hidden="true"
                          >
                            ↗
                          </span>

                        </a>

                      ) : (

                        <span
                          class="
                            travel-resource-card__link
                            travel-resource-card__link--disabled
                          "
                        >
                          Próximamente
                        </span>

                      )
                    }

                  </div>


                  {
                    resource.disclosure && (
                      <p
                        class="travel-resource-card__disclosure"
                      >
                        {
                          resource.disclosure
                        }
                      </p>
                    )
                  }

                </article>

              )
            )
          }

        </div>


        <!-- ==================================================
             NO RESULTS AFTER CLIENT FILTER
        =================================================== -->

        <div
          class="travel-resources__filtered-empty"
          data-resource-empty
          hidden
        >

          <span>
            Sin resultados
          </span>

          <p>
            No hay recursos de esta categoría.
          </p>

        </div>

      </div>

    </section>

  ) : (

    <section
      class:list={[
        "travel-resources",
        `travel-resources--${variant}`,
      ]}
    >

      <div class="travel-resources__shell">

        <div
          class="travel-resources__empty"
        >

          <span>
            Recursos de viaje
          </span>

          <h2>
            Estamos preparando esta selección.
          </h2>

          <p>
            Preferimos publicar pocos recursos
            y que cada uno tenga una razón real
            para estar aquí.
          </p>

        </div>

      </div>

    </section>

  )
}


<!-- ========================================================
     CLIENT FILTERS
     ========================================================= -->

<script is:inline>
  (() => {

    const root =
      document.querySelector(
        ".travel-resources"
      );

    if (!root) {
      return;
    }


    const filters =
      Array.from(
        root.querySelectorAll(
          "[data-resource-filter]"
        )
      );


    const cards =
      Array.from(
        root.querySelectorAll(
          "[data-resource-card]"
        )
      );


    const empty =
      root.querySelector(
        "[data-resource-empty]"
      );


    if (
      filters.length === 0 ||
      cards.length === 0
    ) {
      return;
    }


    filters.forEach(
      (filter) => {

        filter.addEventListener(
          "click",
          () => {

            const category =
              filter.getAttribute(
                "data-resource-filter"
              );


            filters.forEach(
              (item) => {

                const active =
                  item === filter;

                item.classList.toggle(
                  "is-active",
                  active
                );

                item.setAttribute(
                  "aria-pressed",
                  String(active)
                );

              }
            );


            let visibleCount =
              0;


            cards.forEach(
              (card) => {

                const cardCategory =
                  card.getAttribute(
                    "data-resource-category"
                  );


                const visible =
                  category ===
                    "all" ||
                  cardCategory ===
                    category;


                card.hidden =
                  !visible;


                if (
                  visible
                ) {
                  visibleCount += 1;
                }

              }
            );


            if (empty) {

              empty.hidden =
                visibleCount > 0;

            }

          }
        );

      }
    );

  })();
</script>


<style>

