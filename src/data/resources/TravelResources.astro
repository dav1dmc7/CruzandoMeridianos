---
/**
 * ============================================================
 * CRUZANDO MERIDIANOS
 * TRAVEL RESOURCES
 * ============================================================
 *
 * Componente de presentación para los recursos de viaje.
 *
 * Consume directamente el registro público definido en:
 *
 *   src/data/resources/index.ts
 *
 * No contiene conocimiento de la estructura interna del
 * registro ni intenta autodetectar propiedades.
 *
 * ============================================================
 */

 import {
  getPublicTravelResources,
} from "./index";


/* ============================================================
   PROPS
   ============================================================ */

interface Props {
  destinationSlug?: string;
  category?: string;
  limit?: number;
  showFilters?: boolean;
  title?: string;
  description?: string;
  variant?: "default" | "compact" | "featured";
}


const {
  destinationSlug,
  category,
  limit,
  showFilters = true,
  title =
    "Recursos que utilizamos cuando viajamos",
  description =
    "Herramientas y servicios que pueden ayudarte durante un viaje. Los mostramos separados del contenido editorial y con transparencia cuando existe una relación comercial.",
  variant = "default",
} = Astro.props;


/* ============================================================
   CATEGORY LABELS
   ============================================================ */

const categoryLabels:
  Record<string, string> = {

  money:
    "Dinero",

  connectivity:
    "Conectividad",

  insurance:
    "Seguro",

  maps:
    "Mapas",

  bookings:
    "Reservas",

  gear:
    "Equipamiento",

  planning:
    "Planificación",

  communication:
    "Comunicación",

  other:
    "Otros",
};


const humanizeCategory =
  (
    value: string
  ): string => {

    if (
      categoryLabels[value]
    ) {
      return categoryLabels[value];
    }

    return value
      .replace(
        /[-_]+/g,
        " "
      )
      .replace(
        /\b\w/g,
        (letter) =>
          letter.toUpperCase()
      );
  };


/* ============================================================
   RESOURCE TYPE
   ============================================================ */

const getRelationshipLabel =
  (
    relationship?: string
  ): string => {

    switch (
      relationship
    ) {

      case "affiliate":
        return "Afiliación";

      case "referral":
        return "Referido";

      case "sponsor":
        return "Patrocinado";

      case "editorial":
        return "Recomendación editorial";

      default:
        return "Recurso";
    }
  };


/* ============================================================
   RESOURCE DATA
   ============================================================ */

const allResources =
  getPublicTravelResources();


/* ============================================================
   DESTINATION FILTER
   ============================================================ */

const destinationResources =
  allResources.filter(
    (
      resource
    ) => {

      if (
        !destinationSlug
      ) {
        return true;
      }

      if (
        !resource.relevantDestinations ||
        resource.relevantDestinations.length === 0
      ) {
        return true;
      }

      return resource
        .relevantDestinations
        .includes(
          destinationSlug
        );
    }
  );


/* ============================================================
   CATEGORY FILTER
   ============================================================ */

const categoryResources =
  destinationResources.filter(
    (
      resource
    ) => {

      if (
        !category
      ) {
        return true;
      }

      return (
        resource.category ===
        category
      );
    }
  );


/* ============================================================
   SORT
   ============================================================ */

const sortedResources =
  [
    ...categoryResources,
  ].sort(
    (
      a,
      b
    ) => {

      if (
        a.recommended &&
        !b.recommended
      ) {
        return -1;
      }

      if (
        !a.recommended &&
        b.recommended
      ) {
        return 1;
      }

      return (
        a.priority ??
        999
      ) -
      (
        b.priority ??
        999
      );
    }
  );


/* ============================================================
   LIMIT
   ============================================================ */

const resources =
  typeof limit ===
  "number" &&
  limit > 0
    ? sortedResources.slice(
        0,
        limit
      )
    : sortedResources;


/* ============================================================
   FILTER CATEGORIES
   ============================================================ */

const usedCategories =
  Array.from(
    new Set(
      destinationResources.map(
        (
          resource
        ) =>
          resource.category
      )
    )
  );


const filterCategories =
  usedCategories.map(
    (
      id
    ) => ({

      id,

      label:
        categoryLabels[id] ??
        humanizeCategory(id),

    })
  );


/* ============================================================
   JSON-LD
   ============================================================ */

const itemListSchema =
  resources.length > 0
    ? {

        "@context":
          "https://schema.org",

        "@type":
          "ItemList",

        itemListElement:
          resources.map(
            (
              resource,
              index
            ) => {

              const item:
                Record<
                  string,
                  unknown
                > = {

                "@type":
                  "ListItem",

                position:
                  index + 1,

                name:
                  resource.title,

              };

              if (
                resource.url
              ) {

                item.url =
                  resource.url;

              }

              return item;
            }
          ),

      }
    : null;


/* ============================================================
   HELPERS FOR TEMPLATE
   ============================================================ */

const getResourceHref =
  (
    resource: (typeof resources)[number]
  ): string =>
    resource.trackingUrl ??
    resource.url;


const getButtonLabel =
  (
    resource: (typeof resources)[number]
  ): string => {

    if (
      resource.relationship ===
      "referral"
    ) {
      return "Ver recurso";
    }

    if (
      resource.relationship ===
      "affiliate"
    ) {
      return "Ver recurso";
    }

    return "Visitar recurso";
  };
---


{
  resources.length > 0 ? (

    <section
      class:list={[
        "travel-resources",
        `travel-resources--${variant}`,
      ]}
      aria-labelledby="travel-resources-title"
    >

      {
        itemListSchema && (
          <script
            type="application/ld+json"
            is:inline
            set:html={JSON.stringify(
              itemListSchema
            )}
          />
        )
      }


      <div class="travel-resources__shell">


        <!-- ==================================================
             HEADER
        =================================================== -->

        <header
          class="travel-resources__header"
        >

          <div>

            <p class="eyebrow">
              Recursos de viaje
            </p>

            <h2
              id="travel-resources-title"
            >
              {title}
            </h2>

          </div>


          <p class="travel-resources__intro">
            {description}
          </p>

        </header>


        <!-- ==================================================
             TRANSPARENCY
        =================================================== -->

        <div
          class="travel-resources__disclosure"
          role="note"
        >

          <span>
            Transparencia
          </span>

          <p>
            Algunos enlaces pueden corresponder
            a servicios con los que tenemos una
            relación comercial, de afiliación o
            de referido. Cuando exista una relación
            comercial, la indicamos claramente.
          </p>

        </div>


        <!-- ==================================================
             FILTERS
        =================================================== -->

        {
          showFilters &&
          filterCategories.length > 1 && (

            <div
              class="travel-resources__filters"
              data-resource-filters
            >

              <button
                type="button"
                class="travel-resource-filter is-active"
                data-resource-filter="all"
                aria-pressed="true"
              >
                Todos
              </button>


              {
                filterCategories.map(
                  (
                    resourceCategory
                  ) => (

                    <button
                      type="button"
                      class="travel-resource-filter"
                      data-resource-filter={
                        resourceCategory.id
                      }
                      aria-pressed="false"
                    >
                      {
                        resourceCategory.label
                      }
                    </button>

                  )
                )
              }

            </div>

          )
        }


        <!-- ==================================================
             RESOURCE GRID
        =================================================== -->

        <div
          class="travel-resources__grid"
          data-resource-grid
        >

          {
            resources.map(
              (
                resource,
                index
              ) => (

                <article
                  class:list={[
                    "travel-resource-card",

                    {
                      "travel-resource-card--featured":
                        resource.recommended,

                      "travel-resource-card--hero":
                        variant ===
                          "featured" &&
                        index === 0,
                    },
                  ]}
                  data-resource-card
                  data-resource-category={
                    resource.category
                  }
                >

                  <div
                    class="travel-resource-card__top"
                  >

                    <span
                      class="travel-resource-card__category"
                    >
                      {
                        categoryLabels[
                          resource.category
                        ] ??
                        humanizeCategory(
                          resource.category
                        )
                      }
                    </span>


                    {
                      resource.recommended && (
                        <span
                          class="travel-resource-card__featured"
                        >
                          Seleccionado
                        </span>
                      )
                    }

                  </div>


                  <p
                    class="travel-resource-card__type"
                  >
                    {
                      getRelationshipLabel(
                        resource.relationship
                      )
                    }
                  </p>


                  <h3>
                    {resource.title}
                  </h3>


                  <p
                    class="travel-resource-card__provider"
                  >
                    {resource.provider}
                  </p>


                  <p
                    class="travel-resource-card__description"
                  >
                    {
                      resource.shortDescription
                    }
                  </p>


                  {
                    resource.benefit && (
                      <div
                        class="travel-resource-card__benefit"
                      >

                        <span>
                          Por qué lo utilizamos
                        </span>

                        <p>
                          {resource.benefit}
                        </p>

                      </div>
                    )
                  }


                  {
                    resource.limitation && (
                      <div
                        class="travel-resource-card__limitation"
                      >

                        <span>
                          A tener en cuenta
                        </span>

                        <p>
                          {resource.limitation}
                        </p>

                      </div>
                    )
                  }


                  <div
                    class="travel-resource-card__footer"
                  >

                    <a
                      href={
                        getResourceHref(
                          resource
                        )
                      }
                      target="_blank"
                      rel="noopener noreferrer"
                      class="travel-resource-card__link"
                    >

                      {
                        getButtonLabel(
                          resource
                        )
                      }

                      <span
                        aria-hidden="true"
                      >
                        ↗
                      </span>

                    </a>

                  </div>


                  {
                    resource.disclosure && (
                      <p
                        class="travel-resource-card__disclosure"
                      >
                        {
                          resource.disclosure
                        }
                      </p>
                    )
                  }


                  <p
                    class="travel-resource-card__reviewed"
                  >
                    Revisado:
                    {" "}
                    {resource.reviewedAt}
                  </p>

                </article>

              )
            )
          }

        </div>


        <!-- ==================================================
             NO RESULTS AFTER CLIENT FILTER
        =================================================== -->

        <div
          class="travel-resources__filtered-empty"
          data-resource-empty
          hidden
        >

          <span>
            Sin resultados
          </span>

          <p>
            No hay recursos de esta categoría.
          </p>

        </div>

      </div>

    </section>

  ) : (

    <section
      class:list={[
        "travel-resources",
        `travel-resources--${variant}`,
      ]}
    >

      <div class="travel-resources__shell">

        <div
          class="travel-resources__empty"
        >

          <span>
            Recursos de viaje
          </span>

          <h2>
            Estamos preparando esta selección.
          </h2>

          <p>
            Preferimos publicar pocos recursos
            y que cada uno tenga una razón real
            para estar aquí.
          </p>

        </div>

      </div>

    </section>

  )
}


<!-- ========================================================
     CLIENT FILTERS
     ========================================================= -->

<script is:inline>
  (() => {

    const roots =
      Array.from(
        document.querySelectorAll(
          ".travel-resources"
        )
      );

    roots.forEach(
      (root) => {

        const filters =
          Array.from(
            root.querySelectorAll(
              "[data-resource-filter]"
            )
          );


        const cards =
          Array.from(
            root.querySelectorAll(
              "[data-resource-card]"
            )
          );


        const empty =
          root.querySelector(
            "[data-resource-empty]"
          );


        if (
          filters.length === 0 ||
          cards.length === 0
        ) {
          return;
        }


        filters.forEach(
          (filter) => {

            filter.addEventListener(
              "click",
              () => {

                const category =
                  filter.getAttribute(
                    "data-resource-filter"
                  );


                filters.forEach(
                  (item) => {

                    const active =
                      item === filter;

                    item.classList.toggle(
                      "is-active",
                      active
                    );

                    item.setAttribute(
                      "aria-pressed",
                      String(active)
                    );

                  }
                );


                let visibleCount =
                  0;


                cards.forEach(
                  (card) => {

                    const cardCategory =
                      card.getAttribute(
                        "data-resource-category"
                      );


                    const visible =
                      category ===
                        "all" ||
                      cardCategory ===
                        category;


                    card.hidden =
                      !visible;


                    if (
                      visible
                    ) {
                      visibleCount += 1;
                    }

                  }
                );


                if (empty) {

                  empty.hidden =
                    visibleCount > 0;

                }

              }
            );

          }
        );

      }
    );

  })();
</script>


<style>

