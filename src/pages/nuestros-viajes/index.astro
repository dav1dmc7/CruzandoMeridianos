---
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/layout/Footer.astro";
import DestinationCard from "../../components/sections/DestinationCard.astro";
import { destinations } from "../../data/destinations";

const readyDestinations = destinations.filter(
  (destination) => destination.status === "ready",
);

const comingSoonDestinations = destinations.filter(
  (destination) => destination.status === "coming-soon",
);

const title = "Nuestros viajes | Cruzando Meridianos";

const description =
  "Viajes que hemos investigado, vivido y documentado. Descubre cómo viajamos y qué hay detrás de cada destino.";
---

<Layout
  title={title}
  description={description}
>
  <main>

    <!-- =====================================================
         HERO
         ===================================================== -->

    <section class="trips-hero">

      <div class="trips-hero-inner">

        <div class="trips-hero-copy">

          <span class="eyebrow">
            Nuestros viajes
          </span>

          <h1>
            Antes de diseñar<br />
            un viaje para ti,<br />
            <em>lo vivimos nosotros.</em>
          </h1>

          <p class="hero-description">
            No queremos recomendar destinos desde un escritorio.
            Viajamos, investigamos, nos equivocamos, descubrimos
            y tomamos notas. Después convertimos todo ese
            conocimiento en criterio.
          </p>

        </div>

        <div class="hero-index">

          <span>01</span>

          <p>
            Destinos<br />
            investigados
          </p>

        </div>

      </div>

    </section>


    <!-- =====================================================
         INTRODUCCIÓN
         ===================================================== -->

    <section class="trips-introduction">

      <div class="section-label">
        <span>La idea</span>
      </div>

      <div class="introduction-content">

        <h2>
          Un viaje no empieza<br />
          cuando compras un vuelo.
        </h2>

        <div class="introduction-text">

          <p>
            Empieza mucho antes: cuando decides qué quieres vivir,
            cuánto tiempo tienes y qué merece realmente la pena.
          </p>

          <p>
            Por eso nuestros viajes no son simples diarios de viaje.
            Son investigaciones sobre el terreno: lugares, rutas,
            tiempos, desplazamientos, experiencias, errores,
            decisiones y todo aquello que nos habría gustado saber
            antes de salir de casa.
          </p>

        </div>

      </div>

    </section>


    <!-- =====================================================
         DESTINOS VIVIDOS
         ===================================================== -->

    {readyDestinations.length > 0 && (

      <section class="trips-destinations">

        <div class="section-header">

          <div>

            <span class="eyebrow">
              Sobre el terreno
            </span>

            <h2>
              Viajes que ya hemos vivido.
            </h2>

          </div>

          <p>
            Aquí empieza nuestra biblioteca de experiencias.
            Cada destino irá creciendo con nuevas investigaciones,
            notas y aprendizajes.
          </p>

        </div>


        <div class="destination-list">

          {readyDestinations.map((destination, index) => (

            <DestinationCard
              destination={destination}
              featured={index === 0}
            />

          ))}

        </div>

      </section>

    )}


    <!-- =====================================================
         PRÓXIMOS VIAJES
         ===================================================== -->

    {comingSoonDestinations.length > 0 && (

      <section class="trips-coming">

        <div class="coming-header">

          <span class="eyebrow">
            Lo que estamos investigando
          </span>

          <h2>
            Algunos viajes<br />
            todavía están por vivir.
          </h2>

          <p>
            No publicamos una guía porque exista un destino.
            Primero queremos tener algo que aportar.
          </p>

        </div>


        <div class="coming-grid">

          {comingSoonDestinations.map((destination) => (

            <DestinationCard
              destination={destination}
            />

          ))}

        </div>

      </section>

    )}


    <!-- =====================================================
         FILOSOFÍA
         ===================================================== -->

    <section class="trips-philosophy">

      <div class="philosophy-inner">

        <div class="philosophy-number">
          02
        </div>

        <div class="philosophy-content">

          <span class="eyebrow">
            Lo que buscamos
          </span>

          <h2>
            No queremos conocer
            todos los lugares.
            <em>Queremos conocerlos bien.</em>
          </h2>

          <p>
            Hay miles de destinos sobre los que podemos hablar.
            Preferimos hablar de menos y haberlos investigado
            de verdad.
          </p>

        </div>

      </div>

    </section>


    <!-- =====================================================
         CTA
         ===================================================== -->

    <section class="trips-cta">

      <div class="cta-inner">

        <span class="eyebrow">
          Tu próximo viaje
        </span>

        <h2>
          ¿Y si empezamos<br />
          por tu viaje?
        </h2>

        <p>
          Cuéntanos qué tienes en mente. Nosotros empezamos
          a investigar qué podría tener sentido para ti.
        </p>

        <a
          href="/cuentatuviaje"
          class="cta-link"
        >
          Cuéntanos tu viaje
          <span aria-hidden="true">↗</span>
        </a>

      </div>

    </section>

  </main>

  <Footer />
</Layout>


<style>

/* =========================================================
   BASE
   ========================================================= */

main {
  overflow: hidden;
}


/* =========================================================
   HERO
   ========================================================= */

.trips-hero {
  padding:
    9rem 2rem
    7rem;

  background: var(--color-papel);
}

.trips-hero-inner {
  width: min(1200px, 100%);
  margin: 0 auto;

  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    auto;

  gap: 5rem;

  align-items: end;
}

.trips-hero-copy {
  max-width: 850px;
}

.eyebrow {
  display: block;

  margin-bottom: 1.5rem;

  color: var(--color-cobre);

  font-size: .72rem;
  font-weight: 500;

  letter-spacing: 2px;

  text-transform: uppercase;
}

.trips-hero h1 {
  margin: 0;

  max-width: 900px;

  font-family: var(--font-serif);

  font-size: clamp(
    4rem,
    7vw,
    7rem
  );

  font-weight: 400;

  line-height: .94;

  letter-spacing: -.045em;

  color: var(--color-bosque);
}

.trips-hero h1 em {
  color: var(--color-cobre);

  font-style: italic;
}

.hero-description {
  max-width: 590px;

  margin: 2.5rem 0 0;

  color: rgba(20, 45, 35, .68);

  font-size: 1.05rem;

  line-height: 1.8;
}

.hero-index {
  min-width: 130px;

  padding-bottom: .4rem;
}

.hero-index span {
  display: block;

  margin-bottom: .8rem;

  color: var(--color-cobre);

  font-family: var(--font-serif);

  font-size: 3rem;

  line-height: 1;
}

.hero-index p {
  margin: 0;

  color: rgba(20, 45, 35, .5);

  font-size: .7rem;

  line-height: 1.5;

  letter-spacing: 1.5px;

  text-transform: uppercase;
}


/* =========================================================
   INTRODUCCIÓN
   ========================================================= */

.trips-introduction {
  padding:
    7rem 2rem
    8rem;

  background: #f3f0e9;
}

.section-label {
  width: min(1200px, 100%);

  margin: 0 auto 4rem;

  padding-bottom: 1rem;

  border-bottom:
    1px solid rgba(20, 45, 35, .15);
}

.section-label span {
  color: var(--color-cobre);

  font-size: .7rem;

  letter-spacing: 1.8px;

  text-transform: uppercase;
}

.introduction-content {
  width: min(1200px, 100%);

  margin: 0 auto;

  display: grid;

  grid-template-columns:
    minmax(0, 1.3fr)
    minmax(280px, .7fr);

  gap: 8rem;

  align-items: start;
}

.introduction-content h2 {
  margin: 0;

  font-family: var(--font-serif);

  font-size: clamp(
    3rem,
    5vw,
    5.2rem
  );

  font-weight: 400;

  line-height: .98;

  letter-spacing: -.035em;

  color: var(--color-bosque);
}

.introduction-text {
  padding-top: .8rem;
}

.introduction-text p {
  margin: 0 0 1.5rem;

  color: rgba(20, 45, 35, .67);

  font-size: 1rem;

  line-height: 1.85;
}


/* =========================================================
   DESTINOS
   ========================================================= */

.trips-destinations {
  width: min(1200px, 100%);

  margin: 0 auto;

  padding:
    9rem 2rem
    10rem;
}

.section-header {
  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    minmax(280px, .55fr);

  gap: 5rem;

  align-items: end;

  margin-bottom: 5rem;
}

.section-header h2 {
  margin: 0;

  font-family: var(--font-serif);

  font-size: clamp(
    3rem,
    5vw,
    5rem
  );

  font-weight: 400;

  line-height: .98;

  letter-spacing: -.035em;

  color: var(--color-bosque);
}

.section-header > p {
  margin: 0;

  color: rgba(20, 45, 35, .62);

  font-size: .95rem;

  line-height: 1.8;
}

.destination-list {
  display: flex;

  flex-direction: column;

  gap: 9rem;
}


/* =========================================================
   PRÓXIMOS DESTINOS
   ========================================================= */

.trips-coming {
  padding:
    9rem 2rem
    10rem;

  background: #f3f0e9;
}

.coming-header {
  width: min(1200px, 100%);

  margin: 0 auto 5rem;
}

.coming-header h2 {
  margin: 0;

  max-width: 800px;

  font-family: var(--font-serif);

  font-size: clamp(
    3rem,
    5vw,
    5rem
  );

  font-weight: 400;

  line-height: .98;

  letter-spacing: -.035em;

  color: var(--color-bosque);
}

.coming-header p {
  max-width: 560px;

  margin: 2rem 0 0;

  color: rgba(20, 45, 35, .62);

  font-size: .95rem;

  line-height: 1.8;
}

.coming-grid {
  width: min(1200px, 100%);

  margin: 0 auto;

  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 6rem 3rem;
}


/* =========================================================
   FILOSOFÍA
   ========================================================= */

.trips-philosophy {
  padding:
    10rem 2rem;

  background: var(--color-bosque);

  color: var(--color-papel);
}

.philosophy-inner {
  width: min(1200px, 100%);

  margin: 0 auto;

  display: grid;

  grid-template-columns: 100px minmax(0, 850px);

  gap: 5rem;

  align-items: start;
}

.philosophy-number {
  padding-top: .5rem;

  color: var(--color-cobre);

  font-family: var(--font-serif);

  font-size: 3rem;
}

.philosophy-content h2 {
  margin: 0;

  font-family: var(--font-serif);

  font-size: clamp(
    3rem,
    5vw,
    5.5rem
  );

  font-weight: 400;

  line-height: .98;

  letter-spacing: -.035em;
}

.philosophy-content h2 em {
  color: var(--color-cobre);

  font-style: italic;
}

.philosophy-content p {
  max-width: 560px;

  margin: 2.5rem 0 0;

  color: rgba(251, 249, 245, .67);

  font-size: 1rem;

  line-height: 1.8;
}


/* =========================================================
   CTA
   ========================================================= */

.trips-cta {
  padding:
    10rem 2rem;

  background: var(--color-papel);
}

.cta-inner {
  width: min(1200px, 100%);

  margin: 0 auto;
}

.cta-inner h2 {
  margin: 0;

  max-width: 850px;

  font-family: var(--font-serif);

  font-size: clamp(
    4rem,
    7vw,
    7rem
  );

  font-weight: 400;

  line-height: .94;

  letter-spacing: -.045em;

  color: var(--color-bosque);
}

.cta-inner p {
  max-width: 500px;

  margin: 2rem 0 2rem;

  color: rgba(20, 45, 35, .62);

  font-size: 1rem;

  line-height: 1.8;
}

.cta-link {
  display: inline-flex;

  align-items: center;

  gap: .7rem;

  color: var(--color-bosque);

  text-decoration: none;

  font-size: .9rem;

  font-weight: 500;

  transition:
    color .2s ease;
}

.cta-link span {
  transition:
    transform .2s ease;
}

.cta-link:hover {
  color: var(--color-cobre);
}

.cta-link:hover span {
  transform:
    translate(3px, -3px);
}


/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 900px) {

  .trips-hero {
    padding:
      7rem 1.5rem
      5rem;
  }

  .trips-hero-inner {
    gap: 3rem;
  }

  .introduction-content {
    gap: 4rem;
  }

  .section-header {
    gap: 3rem;
  }

  .philosophy-inner {
    grid-template-columns:
      70px minmax(0, 1fr);

    gap: 3rem;
  }

}


/* =========================================================
   MÓVIL
   ========================================================= */

@media (max-width: 700px) {

  .trips-hero {
    padding:
      5.5rem 1.5rem
      4.5rem;
  }

  .trips-hero-inner {
    display: block;
  }

  .trips-hero h1 {
    font-size:
      clamp(3.3rem, 15vw, 5rem);
  }

  .hero-description {
    margin-top: 2rem;

    font-size: .98rem;
  }

  .hero-index {
    margin-top: 3rem;

    padding-top: 1.5rem;

    border-top:
      1px solid rgba(20, 45, 35, .14);
  }

  .trips-introduction {
    padding:
      5rem 1.5rem
      5.5rem;
  }

  .section-label {
    margin-bottom: 3rem;
  }

  .introduction-content {
    display: block;
  }

  .introduction-content h2 {
    font-size:
      clamp(2.8rem, 12vw, 4rem);
  }

  .introduction-text {
    margin-top: 2.5rem;
  }

  .trips-destinations {
    padding:
      6rem 1.5rem
      7rem;
  }

  .section-header {
    display: block;

    margin-bottom: 4rem;
  }

  .section-header h2 {
    font-size:
      clamp(2.8rem, 12vw, 4rem);
  }

  .section-header > p {
    margin-top: 2rem;
  }

  .destination-list {
    gap: 6rem;
  }

  .trips-coming {
    padding:
      6rem 1.5rem
      7rem;
  }

  .coming-header {
    margin-bottom: 4rem;
  }

  .coming-header h2 {
    font-size:
      clamp(2.8rem, 12vw, 4rem);
  }

  .coming-grid {
    grid-template-columns: 1fr;

    gap: 5rem;
  }

  .trips-philosophy {
    padding:
      6rem 1.5rem
      7rem;
  }

  .philosophy-inner {
    display: block;
  }

  .philosophy-number {
    margin-bottom: 2rem;
  }

  .philosophy-content h2 {
    font-size:
      clamp(2.8rem, 12vw, 4rem);
  }

  .trips-cta {
    padding:
      6rem 1.5rem
      7rem;
  }

  .cta-inner h2 {
    font-size:
      clamp(3.3rem, 15vw, 5rem);
  }

}


/* =========================================================
   MÓVIL PEQUEÑO
   ========================================================= */

@media (max-width: 400px) {

  .trips-hero h1,
  .cta-inner h2 {
    font-size: 3.15rem;
  }

}

</style>