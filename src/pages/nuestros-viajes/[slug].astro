---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/layout/Footer.astro";
import { getOurTripBySlug } from "../../data/our-trips";

import selvaCostaRica from "../../assets/images/costa-rica/selva-costa-rica.jpg";
import playaCostaRica from "../../assets/images/costa-rica/playa-costa-rica.jpg";
import rioPlaya from "../../assets/images/costa-rica/rio-playa.jpg";
import bosqueCascada from "../../assets/images/costa-rica/bosque-cascada.jpg";
import cascada from "../../assets/images/costa-rica/cascada.jpg";
import arbol from "../../assets/images/costa-rica/arbol.jpg";
import cocodrilo from "../../assets/images/costa-rica/cocodrilo.jpg";
import rana from "../../assets/images/costa-rica/rana.jpg";
import mono from "../../assets/images/costa-rica/mono.jpg";
import mono2 from "../../assets/images/costa-rica/Mono2.jpg";
import perezoso from "../../assets/images/costa-rica/perezoso.jpg";

const { slug } = Astro.params;

const trip = slug ? getOurTripBySlug(slug) : undefined;

if (!trip) {
  return Astro.redirect("/nuestros-viajes");
}

const title = `${trip.title} | Cruzando Meridianos`;
const description = trip.subtitle;

const metrics = trip.metrics;

const formatNumber = (value?: number) =>
  value?.toLocaleString("es-ES") ?? "—";

const formatDate = (date: string) =>
  new Date(`${date}T12:00:00`).toLocaleDateString("es-ES", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });

const formatBudgetCategory = (category: string) => {
  const labels: Record<string, string> = {
    flights: "Vuelos",
    car: "Coche de alquiler",
    fuel: "Combustible",
    accommodation: "Alojamiento",
    activities: "Actividades",
    transport: "Transporte",
  };

  return labels[category] ?? category;
};

const visitedPlaces = trip.places.filter(
  (place) => place.status === "visited",
);

const plannedPlaces = trip.plannedButNotVisited;
---

<Layout title={title} description={description}>
  <main class="trip-page">
    <!-- =========================================================
         HERO
    ========================================================== -->
    <section class="trip-hero" aria-labelledby="trip-title">
      <div class="trip-hero-inner">
        <div class="trip-hero-top">
          <a class="trip-back" href="/nuestros-viajes">
            <span aria-hidden="true">←</span>
            Volver a nuestros viajes
          </a>

          <span class="trip-hero-number" aria-hidden="true">01</span>
        </div>

        <div class="trip-hero-grid">
          <div class="trip-hero-content">
            <p class="trip-eyebrow">
              Nuestro viaje · {trip.destination}
            </p>

            <h1 id="trip-title">
              Nuestro viaje a {trip.destination}.
            </h1>

            <p class="trip-hero-subtitle">
              {trip.subtitle}
            </p>

            <div class="trip-hero-meta" aria-label="Fechas del viaje">
              <span>{formatDate(metrics.startDate)}</span>
              <span aria-hidden="true">·</span>
              <span>{formatDate(metrics.endDate)}</span>
            </div>
          </div>

          <figure class="trip-hero-figure">
            <Image
              src={selvaCostaRica}
              alt="Sendero entre la vegetación tropical de Costa Rica"
              loading="eager"
              sizes="(max-width: 900px) 100vw, 48vw"
            />

            <figcaption>
              Costa Rica · naturaleza, carretera y descubrimiento
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- =========================================================
         INTRODUCCIÓN
    ========================================================== -->
    <section class="trip-introduction">
      <div class="trip-introduction-inner">
        <div class="trip-section-label">
          <span>El viaje real</span>
        </div>

        <div class="trip-introduction-content">
          <h2>
            No queremos reconstruir<br />
            un viaje perfecto.
          </h2>

          <div class="trip-introduction-copy">
            <p>
              {trip.introduction}
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- =========================================================
         FOTO — RÍO Y PLAYA
    ========================================================== -->
    <section
      class="trip-photo-break"
      aria-label="Paisaje de Costa Rica"
    >
      <figure class="trip-photo-break-figure">
        <Image
          src={rioPlaya}
          alt="Río desembocando en una playa de Costa Rica"
          loading="lazy"
          sizes="100vw"
        />

        <figcaption>
          Río y playa · Costa Rica
        </figcaption>
      </figure>
    </section>

    <!-- =========================================================
         MÉTRICAS
    ========================================================== -->
    <section
      class="trip-metrics"
      aria-label="Datos principales del viaje"
    >
      <div class="trip-metrics-inner">
        <div class="trip-metric">
          <span class="trip-metric-value">
            {formatNumber(metrics.durationDays)}
          </span>

          <span class="trip-metric-label">
            días
          </span>
        </div>

        <div class="trip-metric">
          <span class="trip-metric-value">
            {formatNumber(metrics.carKm)}
          </span>

          <span class="trip-metric-label">
            km en coche
          </span>
        </div>

        <div class="trip-metric">
          <span class="trip-metric-value">
            {formatNumber(metrics.photos)}
          </span>

          <span class="trip-metric-label">
            fotografías
          </span>
        </div>

        <div class="trip-metric">
          <span class="trip-metric-value">
            {formatNumber(metrics.placesRecorded)}
          </span>

          <span class="trip-metric-label">
            lugares registrados
          </span>
        </div>

        <div class="trip-metric trip-metric-date">
          <span class="trip-metric-value">
            {formatDate(metrics.startDate)}
          </span>

          <span class="trip-metric-label">
            comienzo
          </span>
        </div>

        <div class="trip-metric trip-metric-date">
          <span class="trip-metric-value">
            {formatDate(metrics.endDate)}
          </span>

          <span class="trip-metric-label">
            final
          </span>
        </div>
      </div>
    </section>

    <!-- =========================================================
         POR QUÉ COSTA RICA
    ========================================================== -->
    <section class="trip-section trip-section-paper">
      <div class="trip-section-inner">
        <div class="trip-section-header">
          <span class="trip-section-number">02</span>

          <div>
            <p class="trip-eyebrow">
              Antes de salir
            </p>

            <h2>
              ¿Por qué {trip.destination}?
            </h2>
          </div>
        </div>

        <div class="trip-section-body">
          <div class="trip-section-lead">
            <p>
              Elegimos Costa Rica buscando una combinación de
              naturaleza, carretera, fauna y variedad de paisajes.
            </p>
          </div>

          <div class="trip-bullet-list">
            {
              trip.whyDestination.map((point) => (
                <div class="trip-bullet-item">
                  <span
                    class="trip-bullet-mark"
                    aria-hidden="true"
                  >
                    +
                  </span>

                  <p>{point}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- =========================================================
         QUÉ BUSCÁBAMOS
    ========================================================== -->
    <section class="trip-wanted">
      <div class="trip-wanted-inner">
        <div class="trip-section-header trip-section-header-light">
          <span class="trip-section-number">03</span>

          <div>
            <p class="trip-eyebrow">
              La idea inicial
            </p>

            <h2>
              Queríamos un viaje variado.
            </h2>
          </div>
        </div>

        <div class="trip-wanted-layout">
          <div class="trip-wanted-intro">
            <p>
              No buscábamos pasar todos los días en el mismo sitio.
              Queríamos combinar paisajes, naturaleza, carretera,
              animales, pueblos y momentos en los que simplemente
              dejarse llevar.
            </p>
          </div>

          <div class="trip-wanted-tags">
            {
              trip.whatWeWanted.map((item) => (
                <span class="trip-wanted-tag">
                  {item}
                </span>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- =========================================================
         NATURALEZA — BLOQUE FOTOGRÁFICO
    ========================================================== -->
    <section class="trip-photo-story">
      <div class="trip-photo-story-inner">
        <div class="trip-photo-story-copy">
          <p class="trip-eyebrow">
            El paisaje
          </p>

          <h2>
            La naturaleza no era el escenario.
            Era parte del viaje.
          </h2>

          <p>
            En Costa Rica, muchas de las decisiones de la ruta
            acababan teniendo que ver con lo que había alrededor:
            un bosque, una cascada, un río o simplemente una carretera
            que merecía la pena recorrer despacio.
          </p>
        </div>

        <div class="trip-photo-story-grid">
          <figure class="trip-story-photo trip-story-photo-large">
            <Image
              src={bosqueCascada}
              alt="Cascada entre el bosque tropical"
              loading="lazy"
              sizes="(max-width: 700px) 100vw, 55vw"
            />

            <figcaption>
              Bosque y cascada
            </figcaption>
          </figure>

          <figure class="trip-story-photo">
            <Image
              src={cascada}
              alt="Cascada en un entorno de bosque"
              loading="lazy"
              sizes="(max-width: 700px) 100vw, 30vw"
            />

            <figcaption>
              Agua y bosque
            </figcaption>
          </figure>

          <figure class="trip-story-photo">
            <Image
              src={arbol}
              alt="Árbol en el bosque tropical"
              loading="lazy"
              sizes="(max-width: 700px) 100vw, 30vw"
            />

            <figcaption>
              El bosque
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- =========================================================
         CÓMO DISEÑAMOS LA RUTA
    ========================================================== -->
    <section class="trip-section trip-route">
      <div class="trip-section-inner">
        <div class="trip-section-header">
          <span class="trip-section-number">04</span>

          <div>
            <p class="trip-eyebrow">
              La ruta
            </p>

            <h2>
              Cómo diseñamos el recorrido.
            </h2>
          </div>
        </div>

        <div class="trip-route-list">
          {
            trip.howWeDesignedTheRoute.map((item, index) => (
              <article class="trip-route-item">
                <span class="trip-route-index">
                  {String(index + 1).padStart(2, "0")}
                </span>

                <div class="trip-route-content">
                  <p>{item}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- =========================================================
         DECISIONES IMPORTANTES
    ========================================================== -->
    <section class="trip-decisions">
      <div class="trip-decisions-inner">
        <div class="trip-section-header">
          <div>
            <p class="trip-eyebrow">
              Sobre el terreno
            </p>

            <h2>
              Algunas decisiones importantes.
            </h2>
          </div>
        </div>

        <div class="trip-decisions-grid">
          {
            trip.importantDecisions.map((decision, index) => (
              <article class="trip-decision-card">
                <span class="trip-decision-number">
                  {String(index + 1).padStart(2, "0")}
                </span>

                <h3>{decision.title}</h3>

                <p>{decision.content}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- =========================================================
         FAUNA
    ========================================================== -->
    <section class="trip-fauna">
      <div class="trip-fauna-inner">
        <div class="trip-fauna-header">
          <p class="trip-eyebrow">
            Encuentros inesperados
          </p>

          <h2>
            Y luego están los animales.
          </h2>

          <p>
            Parte de lo que hace especial un viaje por Costa Rica
            es que la naturaleza aparece cuando menos te lo esperas.
          </p>
        </div>

        <div class="trip-fauna-grid">
          <figure
            class="trip-fauna-photo trip-fauna-featured"
          >
            <Image
              src={mono}
              alt="Mono entre la vegetación tropical"
              loading="lazy"
              sizes="(max-width: 700px) 100vw, 50vw"
            />

            <figcaption>
              Mono · entre la vegetación tropical
            </figcaption>
          </figure>

          <figure class="trip-fauna-photo">
            <Image
              src={perezoso}
              alt="Perezoso entre la vegetación tropical"
              loading="lazy"
              sizes="(max-width: 700px) 25vw"
            />

            <figcaption>
              Perezoso · quietud en el bosque
            </figcaption>
          </figure>

          <figure class="trip-fauna-photo">
            <Image
              src={cocodrilo}
              alt="Cocodrilo en Costa Rica"
              loading="lazy"
              sizes="(max-width: 700px) 25vw"
            />

            <figcaption>
              Cocodrilo · junto al agua
            </figcaption>
          </figure>

          <figure class="trip-fauna-photo">
            <Image
              src={rana}
              alt="Rana entre la vegetación tropical"
              loading="lazy"
              sizes="(max-width: 700px) 25vw"
            />

            <figcaption>
              Rana · escondida entre el verde
            </figcaption>
          </figure>

          <figure class="trip-fauna-photo trip-fauna-wide">
            <Image
              src={mono2}
              alt="Mono en la vegetación tropical"
              loading="lazy"
              sizes="(max-width: 700px) 50vw"
            />

            <figcaption>
              Otro encuentro · naturaleza a pie de ruta
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- =========================================================
         DATOS ADICIONALES
    ========================================================== -->
    <section class="trip-extra-metrics">
      <div class="trip-extra-metrics-inner">
        <div class="trip-extra-heading">
          <p class="trip-eyebrow">
            Algunos números más
          </p>

          <h2>
            Detrás del viaje también hay datos.
          </h2>
        </div>

        <div class="trip-extra-grid">
          <div class="trip-extra-item">
            <span class="trip-extra-value">
              {formatNumber(metrics.flightKm)}
            </span>

            <span class="trip-extra-label">
              km de vuelos
            </span>
          </div>

          <div class="trip-extra-item">
            <span class="trip-extra-value">
              {formatNumber(metrics.boatNm)}
            </span>

            <span class="trip-extra-label">
              millas náuticas
            </span>
          </div>

          <div class="trip-extra-item">
            <span class="trip-extra-value">
              {formatNumber(metrics.countries)}
            </span>

            <span class="trip-extra-label">
              {metrics.countries === 1 ? "país" : "países"}
            </span>
          </div>
</div>
      </div>
    </section>

    <!-- =========================================================
         LO QUE NO HICIMOS
    ========================================================== -->
    {
      plannedPlaces.length > 0 && (
        <section class="trip-not-visited">
          <div class="trip-not-visited-inner">
            <div class="trip-not-visited-heading">
              <p class="trip-eyebrow">
                También forma parte del viaje
              </p>

              <h2>
                Lo que no hicimos.
              </h2>

              <p>
                Un viaje también se construye con los lugares que
                decidimos dejar fuera.
              </p>
            </div>

            <div class="trip-not-visited-list">
              {plannedPlaces.map((place) => (
                <article class="trip-not-visited-item">
                  <div>
                    <h3>{place.title}</h3>
                  </div>

                  <div class="trip-not-visited-reason">
                    <p>{place.reason}</p>

                    {place.lesson && (
                      <p class="trip-not-visited-lesson">
                        {place.lesson}
                      </p>
                    )}
                  </div>
                </article>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- =========================================================
         ALOJAMIENTOS
    ========================================================== -->
    {
      trip.accommodations.length > 0 && (
        <section class="trip-accommodations">
          <div class="trip-accommodations-inner">
            <div class="trip-section-header">
              <div>
                <p class="trip-eyebrow">
                  Dormir
                </p>

                <h2>
                  Los alojamientos.
                </h2>
              </div>
            </div>

            <div class="trip-accommodations-list">
              {trip.accommodations.map((accommodation) => (
                <article class="trip-accommodation-item">
                  <div class="trip-accommodation-location">
                    {accommodation.location}
                  </div>

                  <div class="trip-accommodation-name">
                    {accommodation.name}
                  </div>

                  <div class="trip-accommodation-price">
                    {formatNumber(accommodation.amount)}
                    <span>
                      {accommodation.currency ?? ""}
                    </span>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- =========================================================
         PRESUPUESTO
    ========================================================== -->
    {
      trip.budget.length > 0 && (
        <section class="trip-budget">
          <div class="trip-budget-inner">
            <div class="trip-section-header">
              <div>
                <p class="trip-eyebrow">
                  El coste real
                </p>

                <h2>
                  Presupuesto del viaje.
                </h2>
              </div>
            </div>

            <div class="trip-budget-list">
              {trip.budget.map((item) => (
                <article class="trip-budget-item">
                  <div class="trip-budget-category">
                    {formatBudgetCategory(item.category)}
                  </div>

                  <div class="trip-budget-description">
                    {item.description}
                  </div>

                  <div class="trip-budget-amount">
                    {formatNumber(item.amount)}
                    <span>{item.currency}</span>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- =========================================================
         FOTO FINAL — PLAYA
    ========================================================== -->
    <section
      class="trip-final-photo"
      aria-label="Playa de Costa Rica"
    >
      <div class="trip-final-photo-inner">
        <figure>
          <Image
            src={playaCostaRica}
            alt="Playa tropical de Costa Rica"
            loading="lazy"
            sizes="100vw"
          />

          <figcaption>
            El viaje también termina aquí.
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- =========================================================
         GUÍA RELACIONADA
    ========================================================== -->
    <section class="trip-guide">
      <div class="trip-guide-inner">
        <div class="trip-guide-copy">
          <p class="trip-eyebrow">
            Si quieres seguir
          </p>

          <h2>
            Una guía para preparar tu propio viaje.
          </h2>

          <p>
            {trip.relatedGuide.description}
          </p>
        </div>

        <a
          class="trip-guide-link"
          href={trip.relatedGuide.href}
        >
          <span>
            {trip.relatedGuide.title}
          </span>

          <span
            class="trip-guide-arrow"
            aria-hidden="true"
          >
            →
          </span>
        </a>
      </div>
    </section>

    <!-- =========================================================
         CTA
    ========================================================== -->
    <section class="trip-cta">
      <div class="trip-cta-inner">
        <p class="trip-eyebrow">
          Tu próximo viaje
        </p>

        <h2>
          {trip.cta.title}
        </h2>

        <p>
          {trip.cta.description}
        </p>

        <a
          class="trip-cta-button"
          href={trip.cta.buttonHref}
        >
          {trip.cta.buttonLabel}

          <span aria-hidden="true">
            →
          </span>
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* ============================================================
     BASE
  ============================================================ */

  .trip-page {
    --trip-width: min(1200px, calc(100% - 4rem));
    --trip-wide-width: min(1400px, calc(100% - 4rem));

    overflow: hidden;
    background: var(--color-papel);
  }

  .trip-page *,
  .trip-page *::before,
  .trip-page *::after {
    box-sizing: border-box;
  }

  .trip-page figure {
    margin: 0;
  }

  .trip-page img {
    display: block;
    width: 100%;
  }

  .trip-eyebrow {
    margin: 0;
    color: var(--color-cobre);
    font-family: var(--font-sans, sans-serif);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  /* ============================================================
     HERO
  ============================================================ */

  .trip-hero {
    position: relative;
    background: var(--color-papel);
  }

  .trip-hero-inner {
    width: var(--trip-width);
    margin: 0 auto;
    padding: 2rem 0 6rem;
  }

  .trip-hero-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(28, 54, 42, 0.16);
  }

  .trip-back {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--color-bosque);
    font-family: var(--font-sans, sans-serif);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition:
      color 180ms ease,
      transform 180ms ease;
  }

  .trip-back:hover {
    color: var(--color-cobre);
    transform: translateX(-3px);
  }

  .trip-back:focus-visible,
  .trip-guide-link:focus-visible,
  .trip-cta-button:focus-visible {
    outline: 2px solid var(--color-cobre);
    outline-offset: 4px;
  }

  .trip-back span {
    font-size: 1rem;
  }

  .trip-hero-number {
    color: var(--color-bosque);
    font-family: var(--font-sans, sans-serif);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .trip-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(360px, 0.82fr);
    align-items: end;
    gap: clamp(3rem, 7vw, 7rem);
    padding-top: clamp(4rem, 8vw, 8rem);
  }

  .trip-hero-content {
    padding-bottom: 2rem;
  }

  .trip-hero-content h1 {
    max-width: 850px;
    margin: 1.4rem 0 2rem;
    color: var(--color-bosque);
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(4rem, 7.2vw, 8.5rem);
    font-weight: 400;
    letter-spacing: -0.055em;
    line-height: 0.88;
  }

  .trip-hero-subtitle {
    max-width: 640px;
    margin: 0;
    color: rgba(28, 54, 42, 0.78);
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(1.2rem, 1.8vw, 1.55rem);
    line-height: 1.55;
  }

  .trip-hero-meta {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-top: 2.5rem;
    color: rgba(28, 54, 42, 0.58);
    font-family: var(--font-sans, sans-serif);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .trip-hero-figure {
    position: relative;
    overflow: hidden;
    aspect-ratio: 0.78;
    background: #d8d5cc;
  }

  .trip-hero-figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .trip-hero-figure figcaption,
  .trip-photo-break figcaption,
  .trip-story-photo figcaption,
  .trip-fauna-photo figcaption,
  .trip-final-photo figcaption {
    margin-top: 0.75rem;
    color: rgba(28, 54, 42, 0.55);
    font-family: var(--font-sans, sans-serif);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  /* ============================================================
     INTRODUCCIÓN
  ============================================================ */

  .trip-introduction {
    background: #f3f0e9;
  }

  .trip-introduction-inner {
    width: var(--trip-width);
    margin: 0 auto;
    padding: clamp(6rem, 10vw, 10rem) 0;
  }

  .trip-section-label {
    margin-bottom: 4rem;
  }

  .trip-section-label span {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-cobre);
    font-family: var(--font-sans, sans-serif);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .trip-section-label span::before {
    content: "";
    width: 2.5rem;
    height: 1px;
    background: var(--color-cobre);
  }

  .trip-introduction-content {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(280px, 0.75fr);
    gap: clamp(3rem, 10vw, 10rem);
    align-items: start;
  }

  .trip-introduction-content h2 {
    margin: 0;
    color: var(--color-bosque);
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(2.8rem, 5.3vw, 5.8rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 0.96;
  }

  .trip-introduction-copy {
    padding-top: 0.5rem;
  }

  .trip-introduction-copy p {
    margin: 0;
    color: rgba(28, 54, 42, 0.78);
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(1.15rem, 1.6vw, 1.4rem);
    line-height: 1.7;
  }

  /* ============================================================
     FOTO BREAK
  ============================================================ */

  .trip-photo-break {
    padding: 0;
    background: #f3f0e9;
  }

  .trip-photo-break-figure {
    position: relative;
    width: var(--trip-wide-width);
    margin: 0 auto;
  }

  .trip-photo-break-figure img {
    width: 100%;
    height: min(72vh, 760px);
    object-fit: cover;
  }

  .trip-photo-break-figure figcaption {
    padding-bottom: 2rem;
  }

  /* ============================================================
     MÉTRICAS
  ============================================================ */

  .trip-metrics {
    background: var(--color-bosque);
    color: var(--color-papel);
  }

  .trip-metrics-inner {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    width: var(--trip-width);
    margin: 0 auto;
    padding: 4rem 0;
  }

  .trip-metric {
    min-height: 100px;
    padding: 0 1.5rem;
    border-left: 1px solid rgba(244, 241, 234, 0.2);
  }

  .trip-metric:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .trip-metric-value {
    display: block;
    color: var(--color-papel);
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(1.8rem, 3vw, 3rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .trip-metric-label {
    display: block;
    margin-top: 0.8rem;
    color: rgba(244, 241, 234, 0.58);
    font-family: var(--font-sans, sans-serif);
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .trip-metric-date .trip-metric-value {
    font-size: clamp(1rem, 1.6vw, 1.35rem);
    line-height: 1.2;
  }

  /* ============================================================
     SECCIONES GENERALES
  ============================================================ */

  .trip-section {
    background: var(--color-papel);
  }

  .trip-section-inner {
    width: var(--trip-width);
    margin: 0 auto;
    padding: clamp(7rem, 11vw, 11rem) 0;
  }

  .trip-section-paper {
    background: #f3f0e9;
  }

  .trip-section-header {
    display: grid;
    grid-template-columns: 90px minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
    margin-bottom: clamp(4rem, 7vw, 7rem);
  }

  .trip-section-number {
    color: var(--color-cobre);
    font-family: var(--font-sans, sans-serif);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .trip-section-header h2 {
    max-width: 850px;
    margin: 1rem 0 0;
    color: var(--color-bosque);
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(3rem, 5.5vw, 6.5rem);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 0.94;
  }

  .trip-section-body {
    display: grid;
    grid-template-columns: minmax(280px, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(4rem, 10vw, 10rem);
    padding-left: calc(90px + 2rem);
  }

  .trip-section-lead {
    margin: 0;
    color: var(--color-bosque);
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    line-height: 1.55;
  }

  .trip-section-lead p {
    margin: 0;
  }

  .trip-bullet-list {
    border-top: 1px solid rgba(28, 54, 42, 0.18);
  }

  .trip-bullet-item {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 1.5rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid rgba(28, 54, 42, 0.18);
  }

  .trip-bullet-mark {
    color: var(--color-cobre);
    font-family: var(--font-serif, Georgia, serif);
    font-size: 1.6rem;
    line-height: 1;
  }

  .trip-bullet-item p {
    margin: 0;
    color: rgba(28, 54, 42, 0.74);
    font-family: var(--font-sans, sans-serif);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  /* ============================================================
     QUÉ BUSCÁBAMOS
  ============================================================ */

  .trip-wanted {
    background: var(--color-bosque);
    color: var(--color-papel);
  }

  .trip-wanted-inner {
    width: var(--trip-width);
    margin: 0 auto;
    padding: clamp(7rem, 11vw, 11rem) 0;
  }

  .trip-section-header-light {
    margin-bottom: clamp(4rem, 7vw, 7rem);
  }

  .trip-section-header-light h2 {
    color: var(--color-papel);
  }

  .trip-wanted-layout {
    display: grid;
    grid-template-columns: minmax(280px, 0.75fr) minmax(0, 1.25fr);
    gap: clamp(4rem, 10vw, 10rem);
    padding-left: calc(90px + 2rem);
  }

  .trip-wanted-intro p {
    max-width: 500px;
    margin: 0;
    color: rgba(244, 241, 234, 0.72);
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(1.2rem, 1.8vw, 1.5rem);
    line-height: 1.65;
  }

  .trip-wanted-tags {
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    gap: 0.7rem;
  }

  .trip-wanted-tag {
    padding: 0.75rem 1rem;
    border: 1px solid rgba(244, 241, 234, 0.24);
    color: var(--color-papel);
    font-family: var(--font-sans, sans-serif);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* ============================================================
     PHOTO STORY — NATURALEZA
  ============================================================ */

  .trip-photo-story {
    background: #f3f0e9;
  }

  .trip-photo-story-inner {
    width: var(--trip-wide-width);
    margin: 0 auto;
    padding: clamp(7rem, 11vw, 11rem) 0;
  }

  .trip-photo-story-copy {
    display: grid;
    grid-template-columns: 90px minmax(0, 1fr) minmax(260px, 0.65fr);
    gap: 2rem;
    align-items: end;
    margin-bottom: clamp(4rem, 7vw, 7rem);
  }

  .trip-photo-story-copy h2 {
    margin: 0;
    color: var(--color-bosque);
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(2.8rem, 5vw, 5.8rem);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 0.94;
  }

  .trip-photo-story-copy > p:last-child {
    margin: 0;
    color: rgba(28, 54, 42, 0.68);
    font-family: var(--font-sans, sans-serif);
    font-size: 0.92rem;
    line-height: 1.75;
  }

  .trip-photo-story-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.65fr);
    grid-template-rows: repeat(2, minmax(260px, 340px));
    gap: 1rem;
  }

  .trip-story-photo {
    overflow: hidden;
  }

  .trip-story-photo-large {
    grid-row: 1 / span 2;
  }

  .trip-story-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 600ms cubic-bezier(0.2, 0.65, 0.25, 1);
  }

  .trip-story-photo:hover img {
    transform: scale(1.025);
  }

  /* ============================================================
     RUTA
  ============================================================ */

  .trip-route {
    background: var(--color-papel);
  }

  .trip-route-list {
    margin-left: calc(90px + 2rem);
    border-top: 1px solid rgba(28, 54, 42, 0.18);
  }

  .trip-route-item {
    display: grid;
    grid-template-columns: 70px minmax(0, 1fr);
    gap: 2rem;
    padding: 2.2rem 0;
    border-bottom: 1px solid rgba(28, 54, 42, 0.18);
  }

  .trip-route-index {
    color: var(--color-cobre);
    font-family: var(--font-sans, sans-serif);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .trip-route-content p {
    max-width: 760px;
    margin: 0;
    color: rgba(28, 54, 42, 0.68);
    font-family: var(--font-sans, sans-serif);
    font-size: 0.95rem;
    line-height: 1.75;
  }

  /* ============================================================
     DECISIONES
  ============================================================ */

  .trip-decisions {
    background: #f3f0e9;
  }

  .trip-decisions-inner {
    width: var(--trip-width);
    margin: 0 auto;
    padding: clamp(7rem, 11vw, 11rem) 0;
  }

  .trip-decisions .trip-section-header {
    display: block;
    margin-bottom: 4rem;
  }

  .trip-decisions-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: rgba(28, 54, 42, 0.18);
  }

  .trip-decision-card {
    min-height: 330px;
    padding: 2.5rem;
    background: #f3f0e9;
  }

  .trip-decision-number {
    display: block;
    margin-bottom: 5rem;
    color: var(--color-cobre);
    font-family: var(--font-sans, sans-serif);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .trip-decision-card h3 {
    margin: 0 0 1rem;
    color: var(--color-bosque);
    font-family: var(--font-serif, Georgia, serif);
    font-size: 2rem;
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .trip-decision-card p {
    margin: 0;
    color: rgba(28, 54, 42, 0.68);
    font-family: var(--font-sans, sans-serif);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  /* ============================================================
     FAUNA
  ============================================================ */

  .trip-fauna {
    background: var(--color-bosque);
  }

  .trip-fauna-inner {
    width: var(--trip-wide-width);
    margin: 0 auto;
    padding: clamp(7rem, 11vw, 11rem) 0;
  }

  .trip-fauna-header {
    display: grid;
    grid-template-columns: 90px minmax(0, 1fr) minmax(260px, 0.65fr);
    gap: 2rem;
    align-items: end;
    margin-bottom: clamp(4rem, 7vw, 7rem);
  }

  .trip-fauna-header h2 {
    margin: 0;
    color: var(--color-papel);
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(3rem, 5.5vw, 6.5rem);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 0.94;
  }

  .trip-fauna-header > p:last-child {
    margin: 0;
    color: rgba(244, 241, 234, 0.62);
    font-family: var(--font-sans, sans-serif);
    font-size: 0.92rem;
    line-height: 1.75;
  }

  .trip-fauna-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(2, 280px);
    gap: 1rem;
  }

  .trip-fauna-photo {
    overflow: hidden;
  }

  .trip-fauna-featured {
    grid-column: span 2;
    grid-row: span 2;
  }

  .trip-fauna-wide {
    grid-column: span 2;
  }

  .trip-fauna-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 600ms cubic-bezier(0.2, 0.65, 0.25, 1);
  }

  .trip-fauna-photo:hover img {
    transform: scale(1.025);
  }

  .trip-fauna-photo figcaption {
    color: rgba(244, 241, 234, 0.55);
  }

  /* ============================================================
     DATOS EXTRA
  ============================================================ */

  .trip-extra-metrics {
    background: var(--color-papel);
  }

  .trip-extra-metrics-inner {
    width: var(--trip-width);
    margin: 0 auto;
    padding: clamp(7rem, 11vw, 11rem) 0;
  }

  .trip-extra-heading {
    max-width: 800px;
    margin-bottom: 5rem;
  }

  .trip-extra-heading h2 {
    margin: 1rem 0 0;
    color: var(--color-bosque);
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(3rem, 5vw, 5.5rem);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 0.95;
  }

  .trip-extra-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid rgba(28, 54, 42, 0.18);
  }

  .trip-extra-item {
    padding: 2rem 1.5rem 0;
    border-left: 1px solid rgba(28, 54, 42, 0.18);
  }

  .trip-extra-item:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .trip-extra-value {
    display: block;
    color: var(--color-bosque);
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(2.4rem, 4vw, 4.5rem);
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .trip-extra-label {
    display: block;
    margin-top: 0.8rem;
    color: rgba(28, 54, 42, 0.54);
    font-family: var(--font-sans, sans-serif);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* ============================================================
     NO VISITADO
  ============================================================ */

  .trip-not-visited {
    background: #f3f0e9;
  }

  .trip-not-visited-inner {
    width: var(--trip-width);
    margin: 0 auto;
    padding: clamp(7rem, 11vw, 11rem) 0;
  }

  .trip-not-visited-heading {
    max-width: 720px;
    margin-bottom: 5rem;
  }

  .trip-not-visited-heading h2 {
    margin: 1rem 0 1.5rem;
    color: var(--color-bosque);
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(3rem, 5vw, 5.5rem);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 0.95;
  }

  .trip-not-visited-heading > p:last-child {
    max-width: 520px;
    margin: 0;
    color: rgba(28, 54, 42, 0.68);
    font-family: var(--font-sans, sans-serif);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .trip-not-visited-list {
    border-top: 1px solid rgba(28, 54, 42, 0.18);
  }

  .trip-not-visited-item {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 5rem;
    padding: 2rem 0;
    border-bottom: 1px solid rgba(28, 54, 42, 0.18);
  }

  .trip-not-visited-item h3 {
    margin: 0;
    color: var(--color-bosque);
    font-family: var(--font-serif, Georgia, serif);
    font-size: 1.8rem;
    font-weight: 400;
  }

  .trip-not-visited-reason p {
    margin: 0;
    color: rgba(28, 54, 42, 0.68);
    font-family: var(--font-sans, sans-serif);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .trip-not-visited-reason .trip-not-visited-lesson {
    margin-top: 1rem;
    color: var(--color-cobre);
    font-size: 0.8rem;
  }

  /* ============================================================
     ALOJAMIENTOS
  ============================================================ */

  .trip-accommodations {
    background: var(--color-papel);
  }

  .trip-accommodations-inner {
    width: var(--trip-width);
    margin: 0 auto;
    padding: clamp(7rem, 11vw, 11rem) 0;
  }

  .trip-accommodations .trip-section-header {
    display: block;
  }

  .trip-accommodations-list {
    border-top: 1px solid rgba(28, 54, 42, 0.18);
  }

  .trip-accommodation-item {
    display: grid;
    grid-template-columns: 0.7fr 1.4fr 0.4fr;
    gap: 2rem;
    align-items: center;
    padding: 1.5rem 0;
    border-bottom: 1px solid rgba(28, 54, 42, 0.18);
  }

  .trip-accommodation-location {
    color: rgba(28, 54, 42, 0.5);
    font-family: var(--font-sans, sans-serif);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .trip-accommodation-name {
    color: var(--color-bosque);
    font-family: var(--font-serif, Georgia, serif);
    font-size: 1.45rem;
  }

  .trip-accommodation-price {
    color: var(--color-bosque);
    font-family: var(--font-sans, sans-serif);
    font-size: 0.85rem;
    font-weight: 700;
    text-align: right;
  }

  .trip-accommodation-price span {
    margin-left: 0.2rem;
    color: rgba(28, 54, 42, 0.45);
    font-size: 0.7rem;
  }

  /* ============================================================
     PRESUPUESTO
  ============================================================ */

  .trip-budget {
    background: #f3f0e9;
  }

  .trip-budget-inner {
    width: var(--trip-width);
    margin: 0 auto;
    padding: clamp(7rem, 11vw, 11rem) 0;
  }

  .trip-budget .trip-section-header {
    display: block;
  }

  .trip-budget-list {
    border-top: 1px solid rgba(28, 54, 42, 0.18);
  }

  .trip-budget-item {
    display: grid;
    grid-template-columns: 0.6fr 1.5fr 0.4fr;
    gap: 2rem;
    align-items: center;
    padding: 1.5rem 0;
    border-bottom: 1px solid rgba(28, 54, 42, 0.18);
  }

  .trip-budget-category {
    color: var(--color-cobre);
    font-family: var(--font-sans, sans-serif);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .trip-budget-description {
    color: rgba(28, 54, 42, 0.68);
    font-family: var(--font-sans, sans-serif);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .trip-budget-amount {
    color: var(--color-bosque);
    font-family: var(--font-sans, sans-serif);
    font-size: 0.85rem;
    font-weight: 700;
    text-align: right;
  }

  .trip-budget-amount span {
    margin-left: 0.2rem;
    color: rgba(28, 54, 42, 0.45);
    font-size: 0.7rem;
  }

  /* ============================================================
     FOTO FINAL
  ============================================================ */

  .trip-final-photo {
    background: #f3f0e9;
  }

  .trip-final-photo-inner {
    width: var(--trip-wide-width);
    margin: 0 auto;
    padding: 0 0 clamp(7rem, 11vw, 11rem);
  }

  .trip-final-photo figure {
    position: relative;
  }

  .trip-final-photo img {
    width: 100%;
    height: min(72vh, 780px);
    object-fit: cover;
  }

  /* ============================================================
     GUÍA
  ============================================================ */

  .trip-guide {
    background: var(--color-bosque);
  }

  .trip-guide-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.55fr);
    gap: clamp(4rem, 10vw, 10rem);
    align-items: end;
    width: var(--trip-width);
    margin: 0 auto;
    padding: clamp(7rem, 11vw, 11rem) 0;
  }

  .trip-guide-copy h2 {
    max-width: 780px;
    margin: 1rem 0 1.5rem;
    color: var(--color-papel);
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(3rem, 5.3vw, 6rem);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 0.94;
  }

  .trip-guide-copy > p:last-child {
    max-width: 600px;
    margin: 0;
    color: rgba(244, 241, 234, 0.64);
    font-family: var(--font-sans, sans-serif);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .trip-guide-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.3rem 0;
    border-top: 1px solid rgba(244, 241, 234, 0.28);
