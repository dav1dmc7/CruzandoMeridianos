  /* ============================================================
     CM PHOTO CAPTIONS v2
  ============================================================ */

  .trip-page figure {
    position: relative;
  }

  .trip-page figure figcaption {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 3;
    margin: 0;
    padding: 4.5rem 1.25rem 1rem;
    background: linear-gradient(
      to top,
      rgba(10, 22, 16, .72),
      rgba(10, 22, 16, 0)
    );
    color: rgba(255,255,255,.94);
    font-family: var(--font-sans, sans-serif);
    font-size: .68rem;
    font-weight: 500;
    letter-spacing: .02em;
    line-height: 1.45;
    text-shadow: 0 1px 10px rgba(0,0,0,.18);
    pointer-events: none;
  }

  .trip-story-photo figcaption,
  .trip-fauna-photo figcaption {
    padding-right: 1rem;
    padding-left: 1rem;
  }

  .trip-budget-summary {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(240px, .7fr);
    gap: 1rem;
    margin: 3rem 0 1.5rem;
  }

  .trip-budget-summary > div {
    padding: 1.5rem 1.6rem;
    border: 1px solid rgba(28, 54, 42, .12);
    background: rgba(251, 249, 245, .72);
  }

  .trip-budget-summary span {
