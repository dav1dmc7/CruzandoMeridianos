
const formatBudgetCategory = (category: string) => {
  const labels: Record<string, string> = {
    flights: "Vuelos",
    car: "Coche de alquiler",
    fuel: "Combustible",
    accommodation: "Alojamiento",
    activities: "Actividades",
    transport: "Transporte",
    food: "Alimentación",
    other: "Otros",
    cash: "Efectivo retirado",
  };

  return labels[category] ?? category;
};


const plannedPlaces = trip.plannedButNotVisited;
const visibleTripPlaces = trip.places.slice(0, 24);
const additionalTripPlaces = trip.places.slice(24);
const placesMetricValue =
  trip.places.length > 0 ? trip.places.length : metrics.placesRecorded;
const placesMetricLabel =
  trip.places.length > 0 ? "puntos transcritos" : "lugares registrados";

const identifiedBudgetTotal =
  trip.budgetSummary?.total ??
  trip.budget
    .filter((item) => item.category !== "cash")
    .reduce((total, item) => total + item.amount, 0);


const budgetByCategory = (category: string) =>
  trip.budget
    .filter((item) => item.category === category)
    .reduce((total, item) => total + item.amount, 0);

const supermarketItems = trip.budget.filter((item) => {
  if (item.category !== "food") return false;
  const description = item.description.toLowerCase();
  return description.includes("super") || description.includes("súper");
});

const restaurantItems = trip.budget.filter((item) => {
  if (item.category !== "food") return false;
  return !supermarketItems.includes(item);
});

const supermarketTotal = supermarketItems.reduce(
  (total, item) => total + item.amount,
  0
);

const restaurantTotal = restaurantItems.reduce(
  (total, item) => total + item.amount,
  0
);

const budgetGroupDefinitions = [
  ["flights", "Vuelos", "Vuelos y trayectos aéreos"],
  ["car", "Coche de alquiler", "Alquileres de coche registrados"],
  ["fuel", "Combustible", "Gasolina registrada"],
  ["accommodation", "Alojamientos", "Alojamientos con importe registrado"],
  ["activities", "Actividades", "Experiencias y entradas"],
  ["transport", "Transporte", "Otros desplazamientos"],
  ["food", "Alimentación", "Compras y comidas"],
  ["other", "Otros", "Otros gastos registrados"],
  ["cash", "Efectivo", "Retiradas de efectivo"],
];

const budgetGroups = budgetGroupDefinitions
  .map(([category, label, details]) => ({
    label,
    total: budgetByCategory(category),
    details,
  }))
  .filter((group) => group.total > 0);

