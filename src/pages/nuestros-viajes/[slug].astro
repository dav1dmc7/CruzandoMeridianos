    font-size: 0.9rem;
    line-height: 1.7;
  }

  .trip-not-visited-reason .trip-not-visited-lesson {
    margin-top: 1rem;
    color: var(--color-cobre);
    font-size: 0.8rem;
  }

  /* ============================================================
     ALOJAMIENTOS
  ============================================================ */

  .trip-accommodations {
    background: var(--color-papel);
  }

  .trip-accommodations-inner {
    width: var(--trip-width);
    margin: 0 auto;
    padding: clamp(7rem, 11vw, 11rem) 0;
  }

  .trip-accommodations .trip-section-header {
    display: block;
  }

  .trip-accommodations-list {
    border-top: 1px solid rgba(28, 54, 42, 0.18);
  }

  .trip-accommodation-item {
    display: grid;
    grid-template-columns: 0.7fr 1.4fr 0.4fr;
    gap: 2rem;
    align-items: center;
    padding: 1.5rem 0;
    border-bottom: 1px solid rgba(28, 54, 42, 0.18);
  }

  .trip-accommodation-location {
    color: rgba(28, 54, 42, 0.5);
    font-family: var(--font-sans, sans-serif);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .trip-accommodation-name {
    color: var(--color-bosque);
    font-family: var(--font-serif, Georgia, serif);
    font-size: 1.45rem;
  }

  .trip-accommodation-price {
    color: var(--color-bosque);
    font-family: var(--font-sans, sans-serif);
    font-size: 0.85rem;
    font-weight: 700;
    text-align: right;
  }

  .trip-accommodation-price span {
    margin-left: 0.2rem;
    color: rgba(28, 54, 42, 0.45);
    font-size: 0.7rem;
  }

  /* ============================================================
     PRESUPUESTO
  ============================================================ */

  .trip-budget {
    background: #f3f0e9;
  }

  .trip-budget-inner {
    width: var(--trip-width);
    margin: 0 auto;
    padding: clamp(7rem, 11vw, 11rem) 0;
  }

  .trip-budget .trip-section-header {
    display: block;
  }

  .trip-budget-list {
    border-top: 1px solid rgba(28, 54, 42, 0.18);
  }

  .trip-budget-item {
    display: grid;
    grid-template-columns: 0.6fr 1.5fr 0.4fr;
    gap: 2rem;
    align-items: center;
    padding: 1.5rem 0;
    border-bottom: 1px solid rgba(28, 54, 42, 0.18);
  }

  .trip-budget-category {
    color: var(--color-cobre);
    font-family: var(--font-sans, sans-serif);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .trip-budget-description {
    color: rgba(28, 54, 42, 0.68);
    font-family: var(--font-sans, sans-serif);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .trip-budget-amount {
    color: var(--color-bosque);
    font-family: var(--font-sans, sans-serif);
    font-size: 0.85rem;
    font-weight: 700;
    text-align: right;
  }

  .trip-budget-amount span {
    margin-left: 0.2rem;
    color: rgba(28, 54, 42, 0.45);
    font-size: 0.7rem;
  }

  /* ============================================================
     FOTO FINAL
  ============================================================ */

  .trip-final-photo {
    background: #f3f0e9;
  }

  .trip-final-photo-inner {
    width: var(--trip-wide-width);
    margin: 0 auto;
    padding: 0 0 clamp(7rem, 11vw, 11rem);
  }

  .trip-final-photo figure {
    position: relative;
  }

  .trip-final-photo img {
    width: 100%;
    height: min(72vh, 780px);
    object-fit: cover;
  }

  /* ============================================================
     GUÍA
  ============================================================ */

  .trip-guide {
    background: var(--color-bosque);
  }

  .trip-guide-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.55fr);
    gap: clamp(4rem, 10vw, 10rem);
    align-items: end;
    width: var(--trip-width);
    margin: 0 auto;
    padding: clamp(7rem, 11vw, 11rem) 0;
  }

  .trip-guide-copy h2 {
    max-width: 780px;
    margin: 1rem 0 1.5rem;
    color: var(--color-papel);
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(3rem, 5.3vw, 6rem);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 0.94;
  }

  .trip-guide-copy > p:last-child {
    max-width: 600px;
    margin: 0;
    color: rgba(244, 241, 234, 0.64);
    font-family: var(--font-sans, sans-serif);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .trip-guide-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.3rem 0;
    border-top: 1px solid rgba(244, 241, 234, 0.28);
    border-bottom: 1px solid rgba(244, 241, 234, 0.28);
    color: var(--color-papel);
    font-family: var(--font-sans, sans-serif);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      color 180ms ease,
      padding 180ms ease;
  }

  .trip-guide-link:hover {
    padding-left: 0.5rem;
    color: #d6a06c;
  }

  .trip-guide-arrow {
    font-size: 1.25rem;
  }

  /* ============================================================
     CTA
  ============================================================ */

  .trip-cta {
    background: #f3f0e9;
  }

  .trip-cta-inner {
    width: var(--trip-width);
    margin: 0 auto;
    padding: clamp(8rem, 14vw, 14rem) 0;
    text-align: center;
  }

  .trip-cta-inner h2 {
    max-width: 900px;
    margin: 1rem auto 1.5rem;
    color: var(--color-bosque);
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(3.4rem, 6vw, 7rem);
    font-weight: 400;
    letter-spacing: -0.055em;
    line-height: 0.9;
  }

  .trip-cta-inner > p:not(.trip-eyebrow) {
    max-width: 560px;
    margin: 0 auto 2.5rem;
    color: rgba(28, 54, 42, 0.68);
    font-family: var(--font-sans, sans-serif);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .trip-cta-button {
    display: inline-flex;
    align-items: center;
    gap: 1.2rem;
    padding: 1rem 1.4rem;
    background: var(--color-bosque);
    color: var(--color-papel);
    font-family: var(--font-sans, sans-serif);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      background 180ms ease,
      transform 180ms ease;
  }

  .trip-cta-button:hover {
    background: var(--color-cobre);
    transform: translateY(-2px);
  }

  .trip-cta-button span {
    font-size: 1.1rem;
  }

  /* ============================================================
     TABLET
  ============================================================ */

  @media (max-width: 900px) {
    .trip-page {
      --trip-width: min(100% - 3rem, 720px);
      --trip-wide-width: min(100% - 3rem, 900px);
    }

    .trip-hero-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .trip-hero-content {
      padding-bottom: 0;
    }

    .trip-hero-figure {
      width: min(100%, 560px);
      margin-left: auto;
    }

    .trip-metrics-inner {
      grid-template-columns: repeat(3, 1fr);
      row-gap: 2.5rem;
    }

    .trip-metric:nth-child(4) {
      padding-left: 0;
      border-left: 0;
    }

    .trip-section-body,
    .trip-wanted-layout {
      grid-template-columns: 1fr;
      gap: 3rem;
      padding-left: 0;
    }

    .trip-section-header {
      grid-template-columns: 60px 1fr;
    }

    .trip-route-list {
      margin-left: 0;
    }

    .trip-photo-story-copy,
    .trip-fauna-header {
      grid-template-columns: 60px 1fr;
    }

    .trip-photo-story-copy > p:last-child,
    .trip-fauna-header > p:last-child {
      grid-column: 2;
      max-width: 520px;
    }

    .trip-photo-story-grid {
      grid-template-columns: 1.2fr 0.8fr;
    }

    .trip-decisions-grid {
      grid-template-columns: 1fr;
    }

    .trip-decision-card {
      min-height: 260px;
    }

    .trip-decision-number {
      margin-bottom: 3rem;
    }

    .trip-fauna-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: repeat(3, 300px);
    }

    .trip-fauna-featured {
      grid-column: span 2;
      grid-row: span 1;
    }

    .trip-fauna-wide {
      grid-column: span 2;
    }

    .trip-extra-grid {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 2rem;
    }

    .trip-extra-item:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }

    .trip-not-visited-item {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .trip-guide-inner {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .trip-accommodation-item,
    .trip-budget-item {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .trip-accommodation-price,
    .trip-budget-amount {
      text-align: left;
    }
  }

  /* ============================================================
     MOBILE
  ============================================================ */

  @media (max-width: 700px) {
    .trip-page {
      --trip-width: calc(100% - 2rem);
      --trip-wide-width: calc(100% - 2rem);
    }

    .trip-hero-inner {
      padding-top: 1.25rem;
      padding-bottom: 4rem;
    }

    .trip-hero-grid {
      padding-top: 4rem;
    }

    .trip-hero-content h1 {
      font-size: clamp(3.7rem, 17vw, 6rem);
    }

    .trip-hero-subtitle {
      font-size: 1.1rem;
    }

    .trip-hero-meta {
      flex-wrap: wrap;
      font-size: 0.64rem;
    }

    .trip-hero-figure {
      width: 100%;
      aspect-ratio: 0.9;
    }

    .trip-introduction-inner,
    .trip-section-inner,
    .trip-wanted-inner,
    .trip-photo-story-inner,
    .trip-decisions-inner,
    .trip-fauna-inner,
    .trip-extra-metrics-inner,
    .trip-not-visited-inner,
    .trip-accommodations-inner,
    .trip-budget-inner,
    .trip-guide-inner,
    .trip-cta-inner {
      padding-top: 5.5rem;
      padding-bottom: 5.5rem;
    }

    .trip-introduction-content {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .trip-introduction-content h2 {
      font-size: clamp(2.8rem, 13vw, 4.8rem);
    }

    .trip-photo-break-figure img {
      height: 62vh;
      min-height: 420px;
    }

    .trip-metrics-inner {
      grid-template-columns: repeat(2, 1fr);
      width: calc(100% - 2rem);
      padding: 3rem 0;
      row-gap: 2.5rem;
    }

    .trip-metric {
      min-height: auto;
      padding: 0 1rem;
    }

    .trip-metric:nth-child(odd) {
      padding-left: 0;
      border-left: 0;
    }

    .trip-metric-value {
      font-size: 2rem;
    }

    .trip-metric-date .trip-metric-value {
      font-size: 0.95rem;
    }

    .trip-section-header {
      grid-template-columns: 40px 1fr;
      gap: 1rem;
      margin-bottom: 3.5rem;
    }

    .trip-section-header h2 {
      margin-top: 0.75rem;
      font-size: clamp(2.8rem, 13vw, 4.8rem);
    }

    .trip-section-body {
      gap: 2.5rem;
    }

    .trip-section-lead {
      font-size: 1.2rem;
    }

    .trip-wanted-layout {
      gap: 2.5rem;
    }

    .trip-photo-story-copy,
    .trip-fauna-header {
      display: block;
    }

    .trip-photo-story-copy .trip-eyebrow,
    .trip-fauna-header .trip-eyebrow {
      margin-bottom: 1rem;
    }

    .trip-photo-story-copy h2,
    .trip-fauna-header h2 {
      font-size: clamp(2.8rem, 13vw, 4.8rem);
    }

    .trip-photo-story-copy > p:last-child,
    .trip-fauna-header > p:last-child {
      margin-top: 2rem;
    }

    .trip-photo-story-grid {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .trip-story-photo,
    .trip-story-photo-large {
      height: 360px;
    }

    .trip-story-photo-large {
      height: 500px;
    }

    .trip-route-item {
      grid-template-columns: 40px 1fr;
      gap: 1rem;
      padding: 1.7rem 0;
    }

    .trip-route-content p {
      font-size: 0.9rem;
    }

    .trip-decisions-grid {
      gap: 1px;
    }

    .trip-decision-card {
      min-height: 0;
      padding: 2rem;
    }

    .trip-fauna-grid {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .trip-fauna-photo,
    .trip-fauna-featured,
    .trip-fauna-wide {
      height: 340px;
    }

    .trip-fauna-featured {
      height: 500px;
    }

    .trip-extra-heading h2,
    .trip-not-visited-heading h2 {
      font-size: clamp(2.8rem, 13vw, 4.8rem);
    }

    .trip-extra-grid {
      grid-template-columns: 1fr 1fr;
    }

    .trip-extra-item {
      padding: 1.5rem 1rem 0;
    }

    .trip-extra-value {
      font-size: 2.5rem;
    }

    .trip-accommodation-item,
    .trip-budget-item {
      grid-template-columns: 1fr;
      gap: 0.6rem;
      padding: 1.5rem 0;
    }

    .trip-accommodation-price,
    .trip-budget-amount {
      text-align: left;
    }

    .trip-final-photo-inner {
      padding-bottom: 5.5rem;
    }

    .trip-final-photo img {
      height: 62vh;
      min-height: 420px;
    }

    .trip-guide-copy h2,
    .trip-cta-inner h2 {
      font-size: clamp(3rem, 14vw, 5rem);
    }
  }

  /* ============================================================
     SMALL MOBILE
  ============================================================ */

  @media (max-width: 400px) {
    .trip-hero-content h1 {
      font-size: 3.5rem;
    }

    .trip-metrics-inner,
    .trip-extra-grid {
      grid-template-columns: 1fr;
    }

    .trip-metric,
    .trip-extra-item {
      padding-left: 0;
      border-left: 0;
    }

    .trip-metric {
      padding-bottom: 1.5rem;
      border-bottom: 1px solid rgba(244, 241, 234, 0.15);
    }

    .trip-extra-item {
      padding-bottom: 1.5rem;
      border-bottom: 1px solid rgba(28, 54, 42, 0.15);
    }

    .trip-section-header {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }

    .trip-section-number {
      margin-bottom: 0.5rem;
    }

    .trip-route-item {
      grid-template-columns: 1fr;
    }

    .trip-route-index {
      margin-bottom: 0.2rem;
    }
  }

  /* ============================================================
     REDUCED MOTION
  ============================================================ */

  @media (prefers-reduced-motion: reduce) {
    .trip-page *,
    .trip-page *::before,
    .trip-page *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }
  }

    /* CM FINAL PHOTO + FAUNA OVERRIDE */
    html body .trip-page .trip-photo-break {
      padding: clamp(4rem, 7vw, 7rem) 0 clamp(2rem, 4vw, 3.5rem) !important;
      background: var(--color-papel) !important;
    }

    html body .trip-page .trip-photo-break-figure {
      width: min(820px, calc(100% - 10rem)) !important;
      margin-inline: auto !important;
    }

