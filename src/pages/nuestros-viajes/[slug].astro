---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/layout/Footer.astro";
import { getOurTripBySlug } from "../../data/our-trips";

import selvaCostaRica from "../../assets/images/costa-rica/selva-costa-rica.jpg";
import playaCostaRica from "../../assets/images/costa-rica/playa-costa-rica.jpg";
import rioPlaya from "../../assets/images/costa-rica/rio-playa.jpg";
import bosqueCascada from "../../assets/images/costa-rica/bosque-cascada.jpg";
import cascada from "../../assets/images/costa-rica/cascada.jpg";
import arbol from "../../assets/images/costa-rica/arbol.jpg";
import cocodrilo from "../../assets/images/costa-rica/cocodrilo.jpg";
import rana from "../../assets/images/costa-rica/rana.jpg";
import mono from "../../assets/images/costa-rica/mono.jpg";
import perezoso from "../../assets/images/costa-rica/perezoso.jpg";

const { slug } = Astro.params;

const trip = slug ? getOurTripBySlug(slug) : undefined;

if (!trip) {
  return Astro.redirect("/nuestros-viajes");
}

const title = `${trip.title} | Cruzando Meridianos`;
const description = trip.subtitle;

const metrics = trip.metrics;

const formatNumber = (value?: number) =>
  value?.toLocaleString("es-ES") ?? "—";

const formatDate = (date: string) =>
  new Date(`${date}T12:00:00`).toLocaleDateString("es-ES", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });

const formatBudgetCategory = (category: string) => {
  const labels: Record<string, string> = {
    flights: "Vuelos",
    car: "Coche de alquiler",
    fuel: "Combustible",
    accommodation: "Alojamiento",
    activities: "Actividades",
    transport: "Transporte",
    food: "Alimentación",
    other: "Otros",
    cash: "Efectivo retirado",
  };

  return labels[category] ?? category;
};


const plannedPlaces = trip.plannedButNotVisited;

const identifiedBudgetTotal = trip.slug === "costa-rica"
  ? trip.budget
      .filter((item) => item.category !== "cash")
      .reduce((total, item) => total + item.amount, 0)
  : 0;


const budgetByCategory = (category: string) =>
  trip.budget
    .filter((item) => item.category === category)
    .reduce((total, item) => total + item.amount, 0);

const supermarketItems = trip.budget.filter((item) => {
  if (item.category !== "food") return false;
  const description = item.description.toLowerCase();
  return description.includes("super") || description.includes("súper");
});

const restaurantItems = trip.budget.filter((item) => {
  if (item.category !== "food") return false;
  return !supermarketItems.includes(item);
});

const supermarketTotal = supermarketItems.reduce(
  (total, item) => total + item.amount,
  0
);

const restaurantTotal = restaurantItems.reduce(
  (total, item) => total + item.amount,
  0
);

const budgetGroups =
  trip.slug === "costa-rica"
    ? [
        {
          label: "Vuelos",
          total: budgetByCategory("flights"),
          details: "Vuelos internacionales",
        },
        {
          label: "Coche de alquiler",
          total: budgetByCategory("car"),
          details: "Alquiler del coche",
        },
        {
          label: "Combustible",
          total: budgetByCategory("fuel"),
          details: "Gasolina de todo el viaje",
        },
        {
          label: "Alojamientos",
          total: budgetByCategory("accommodation"),
          details: "Todos los alojamientos registrados",
        },
        {
          label: "Actividades",
          total: budgetByCategory("activities"),
          details: "Parques, reservas y excursiones",
        },
        {
          label: "Transporte",
          total: budgetByCategory("transport"),
          details: "Uber y otros desplazamientos",
        },
        {
          label: "Alimentación",
          total: budgetByCategory("food"),
          details: `${formatNumber(supermarketTotal)} € en supermercados · ${formatNumber(restaurantTotal)} € fuera de casa`,
        },
        {
          label: "Otros",
          total: budgetByCategory("other"),
          details: "eSIM y gimnasio",
        },
      ]
    : [];
---

<Layout title={title} description={description}>
  <main class="trip-page">
    <!-- =========================================================
         HERO
    ========================================================== -->
    <section class="trip-hero" aria-labelledby="trip-title">
      <div class="trip-hero-inner">
        <div class="trip-hero-top">
          <a class="trip-back" href="/nuestros-viajes">
            <span aria-hidden="true">←</span>
            Volver a nuestros viajes
          </a>

          <span class="trip-hero-number" aria-hidden="true">01</span>
        </div>

        <div class="trip-hero-grid">
          <div class="trip-hero-content">
            <p class="trip-eyebrow">
              Nuestro viaje · {trip.destination}
            </p>

            <h1 id="trip-title">
              Nuestro viaje a {trip.destination}.
            </h1>

            <p class="trip-hero-subtitle">
              {trip.subtitle}
            </p>

            <div class="trip-hero-meta" aria-label="Fechas del viaje">
              <span>{formatDate(metrics.startDate)}</span>
              <span aria-hidden="true">·</span>
              <span>{formatDate(metrics.endDate)}</span>
            </div>
          </div>

          <figure class="trip-hero-figure">
            <Image
              src={selvaCostaRica}
              alt="Sendero entre la vegetación tropical de Costa Rica"
              loading="eager"
              sizes="(max-width: 900px) 100vw, 48vw"
            />
          </figure>
        </div>
      </div>
    </section>

    <!-- =========================================================
         INTRODUCCIÓN
    ========================================================== -->
    <section class="trip-introduction">
      <div class="trip-introduction-inner">
        <div class="trip-section-label">
          <span>El viaje real</span>
        </div>

        <div class="trip-introduction-content">
          <h2>
            No queremos reconstruir<br />
            un viaje perfecto.
          </h2>

          <div class="trip-introduction-copy">
            <p>
              {trip.introduction}
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- =========================================================
         PAISAJE — FOTO INTEGRADA EN EL RELATO
    ========================================================== -->
    <section class="trip-editorial-intro-photo">
      <div class="trip-editorial-intro-copy">
        <p class="trip-eyebrow">El paisaje</p>
        <h2>Selva, carretera y mar. Todo forma parte del recorrido.</h2>
        <p>
          En Costa Rica, el paisaje cambia constantemente. A veces
          el destino es una reserva o una playa. Otras veces es
          simplemente la carretera que une una cosa con la siguiente.
        </p>
      </div>

      <figure class="trip-editorial-intro-figure">
        <Image
          src={rioPlaya}
          alt="Río desembocando en una playa de Costa Rica"
          loading="lazy"
          sizes="(max-width: 900px) 100vw, 58vw"
        />
      </figure>
    </section>

    <!-- =========================================================
         MÉTRICAS
    ========================================================== -->
    <section
      class="trip-metrics"
      aria-label="Datos principales del viaje"
    >
      <div class="trip-metrics-inner">
        <div class="trip-metric">
          <span class="trip-metric-value">
            {formatNumber(metrics.durationDays)}
          </span>

          <span class="trip-metric-label">
            días
          </span>
        </div>

        <div class="trip-metric">
          <span class="trip-metric-value">
            {formatNumber(metrics.carKm)}
          </span>

          <span class="trip-metric-label">
            km en coche
          </span>
        </div>

        <div class="trip-metric">
          <span class="trip-metric-value">
            {formatNumber(metrics.photos)}
          </span>

          <span class="trip-metric-label">
            fotografías
          </span>
        </div>

        <div class="trip-metric">
          <span class="trip-metric-value">
            {formatNumber(metrics.placesRecorded)}
          </span>

          <span class="trip-metric-label">
            lugares registrados
          </span>
        </div>

        <div class="trip-metric trip-metric-date">
          <span class="trip-metric-value">
            {formatDate(metrics.startDate)}
          </span>

          <span class="trip-metric-label">
            comienzo
          </span>
        </div>

        <div class="trip-metric trip-metric-date">
          <span class="trip-metric-value">
            {formatDate(metrics.endDate)}
          </span>

          <span class="trip-metric-label">
            final
          </span>
        </div>
      </div>
    </section>

    <!-- =========================================================
         POR QUÉ COSTA RICA
    ========================================================== -->
    <section class="trip-section trip-section-paper">
      <div class="trip-section-inner">
        <div class="trip-section-header">
          <span class="trip-section-number">02</span>

          <div>
            <p class="trip-eyebrow">
              Antes de salir
            </p>

            <h2>
              ¿Por qué {trip.destination}?
            </h2>
          </div>
        </div>

        <div class="trip-section-body">
          <div class="trip-section-lead">
            <p>
              Elegimos Costa Rica buscando una combinación de
              naturaleza, carretera, fauna y variedad de paisajes.
            </p>
          </div>

          <div class="trip-bullet-list">
            {
              trip.whyDestination.map((point) => (
                <div class="trip-bullet-item">
                  <span
                    class="trip-bullet-mark"
                    aria-hidden="true"
                  >
                    +
                  </span>

                  <p>{point}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- =========================================================
         QUÉ BUSCÁBAMOS
    ========================================================== -->
    <section class="trip-wanted">
      <div class="trip-wanted-inner">
        <div class="trip-section-header trip-section-header-light">
          <span class="trip-section-number">03</span>

          <div>
            <p class="trip-eyebrow">
              La idea inicial
            </p>

            <h2>
              Queríamos un viaje variado.
            </h2>
          </div>
        </div>

        <div class="trip-wanted-layout">
          <div class="trip-wanted-intro">
            <p>
              No buscábamos pasar todos los días en el mismo sitio.
              Queríamos combinar paisajes, naturaleza, carretera,
              animales, pueblos y momentos en los que simplemente
              dejarse llevar.
            </p>
          </div>

          <div class="trip-wanted-tags">
            {
              trip.whatWeWanted.map((item) => (
                <span class="trip-wanted-tag">
                  {item}
                </span>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- =========================================================
         NATURALEZA — RELATO VISUAL
    ========================================================== -->
    <section class="trip-editorial-story">
      <div class="trip-editorial-story-heading">
        <p class="trip-eyebrow">El paisaje</p>
        <h2>La naturaleza no era el escenario. Era parte del viaje.</h2>
        <p>
          En Costa Rica, muchas decisiones de la ruta acababan teniendo
          que ver con lo que había alrededor: un bosque, una cascada,
          un río o simplemente una carretera que merecía la pena recorrer
          despacio.
        </p>
      </div>

      <article class="trip-editorial-row">
        <figure>
          <Image
            src={bosqueCascada}
            alt="Cascada entre el bosque tropical"
            loading="lazy"
            sizes="(max-width: 900px) 100vw, 52vw"
          />
        </figure>

        <div>
          <span class="trip-editorial-index">01</span>
          <h3>Cuando el paisaje decide por ti</h3>
          <p>
            Había momentos en los que el plan dejaba de importar.
            Una cascada, un cambio de vegetación o una parada inesperada
            acababan marcando el ritmo del día.
          </p>
        </div>
      </article>

      <article class="trip-editorial-row trip-editorial-row-reverse">
        <figure>
          <Image
            src={cascada}
            alt="Cascada en un entorno de bosque"
            loading="lazy"
            sizes="(max-width: 900px) 100vw, 48vw"
          />
        </figure>

        <div>
          <span class="trip-editorial-index">02</span>
          <h3>Parar también era parte del viaje</h3>
          <p>
            No todo tenía que estar optimizado. Algunas de las mejores
            decisiones fueron sencillamente detener el coche y mirar
            lo que teníamos delante.
          </p>
        </div>
      </article>

      <article class="trip-editorial-row">
        <figure>
          <Image
            src={arbol}
            alt="Árbol entre la vegetación del bosque"
            loading="lazy"
            sizes="(max-width: 900px) 100vw, 48vw"
          />
        </figure>

        <div>
          <span class="trip-editorial-index">03</span>
          <h3>El bosque estaba presente todo el tiempo</h3>
          <p>
            Incluso cuando no había una actividad concreta que hacer,
            el entorno ya era suficiente motivo para seguir recorriendo
            la ruta.
          </p>
        </div>
      </article>
    </section>

    <!-- =========================================================
         CÓMO DISEÑAMOS LA RUTA
    ========================================================== -->
    <section class="trip-section trip-route">
      <div class="trip-section-inner">
        <div class="trip-section-header">
          <span class="trip-section-number">04</span>

          <div>
            <p class="trip-eyebrow">
              La ruta
            </p>

            <h2>
              Cómo diseñamos el recorrido.
            </h2>
          </div>
        </div>

        <div class="trip-route-list">
          {
            trip.howWeDesignedTheRoute.map((item, index) => (
              <article class="trip-route-item">
                <span class="trip-route-index">
                  {String(index + 1).padStart(2, "0")}
                </span>

                <div class="trip-route-content">
                  <p>{item}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- =========================================================
         DECISIONES IMPORTANTES
    ========================================================== -->
    <section class="trip-decisions">
      <div class="trip-decisions-inner">
        <div class="trip-section-header">
          <div>
            <p class="trip-eyebrow">
              Sobre el terreno
            </p>

            <h2>
              Algunas decisiones importantes.
            </h2>
          </div>
        </div>

        <div class="trip-decisions-grid">
          {
            trip.importantDecisions.map((decision, index) => (
              <article class="trip-decision-card">
                <span class="trip-decision-number">
                  {String(index + 1).padStart(2, "0")}
                </span>

                <h3>{decision.title}</h3>

                <p>{decision.content}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- =========================================================
         FAUNA — ENCUENTROS
    ========================================================== -->
    <section class="trip-editorial-wildlife">
      <div class="trip-editorial-wildlife-heading">
        <p class="trip-eyebrow">Encuentros inesperados</p>
        <h2>Y luego están los animales.</h2>
        <p>
          Parte de lo especial de viajar por Costa Rica es que la
          naturaleza aparece cuando menos te lo esperas.
        </p>
      </div>

      <article class="trip-wildlife-row">
        <figure>
          <Image
            src={mono}
            alt="Mono entre la vegetación tropical"
            loading="lazy"
            sizes="(max-width: 900px) 100vw, 45vw"
          />
        </figure>
        <div>
          <span class="trip-editorial-index">01</span>
          <h3>Los animales no estaban en el guion.</h3>
          <p>
            Eran parte de esos momentos en los que el viaje se sale
            de la ruta prevista y aparece algo que no habías ido a buscar.
          </p>
        </div>
      </article>

      <article class="trip-wildlife-row trip-wildlife-row-reverse">
        <figure>
          <Image
            src={perezoso}
            alt="Perezoso entre la vegetación tropical"
            loading="lazy"
            sizes="(max-width: 900px) 100vw, 42vw"
          />
        </figure>
        <div>
          <span class="trip-editorial-index">02</span>
          <h3>La paciencia también forma parte de viajar.</h3>
          <p>
            Algunos encuentros duran unos segundos. Otros obligan
            a quedarse un poco más y observar.
          </p>
        </div>
      </article>

      <article class="trip-wildlife-row">
        <figure>
          <Image
            src={cocodrilo}
            alt="Cocodrilo junto al agua en Costa Rica"
            loading="lazy"
            sizes="(max-width: 900px) 100vw, 48vw"
          />
        </figure>
        <div>
          <span class="trip-editorial-index">03</span>
          <h3>Y algunas escenas imponían respeto.</h3>
          <p>
            La fauna no siempre tiene apariencia amable. También forma
            parte de la experiencia encontrarte con especies que
            recuerdan lo salvaje que sigue siendo el entorno.
          </p>
        </div>
      </article>

      <article class="trip-wildlife-row trip-wildlife-row-reverse">
        <figure>
          <Image
            src={rana}
            alt="Rana entre la vegetación tropical"
            loading="lazy"
            sizes="(max-width: 900px) 100vw, 42vw"
          />
        </figure>
        <div>
          <span class="trip-editorial-index">04</span>
          <h3>Lo pequeño también merece una parada.</h3>
          <p>
            La memoria del viaje no se queda solo con los grandes
            paisajes. A veces se queda con una escena diminuta que
            apareció en el sitio menos esperado.
          </p>
        </div>
      </article>
    </section>

    <!-- =========================================================
         DATOS ADICIONALES
    ========================================================== -->
    <section class="trip-extra-metrics">
      <div class="trip-extra-metrics-inner">
        <div class="trip-extra-heading">
          <p class="trip-eyebrow">
            Algunos números más
          </p>

          <h2>
            Detrás del viaje también hay datos.
          </h2>
        </div>

        <div class="trip-extra-grid">
          <div class="trip-extra-item">
            <span class="trip-extra-value">
              {formatNumber(metrics.flightKm)}
            </span>

            <span class="trip-extra-label">
              km de vuelos
            </span>
          </div>

          <div class="trip-extra-item">
            <span class="trip-extra-value">
              {formatNumber(metrics.boatNm)}
            </span>

            <span class="trip-extra-label">
              millas náuticas
            </span>
          </div>

          <div class="trip-extra-item">
            <span class="trip-extra-value">
              {formatNumber(metrics.countries)}
            </span>

            <span class="trip-extra-label">
              {metrics.countries === 1 ? "país" : "países"}
            </span>
          </div>
</div>
      </div>
    </section>

    <!-- =========================================================
         LO QUE NO HICIMOS
    ========================================================== -->
    {
      plannedPlaces.length > 0 && (
        <section class="trip-not-visited">
          <div class="trip-not-visited-inner">
            <div class="trip-not-visited-heading">
              <p class="trip-eyebrow">
                También forma parte del viaje
              </p>

              <h2>
                Lo que no hicimos.
              </h2>

              <p>
                Un viaje también se construye con los lugares que
                decidimos dejar fuera. En nuestro mapa quedaron muchas
                ideas y paradas posibles; aquí solo contamos como visita
                lo que podemos sostener con nuestros registros.
              </p>
            </div>

            <div class="trip-not-visited-list">
              {plannedPlaces.map((place) => (
                <article class="trip-not-visited-item">
                  <div>
                    <h3>{place.title}</h3>
                  </div>

                  <div class="trip-not-visited-reason">
                    <p>{place.reason}</p>

                    {place.lesson && (
                      <p class="trip-not-visited-lesson">
                        {place.lesson}
                      </p>
                    )}
                  </div>
                </article>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- =========================================================
         ALOJAMIENTOS
    ========================================================== -->
    {
      trip.accommodations.length > 0 && (
        <section class="trip-accommodations">
          <div class="trip-accommodations-inner">
            <div class="trip-section-header">
              <div>
                <p class="trip-eyebrow">
                  Dormir
                </p>

                <h2>
                  Los alojamientos.
                </h2>
              </div>
            </div>

            <div class="trip-accommodations-list">
              {trip.accommodations.map((accommodation) => (
                <article class="trip-accommodation-item">
                  <div class="trip-accommodation-location">
                    {accommodation.location}
                  </div>

                  <div class="trip-accommodation-name">
                    {accommodation.name}
                  </div>

                  <div class="trip-accommodation-price">
                    {formatNumber(accommodation.amount)}
                    <span>
                      {accommodation.currency ?? ""}
                    </span>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- =========================================================
         PRESUPUESTO
    ========================================================== -->
    {
      trip.budget.length > 0 && (
        <section class="trip-budget">
          <div class="trip-budget-inner">
            <div class="trip-section-header">
              <div>
                <p class="trip-eyebrow">El coste real</p>
                <h2>¿Cuánto costó realmente el viaje?</h2>
              </div>
            </div>

            <div class="trip-budget-hero">
              <div>
                <span class="trip-budget-kicker">Gasto registrado</span>
                <strong>{formatNumber(identifiedBudgetTotal)} <small>€</small></strong>
                <p>
                  Es el total que podemos reconstruir con los gastos que
                  tenemos registrados para este viaje.
                </p>
              </div>
            </div>

            <div class="trip-budget-groups">
              {
                budgetGroups.map((group, index) => (
                  <article class="trip-budget-group">
                    <div class="trip-budget-group-number">
                      {String(index + 1).padStart(2, "0")}
                    </div>

                    <div class="trip-budget-group-copy">
                      <h3>{group.label}</h3>
                      <p>{group.details}</p>
                    </div>

                    <strong class="trip-budget-group-total">
                      {formatNumber(group.total)} <small>€</small>
                    </strong>
                  </article>
                ))
              }
            </div>

            {
              trip.slug === "costa-rica" && (
                <div class="trip-budget-food">
                  <div>
                    <span>Alimentación</span>
                    <strong>{formatNumber(budgetByCategory("food"))} €</strong>
                  </div>

                  <div>
                    <span>Supermercados</span>
                    <strong>{formatNumber(supermarketTotal)} €</strong>
                  </div>

                  <div>
                    <span>Restaurantes y comidas</span>
                    <strong>{formatNumber(restaurantTotal)} €</strong>
                  </div>
                </div>
              )
            }

            <details class="trip-budget-detail">
              <summary>Ver el detalle de los gastos registrados</summary>

              <div class="trip-budget-list">
                {trip.budget.map((item) => (
                  <article class:list={[
                    "trip-budget-item",
                    { "trip-budget-item-cash": item.category === "cash" }
                  ]}>
                    <div class="trip-budget-category">
                      {formatBudgetCategory(item.category)}
                    </div>

                    <div class="trip-budget-description">
                      {item.description}
                      {item.notes && <small>{item.notes}</small>}
                    </div>

                    <div class="trip-budget-amount">
                      {formatNumber(item.amount)}
                      <span>{item.currency}</span>
                    </div>
                  </article>
                ))}
              </div>
            </details>
          </div>
        </section>
      )
    }

    <!-- =========================================================
         FOTO FINAL — PLAYA
    ========================================================== -->
    <section
      class="trip-final-photo"
      aria-label="Playa de Costa Rica"
    >
      <div class="trip-final-photo-inner">
        <figure>
          <Image
