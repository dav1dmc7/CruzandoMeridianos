      align-items: start !important;
    }

    html body .trip-page .trip-fauna-photo {
      overflow: visible !important;
    }

    html body .trip-page .trip-fauna-photo img {
      display: block !important;
      width: 100% !important;
      height: 100% !important;
      overflow: hidden !important;
      border-radius: 2px !important;
    }

    html body .trip-page .trip-fauna-featured img {
      min-height: 620px !important;
    }

    html body .trip-page .trip-fauna-perezoso {
      margin-top: 3rem !important;
    }

    html body .trip-page .trip-fauna-wide {
      margin-bottom: 2.5rem !important;
    }

    html body .trip-page .trip-fauna-photo figcaption {
      margin-top: .9rem !important;
      padding: 0 !important;
      font-size: .68rem !important;
      letter-spacing: .10em !important;
      line-height: 1.5 !important;
    }

    @media (max-width: 900px) {
      html body .trip-page .trip-photo-break-figure {
        width: min(620px, calc(100% - 2rem)) !important;
      }

      html body .trip-page .trip-fauna-grid {
        grid-template-columns: minmax(0, 1.35fr) minmax(180px, .8fr) !important;
        grid-template-rows: 360px 230px 230px !important;
      }

      html body .trip-page .trip-fauna-featured {
        grid-column: 1 !important;
        grid-row: 1 / span 2 !important;
      }

      html body .trip-page .trip-fauna-featured img {
        min-height: 0 !important;
      }

      html body .trip-page .trip-fauna-perezoso {
        grid-column: 2 !important;
        grid-row: 1 !important;
        margin-top: 0 !important;
      }

      html body .trip-page .trip-fauna-cocodrilo {
        grid-column: 2 !important;
        grid-row: 2 !important;
      }

      html body .trip-page .trip-fauna-rana {
        grid-column: 1 !important;
        grid-row: 3 !important;
      }

      html body .trip-page .trip-fauna-wide {
        grid-column: 2 !important;
        grid-row: 3 !important;
        margin-bottom: 0 !important;
      }
