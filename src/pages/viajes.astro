---
import Layout from "../layouts/Layout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import DestinationCard from "../components/sections/DestinationCard.astro";

import { destinations, type DestinationContinent } from "../data/destinations";
import { getGuideBySlug } from "../data/guides";
import type { GuideBlock } from "../data/guides/types";

const featuredDestinations = destinations.slice(0, 4);

const continents: DestinationContinent[] = [
  "Europa",
  "África",
  "Asia",
  "América",
  "Oceanía",
];

const exploreableDestinations = destinations
  .map((destination) => ({
    destination,
    guide: getGuideBySlug(destination.slug),
  }))
  .filter(
    (item) =>
      item.destination.status === "ready" &&
      item.guide?.editorial?.status === "published"
  )
  .map(({ destination, guide }) => ({
    destination,
    guide: guide!,
  }));

const getPlaceEntries = (guide: typeof exploreableDestinations[number]["guide"]) =>
  guide.sections.flatMap((section) =>
    (section.blocks ?? [])
      .filter((block: GuideBlock) => block.type === "place" || block.type === "region")
      .map((block: GuideBlock) => ({
        ...block,
        sectionTitle: section.title,
      }))
  );

const formatCount = (count: number, singular: string, plural: string) =>
  `${count} ${count === 1 ? singular : plural}`;
---

<Layout
  title="Viajes | Cruzando Meridianos"
  description="Explora nuestros destinos y descubre qué ver, qué hacer y qué necesitas saber en cada uno antes de decidir cómo viajar."
  canonical="/viajes"
>
  <Header />

  <main>
    <section class="travel-hero">
      <div class="travel-hero-inner">
        <div class="travel-hero-copy">
          <p class="eyebrow">VIAJES</p>

          <h1>
            Primero conoce el lugar.
            <em> Después decide el viaje.</em>
          </h1>

          <p class="travel-hero-description">
            Este es nuestro atlas de destinos: una forma de reunir en un mismo
            sitio qué puedes encontrar en cada país, qué experiencias ofrece,
            qué lugares despiertan interés y qué información conviene conocer
            antes de empezar a planificar.
          </p>
        </div>

        <div class="travel-hero-note">
          <span>Qué encontrarás</span>

          <p>
            Lugares, naturaleza, cultura, actividades e información práctica.
            La planificación del viaje viene después.
          </p>
        </div>
      </div>
    </section>

    <section class="destination-explorer" id="explorador">
      <div class="explorer-inner">
        <div class="explorer-heading">
          <div>
            <p class="eyebrow">EXPLORADOR DE DESTINOS</p>
            <h2>¿Dónde te gustaría viajar?</h2>
          </div>

          <p>
            Busca un país directamente o explora por continente. Aquí iremos
            incorporando todos los destinos que vayamos investigando.
          </p>
        </div>

        <div class="destination-search">
          <label for="destination-search-input">Buscar un destino</label>
          <div class="destination-search-field">
            <span aria-hidden="true">⌕</span>
            <input
              id="destination-search-input"
              type="search"
              autocomplete="off"
              placeholder="Escribe un país…"
            />
          </div>
        </div>

        <div class="continent-filter" role="group" aria-label="Filtrar por continente">
          <button type="button" class="continent-button is-active" data-continent="all">
            Todos
          </button>

          {continents.map((continent) => (
            <button
              type="button"
              class="continent-button"
              data-continent={continent}
            >
              {continent}
            </button>
          ))}
        </div>

        <div class="destination-results" data-destination-results>
          {destinations.map((destination) => (
            <a
              href={destination.status === "ready" ? `/viajes/${destination.slug}` : "#"}
              class:list={[
                "destination-result",
                { "destination-result--disabled": destination.status !== "ready" },
              ]}
              data-destination-card
              data-name={destination.name.toLowerCase()}
              data-continent={destination.continent}
              aria-label={
                destination.status === "ready"
                  ? `Explorar ${destination.name}`
                  : `${destination.name}, próximamente`
              }
              data-ready={destination.status === "ready" ? "true" : "false"}
            >
              <span class="destination-result-number">{destination.number}</span>
              <span class="destination-result-copy">
                <strong>{destination.name}</strong>
                <small>{destination.continent}</small>
              </span>
              <span class="destination-result-status">
                {destination.status === "ready" ? "Explorar ↗" : "Próximamente"}
              </span>
            </a>
          ))}
        </div>

        <p class="destination-no-results" data-no-results hidden>
          No encontramos ese destino todavía. Prueba con otro nombre o explora un continente.
        </p>
      </div>
    </section>

    <section class="popular-destinations" data-popular-section>
      <div class="popular-inner">
        <div class="popular-heading">
          <div>
            <p class="eyebrow">EN EL RADAR</p>
            <h2>Destinos para empezar a curiosear.</h2>
          </div>

          <p>
            Una primera selección para entrar, descubrir y empezar a decidir qué te despierta curiosidad.
          </p>
        </div>

        <div class="popular-grid">
          {featuredDestinations.map((destination, index) => (
            <DestinationCard
              destination={destination}
              featured={index === 0}
            />
          ))}
        </div>
      </div>
    </section>

    {exploreableDestinations.map(({ destination, guide }) => {
      const places = getPlaceEntries(guide);

      return (
        <section
          class="destination-atlas"
          id={`atlas-${destination.slug}`}
        >
          <div class="destination-atlas-inner">
            <div class="destination-atlas-header">
              <div>
                <p class="eyebrow">EXPLORAR DESTINO</p>
                <h2>{destination.name}</h2>
              </div>

              <div class="destination-atlas-intro">
                <p>{guide.subtitle}</p>
                <a href={`/viajes/${destination.slug}`}>
                  Abrir guía completa <span aria-hidden="true">↗</span>
                </a>
              </div>
            </div>

            <details class="destination-atlas-disclosure">
              <summary>
                <span>
                  {places.length > 0
                    ? formatCount(places.length, "lugar o zona para explorar", "lugares y zonas para explorar")
                    : "Explorar el destino"}
                </span>
                <span class="summary-toggle" aria-hidden="true">+</span>
              </summary>

              <div class="places-grid">
                {places.length > 0 ? (
                  places.map((place) => (
                    <article class="place-card">
                      <div class="place-card-topline">
                        <span>{place.type === "region" ? "Zona" : "Lugar"}</span>
                        <span>{place.sectionTitle}</span>
                      </div>

                      {place.title && <h3>{place.title}</h3>}

                      {place.content && <p>{place.content}</p>}

                      {place.items && place.items.length > 0 && (
                        <ul>
                          {place.items.map((item) => <li>{item}</li>)}
                        </ul>
                      )}
                    </article>
                  ))
                ) : (
                  <p class="places-empty">
                    Estamos incorporando los lugares y experiencias de este destino.
                  </p>
                )}
              </div>
            </details>
          </div>
        </section>
      );
    })}

    <section class="knowledge">
      <div class="knowledge-inner">
        <div class="knowledge-copy">
          <p class="eyebrow">EL ATLAS CRECE</p>

          <h2>Un destino es mucho más que una lista de sitios.</h2>

          <p>
            A medida que incorporemos nuevos países iremos reuniendo aquí todo
            aquello que ayuda a entenderlos: naturaleza, playas, parques, fauna,
            cultura, pueblos, gastronomía, actividades, zonas e información
            práctica. El siguiente paso es convertir tus intereses en un viaje.
          </p>
        </div>

        <div class="knowledge-grid">
          <article>
            <span>01</span>
            <h3>Lugares y zonas</h3>
            <p>Los sitios que merece la pena conocer para empezar a imaginar el destino.</p>
          </article>

          <article>
            <span>02</span>
            <h3>Qué hacer</h3>
            <p>Naturaleza, cultura, gastronomía y experiencias disponibles en cada lugar.</p>
          </article>

          <article>
            <span>03</span>
            <h3>Información útil</h3>
            <p>Lo que conviene saber para viajar preparado, con fuentes y revisiones cuando corresponda.</p>
          </article>

          <article>
            <span>04</span>
            <h3>Después, tu viaje</h3>
            <p>Cuando ya sabes qué te interesa, nosotros unimos tus preferencias en una propuesta pensada para ti.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="travel-cta">
      <div class="travel-cta-inner">
        <p class="eyebrow">YA SABES QUÉ TE LLAMA</p>

        <h2>Ahora podemos convertir tus intereses en viaje.</h2>

        <p>
          Tú descubres el destino. Nosotros hacemos el trabajo de unir tus preferencias,
          tiempos y prioridades en una propuesta pensada para ti.
        </p>

        <a href="/cuentatuviaje" class="button-primary">
          Cuéntanos tu viaje
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    const searchInput = document.querySelector<HTMLInputElement>("#destination-search-input");
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-continent]"));
    const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-destination-card]"));
    const noResults = document.querySelector<HTMLElement>("[data-no-results]");
    const popularSection = document.querySelector<HTMLElement>("[data-popular-section]");

    let activeContinent = "all";

    const applyFilters = () => {
      const query = (searchInput?.value ?? "").trim().toLowerCase();
      let visible = 0;

      cards.forEach((card) => {
        const name = card.dataset.name ?? "";
        const continent = card.dataset.continent ?? "";
        const matchesQuery = !query || name.includes(query);
        const matchesContinent = activeContinent === "all" || continent === activeContinent;
        const show = matchesQuery && matchesContinent;

        card.hidden = !show;
        if (show) visible += 1;
      });

      if (noResults) noResults.hidden = visible > 0;
      if (popularSection) popularSection.hidden = Boolean(query) || activeContinent !== "all";
    };

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        activeContinent = button.dataset.continent ?? "all";

        buttons.forEach((item) => {
          item.classList.toggle("is-active", item === button);
        });

        applyFilters();
      });
    });

    searchInput?.addEventListener("input", applyFilters);
  </script>
</main>

<style>
.travel-hero {
  padding: 9rem 2rem 7rem;
  background: var(--color-papel);
}

.travel-hero-inner {
  width: min(var(--content-width), calc(100% - 4rem));
