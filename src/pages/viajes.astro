---
import { Image } from "astro:assets";

import Layout from "../layouts/Layout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import DestinationCard from "../components/sections/DestinationCard.astro";

import { destinations, type DestinationContinent } from "../data/destinations";

const featuredDestinations = destinations.slice(0, 4);

const continents: DestinationContinent[] = [
  "Europa",
  "África",
  "Asia",
  "América",
  "Oceanía",
];
---

<Layout
  title="Viajes | Cruzando Meridianos"
  description="Explora nuestros destinos y descubre qué ver, qué hacer y qué necesitas saber en cada uno antes de decidir cómo viajar."
  canonical="/viajes"
>
  <Header />

  <main>
    <section class="travel-hero">
      <div class="travel-hero-inner">
        <div class="travel-hero-copy">
          <p class="eyebrow">VIAJES</p>
          <h1>Primero conoce el lugar.<em> Después decide el viaje.</em></h1>
          <p class="travel-hero-description">
            Este es nuestro atlas de destinos: países, regiones, lugares, naturaleza,
            actividades, cultura e información útil reunidos para que puedas descubrir
            qué te interesa antes de decidir cómo quieres viajar.
          </p>
        </div>

        <div class="travel-hero-note">
          <span>Cómo funciona</span>
          <p>Explora. Compara. Entiende. La ruta viene después.</p>
        </div>
      </div>
    </section>

    <section class="destination-explorer" id="explorador">
      <div class="explorer-inner">
        <div class="explorer-heading">
          <div>
            <p class="eyebrow">EXPLORADOR DE DESTINOS</p>
            <h2>¿Dónde te gustaría viajar?</h2>
          </div>
          <p>
            Busca un país directamente o explora por continente. Cada destino tiene su
            propio espacio para descubrirlo a fondo.
          </p>
        </div>

        <div class="destination-search">
          <label for="destination-search-input">Buscar un destino</label>
          <div class="destination-search-field">
            <span aria-hidden="true">⌕</span>
            <input id="destination-search-input" type="search" autocomplete="off" placeholder="Escribe un país…" />
          </div>
        </div>

        <div class="continent-filter" role="group" aria-label="Filtrar por continente">
          <button type="button" class="continent-button is-active" data-continent="all">Todos</button>
          {continents.map((continent) => (
            <button type="button" class="continent-button" data-continent={continent}>{continent}</button>
          ))}
        </div>

        <div class="destination-results" data-destination-results>
          {destinations.map((destination) => {
            const isReady = destination.status === "ready";
            return (
              <article class:list={["destination-result", { "destination-result--disabled": !isReady }]} data-destination-card data-name={destination.name.toLowerCase()} data-continent={destination.continent}>
                {isReady ? (
                  <a href={`/viajes/${destination.slug}`} class="destination-result-link" aria-label={`Explorar ${destination.name}`}>
                    <span class="destination-result-number">{destination.number}</span>
                    <span class="destination-result-copy">
                      <strong>{destination.name}</strong>
                      <small>{destination.continent}</small>
                    </span>
                    <span class="destination-result-image" aria-hidden="true">
                      <Image src={destination.image} alt="" loading="lazy" />
                    </span>
                    <span class="destination-result-status">Explorar ↗</span>
                  </a>
                ) : (
                  <div class="destination-result-link" aria-disabled="true">
                    <span class="destination-result-number">{destination.number}</span>
                    <span class="destination-result-copy">
                      <strong>{destination.name}</strong>
                      <small>{destination.continent}</small>
                    </span>
                    <span class="destination-result-image" aria-hidden="true">
                      <Image src={destination.image} alt="" loading="lazy" />
                    </span>
                    <span class="destination-result-status">Próximamente</span>
                  </div>
                )}
              </article>
            );
          })}
        </div>

        <p class="destination-no-results" data-no-results hidden>
          No encontramos ese destino todavía. Prueba con otro nombre o explora un continente.
        </p>
      </div>
    </section>

    <section class="popular-destinations" data-popular-section>
      <div class="popular-inner">
        <div class="popular-heading">
          <div>
            <p class="eyebrow">EN EL RADAR</p>
            <h2>Destinos para empezar a curiosear.</h2>
          </div>
          <p>Una primera selección para descubrir qué te llama antes de pensar en la ruta.</p>
        </div>

        <div class="popular-grid">
          {featuredDestinations.map((destination, index) => (
            <DestinationCard destination={destination} featured={index === 0} />
          ))}
        </div>
      </div>
    </section>

    <section class="knowledge">
      <div class="knowledge-inner">
        <div class="knowledge-copy">
          <p class="eyebrow">EL ATLAS CRECE</p>
          <h2>Una web que crece con cada destino que investigamos.</h2>
          <p>
            Cada país tiene su propio espacio. Allí reunimos lugares, regiones,
            naturaleza, cultura, actividades e información útil para que puedas entender
            las posibilidades del destino antes de decidir cómo quieres viajar.
          </p>
        </div>

        <div class="knowledge-grid">
          <article><span>01</span><h3>Descubrir</h3><p>Qué existe, qué merece tu atención y qué rincones despiertan curiosidad.</p></article>
          <article><span>02</span><h3>Entender</h3><p>Regiones, naturaleza, cultura y actividades para ver el destino como un conjunto.</p></article>
          <article><span>03</span><h3>Comprobar</h3><p>Fuentes y revisiones para que la información importante tenga contexto y fecha.</p></article>
          <article><span>04</span><h3>Decidir</h3><p>Cuando ya sabes qué te interesa, podemos convertirlo en un viaje pensado para ti.</p></article>
        </div>
      </div>
    </section>

    <section class="travel-cta">
      <div class="travel-cta-inner">
        <p class="eyebrow">YA SABES QUÉ TE LLAMA</p>
        <h2>Ahora podemos convertir tus intereses en viaje.</h2>
        <p>
          Tú exploras el destino. Nosotros hacemos el trabajo de unir tus preferencias,
          tiempos y prioridades en una propuesta pensada para ti.
        </p>
        <a href="/cuentatuviaje" class="button-primary">Cuéntanos tu viaje <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    const searchInput = document.querySelector<HTMLInputElement>("#destination-search-input");
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-continent]"));
    const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-destination-card]"));
    const noResults = document.querySelector<HTMLElement>("[data-no-results]");
    const popularSection = document.querySelector<HTMLElement>("[data-popular-section]");

    let activeContinent = "all";

    const applyFilters = () => {
      const query = (searchInput?.value ?? "").trim().toLowerCase();
      let visible = 0;

      cards.forEach((card) => {
        const name = card.dataset.name ?? "";
        const continent = card.dataset.continent ?? "";
        const show = (!query || name.includes(query)) && (activeContinent === "all" || continent === activeContinent);
        card.hidden = !show;
        if (show) visible += 1;
      });

      if (noResults) noResults.hidden = visible > 0;
      if (popularSection) popularSection.hidden = Boolean(query) || activeContinent !== "all";
    };

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        activeContinent = button.dataset.continent ?? "all";
        buttons.forEach((item) => item.classList.toggle("is-active", item === button));
        applyFilters();
      });
    });

    searchInput?.addEventListener("input", applyFilters);
  </script>
</Layout>

<style>
.travel-hero{padding:9rem 2rem 7rem;background:var(--color-papel)}
.travel-hero-inner{width:min(var(--content-width),calc(100% - 4rem));margin:0 auto;display:grid;grid-template-columns:minmax(0,1.6fr) minmax(220px,.6fr);gap:6rem;align-items:end}
.travel-hero-copy{max-width:900px}
.eyebrow{margin:0 0 1.35rem;color:var(--color-cobre);font-size:.72rem;font-weight:600;letter-spacing:2px;text-transform:uppercase}
.travel-hero h1{max-width:980px;margin:0;color:var(--color-bosque);font-family:var(--font-serif);font-size:clamp(3.8rem,7vw,6.8rem);font-weight:400;line-height:.96;letter-spacing:-.04em}
.travel-hero h1 em{color:var(--color-cobre);font-style:italic}
.travel-hero-description{max-width:720px;margin-top:2.5rem;color:#555;font-size:1.1rem;line-height:1.8}
.travel-hero-note{padding-left:2rem;border-left:1px solid rgba(28,48,38,.2)}
.travel-hero-note span{display:block;margin-bottom:.8rem;color:var(--color-cobre);font-size:.7rem;font-weight:600;letter-spacing:2px;text-transform:uppercase}
.travel-hero-note p{margin:0;color:#555;font-family:var(--font-serif);font-size:1.25rem;line-height:1.5}
.destination-explorer{padding:8rem 2rem;background:#f7f4ef}
.explorer-inner{width:min(var(--content-width),100%);margin:0 auto}
.explorer-heading{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,.55fr);gap:5rem;align-items:end}
.explorer-heading h2,.popular-heading h2{margin:0;color:var(--color-bosque);font-family:var(--font-serif);font-size:clamp(3rem,5vw,4.8rem);font-weight:400;line-height:1;letter-spacing:-.035em}
.explorer-heading>p,.popular-heading>p{margin:0;color:#555;font-size:1rem;line-height:1.75}
.destination-search{max-width:760px;margin-top:4rem}
.destination-search label{display:block;margin-bottom:.7rem;color:var(--color-bosque);font-size:.78rem;font-weight:600;letter-spacing:1px;text-transform:uppercase}
.destination-search-field{display:flex;align-items:center;gap:.8rem;padding:1rem 1.2rem;border:1px solid rgba(28,48,38,.18);border-radius:999px;background:var(--color-papel)}
.destination-search-field span{color:var(--color-cobre);font-size:1.2rem}
.destination-search-field input{width:100%;min-width:0;border:0;outline:0;background:transparent;color:var(--color-grafito);font:inherit;font-size:1rem}
.destination-search-field input::placeholder{color:#888}
.continent-filter{display:flex;flex-wrap:wrap;gap:.6rem;margin-top:2rem}
.continent-button{padding:.7rem 1rem;border:1px solid rgba(28,48,38,.18);border-radius:999px;background:transparent;color:var(--color-bosque);cursor:pointer;font:inherit;font-size:.82rem;transition:all .2s ease}
.continent-button:hover,.continent-button.is-active{border-color:var(--color-bosque);background:var(--color-bosque);color:var(--color-papel)}
.destination-results{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.9rem;margin-top:3rem}
.destination-result{min-width:0;border:1px solid rgba(28,48,38,.08);border-radius:18px;background:var(--color-papel);transition:transform .2s ease,border-color .2s ease}
.destination-result:hover{transform:translateY(-2px);border-color:rgba(28,48,38,.24)}
.destination-result[hidden]{display:none}
.destination-result--disabled{opacity:.64}
.destination-result--disabled:hover{transform:none;border-color:rgba(28,48,38,.08)}
.destination-result-link{display:grid;grid-template-columns:auto minmax(0,1fr) 72px auto;gap:.85rem;align-items:center;min-width:0;padding:1rem 1.05rem;color:inherit;text-decoration:none}
.destination-result-link[aria-disabled="true"]{cursor:default}
.destination-result-number{color:var(--color-cobre);font-size:.7rem;font-weight:600;letter-spacing:1px}
.destination-result-copy{min-width:0}
.destination-result-copy strong{display:block;overflow:hidden;color:var(--color-bosque);font-family:var(--font-serif);font-size:1.28rem;font-weight:400;line-height:1.1;text-overflow:ellipsis;white-space:nowrap}
.destination-result-copy small{display:block;margin-top:.25rem;color:#777;font-size:.68rem;text-transform:uppercase}
.destination-result-image{display:block;width:72px;height:48px;overflow:hidden;border-radius:9px;background:transparent}
.destination-result-image img{display:block;width:100%;height:100%;object-fit:contain;object-position:center}
.destination-result-status{justify-self:end;color:var(--color-cobre);font-size:.68rem;font-weight:600;white-space:nowrap}
.destination-result--disabled .destination-result-status{color:#777;font-weight:500}
.destination-no-results{margin:2rem 0 0;color:#666;font-size:.95rem}
.popular-destinations{padding:9rem 2rem;background:var(--color-papel)}
.popular-destinations[hidden]{display:none}
.popular-inner{width:min(var(--content-width),100%);margin:0 auto}
.popular-heading{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,.55fr);gap:5rem;align-items:end}
.popular-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:5rem 3rem;margin-top:5rem}
.knowledge{padding:9rem 2rem;background:var(--color-papel);border-top:1px solid rgba(28,48,38,.08)}
.knowledge-inner{width:min(var(--content-width),100%);margin:0 auto;display:grid;grid-template-columns:.85fr 1.15fr;gap:8rem}
.knowledge-copy{max-width:540px}
.knowledge-copy h2{margin:0;color:var(--color-bosque);font-family:var(--font-serif);font-size:clamp(3rem,4.5vw,4.4rem);font-weight:400;line-height:1;letter-spacing:-.035em}
.knowledge-copy>p:last-child{margin-top:2rem;color:#555;font-size:1rem;line-height:1.8}
.knowledge-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:3.5rem 3rem}
.knowledge-grid article{padding-top:1.5rem;border-top:1px solid rgba(28,48,38,.18)}
.knowledge-grid span{display:block;margin-bottom:1.1rem;color:var(--color-cobre);font-size:.72rem;font-weight:600;letter-spacing:2px}
.knowledge-grid h3{margin:0 0 .7rem;color:var(--color-bosque);font-family:var(--font-serif);font-size:1.9rem;font-weight:400}
.knowledge-grid p{margin:0;color:#555;font-size:.95rem;line-height:1.75}
.travel-cta{padding:9rem 2rem;background:var(--color-arena);text-align:center}
.travel-cta-inner{width:min(820px,100%);margin:0 auto}
.travel-cta h2{margin:0;color:var(--color-bosque);font-family:var(--font-serif);font-size:clamp(3rem,5.8vw,5.2rem);font-weight:400;line-height:.98;letter-spacing:-.035em}
.travel-cta p:not(.eyebrow){max-width:650px;margin:2rem auto 2.5rem;color:#555;font-size:1.05rem;line-height:1.75}
.travel-cta .button-primary{gap:.6rem}
.travel-cta .button-primary span{transition:transform .2s ease}
.travel-cta .button-primary:hover span{transform:translate(3px,-3px)}
@media (max-width:900px){.travel-hero{padding:7rem 1.5rem 5rem}.travel-hero-inner{width:min(100% - 3rem,var(--content-width));grid-template-columns:1fr;gap:3rem}.travel-hero h1{font-size:clamp(3.4rem,10vw,5rem)}.travel-hero-note{max-width:560px;padding-left:0;padding-top:1.5rem;border-left:0;border-top:1px solid rgba(28,48,38,.2)}.destination-explorer,.popular-destinations,.knowledge,.travel-cta{padding-left:1.5rem;padding-right:1.5rem}.destination-explorer,.popular-destinations{padding-top:6rem;padding-bottom:7rem}.explorer-heading,.popular-heading,.knowledge-inner{grid-template-columns:1fr;gap:2.5rem}.destination-results{grid-template-columns:repeat(2,minmax(0,1fr))}.popular-grid{gap:4rem 2rem;margin-top:4rem}.knowledge{padding-top:6rem;padding-bottom:7rem}.travel-cta{padding-top:7rem;padding-bottom:7rem}}
@media (max-width:650px){.destination-results,.popular-grid,.knowledge-grid{grid-template-columns:1fr}.destination-result-link{grid-template-columns:auto minmax(0,1fr) 64px}.destination-result-image{width:64px;height:46px}.destination-result-status{grid-column:2 / -1;justify-self:start}.destination-result-copy strong{font-size:1.18rem}.travel-cta h2{font-size:3rem}}
</style>
