  font-size: .92rem;
  line-height: 1.7;
}

.place-card p {
  margin: 0;
}

.place-card ul {
  margin: .9rem 0 0;
  padding-left: 1.1rem;
}

.place-card li + li {
  margin-top: .35rem;
}

.places-empty {
  margin: 0;
  padding: 1.5rem 0 2rem;
  color: #666;
  line-height: 1.7;
}

.knowledge {
  padding: 9rem 2rem;
  background: var(--color-papel);
}

.knowledge-inner {
  width: min(var(--content-width), 100%);
  margin: 0 auto;
  display: grid;
  grid-template-columns: .85fr 1.15fr;
  gap: 8rem;
}

.knowledge-copy {
  max-width: 540px;
}

.knowledge-copy h2 {
  margin: 0;
  color: var(--color-bosque);
  font-family: var(--font-serif);
  font-size: clamp(3rem, 4.5vw, 4.4rem);
  font-weight: 400;
  line-height: 1;
  letter-spacing: -.035em;
}

.knowledge-copy > p:last-child {
  margin-top: 2rem;
  color: #555;
  font-size: 1rem;
  line-height: 1.8;
}

.knowledge-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 3.5rem 3rem;
}

.knowledge-grid article {
  padding-top: 1.5rem;
  border-top: 1px solid rgba(28, 48, 38, .18);
}

.knowledge-grid span {
  display: block;
  margin-bottom: 1.1rem;
  color: var(--color-cobre);
  font-size: .72rem;
  font-weight: 600;
  letter-spacing: 2px;
}

.knowledge-grid h3 {
  margin: 0 0 .7rem;
  color: var(--color-bosque);
  font-family: var(--font-serif);
  font-size: 1.9rem;
  font-weight: 400;
}

.knowledge-grid p {
  margin: 0;
  color: #555;
  font-size: .95rem;
  line-height: 1.75;
}

.travel-cta {
  padding: 9rem 2rem;
  background: var(--color-arena);
  text-align: center;
}

.travel-cta-inner {
  width: min(820px, 100%);
  margin: 0 auto;
}

.travel-cta h2 {
  margin: 0;
  color: var(--color-bosque);
  font-family: var(--font-serif);
  font-size: clamp(3rem, 5.8vw, 5.2rem);
  font-weight: 400;
  line-height: .98;
