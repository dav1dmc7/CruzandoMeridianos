  margin-top: 2.5rem;
  color: #555;
  font-size: 1.1rem;
  line-height: 1.8;
}

.travel-hero-note {
  padding-left: 2rem;
  border-left: 1px solid rgba(28, 48, 38, .2);
}

.travel-hero-note span {
  display: block;
  margin-bottom: .8rem;
  color: var(--color-cobre);
  font-size: .7rem;
  font-weight: 600;
  letter-spacing: 2px;
  text-transform: uppercase;
}

.travel-hero-note p {
  margin: 0;
  color: #555;
  font-family: var(--font-serif);
  font-size: 1.25rem;
  line-height: 1.5;
}

.destination-explorer {
  padding: 8rem 2rem;
  background: #f7f4ef;
}

.explorer-inner {
  width: min(var(--content-width), 100%);
  margin: 0 auto;
}

.explorer-heading,
.popular-heading {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(280px, .55fr);
  gap: 5rem;
  align-items: end;
}

.explorer-heading h2,
.popular-heading h2 {
  margin: 0;
  color: var(--color-bosque);
  font-family: var(--font-serif);
  font-size: clamp(3rem, 5vw, 4.8rem);
  font-weight: 400;
  line-height: 1;
  letter-spacing: -.035em;
}

.explorer-heading > p,
.popular-heading > p {
  margin: 0;
  color: #555;
  font-size: 1rem;
  line-height: 1.75;
}

.destination-search {
  max-width: 760px;
  margin-top: 4rem;
}

.destination-search label {
  display: block;
  margin-bottom: .7rem;
  color: var(--color-bosque);
  font-size: .78rem;
  font-weight: 600;
  letter-spacing: 1px;
  text-transform: uppercase;
}

.destination-search-field {
  display: flex;
  align-items: center;
  gap: .8rem;
  padding: 1rem 1.2rem;
  border: 1px solid rgba(28, 48, 38, .18);
  border-radius: 999px;
  background: var(--color-papel);
}

.destination-search-field span {
  color: var(--color-cobre);
  font-size: 1.2rem;
}

.destination-search-field input {
  width: 100%;
  min-width: 0;
  border: 0;
  outline: 0;
  background: transparent;
  color: var(--color-grafito);
  font: inherit;
  font-size: 1rem;
}

.destination-search-field input::placeholder {
  color: #888;
}

.continent-filter {
  display: flex;
  flex-wrap: wrap;
  gap: .6rem;
  margin-top: 2rem;
}

.continent-button {
  padding: .7rem 1rem;
  border: 1px solid rgba(28, 48, 38, .18);
  border-radius: 999px;
  background: transparent;
  color: var(--color-bosque);
  cursor: pointer;
  font: inherit;
  font-size: .82rem;
  transition: all .2s ease;
}

.continent-button:hover,
.continent-button.is-active {
  border-color: var(--color-bosque);
  background: var(--color-bosque);
  color: var(--color-papel);
}

.destination-results {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: .9rem;
  margin-top: 3rem;
}

.destination-result {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  gap: 1rem;
  align-items: center;
  min-width: 0;
  padding: 1.2rem 1.25rem;
  border: 1px solid rgba(28, 48, 38, .12);
  border-radius: 18px;
  background: var(--color-papel);
  color: inherit;
  text-decoration: none;
  transition: transform .2s ease, border-color .2s ease;
}

.destination-result:hover {
  transform: translateY(-2px);
  border-color: rgba(28, 48, 38, .35);
}

.destination-result[hidden] {
  display: none;
}

.destination-result--disabled {
  cursor: default;
  opacity: .68;
}

.destination-result--disabled:hover {
  transform: none;
  border-color: rgba(28, 48, 38, .12);
}

.destination-result-number {
  color: var(--color-cobre);
  font-size: .7rem;
  font-weight: 600;
  letter-spacing: 1px;
}

.destination-result-copy {
  min-width: 0;
}

.destination-result-copy strong {
  display: block;
  overflow: hidden;
  color: var(--color-bosque);
  font-family: var(--font-serif);
  font-size: 1.35rem;
  font-weight: 400;
  line-height: 1.1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.destination-result-copy small {
  display: block;
  margin-top: .25rem;
  color: #777;
  font-size: .7rem;
  text-transform: uppercase;
}

.destination-result-status {
  color: var(--color-cobre);
  font-size: .7rem;
  font-weight: 600;
  white-space: nowrap;
}

.destination-result--disabled .destination-result-status {
  color: #777;
  font-weight: 500;
}

.destination-no-results {
  margin: 2rem 0 0;
  color: #666;
  font-size: .95rem;
}

.popular-destinations {
  padding: 9rem 2rem;
  background: var(--color-papel);
}

.popular-destinations[hidden] {
  display: none;
}

.popular-inner {
  width: min(var(--content-width), 100%);
  margin: 0 auto;
}

.popular-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 5rem 3rem;
  margin-top: 5rem;
}

.destination-atlas {
  padding: 8rem 2rem;
  background: #f7f4ef;
  border-top: 1px solid rgba(28, 48, 38, .08);
}

.destination-atlas:nth-of-type(even) {
  background: var(--color-arena);
}

.destination-atlas-inner {
  width: min(var(--content-width), 100%);
  margin: 0 auto;
}

.destination-atlas-header {
  display: grid;
  grid-template-columns: minmax(0, .9fr) minmax(280px, .7fr);
  gap: 5rem;
  align-items: end;
  margin-bottom: 3rem;
}

.destination-atlas-header h2 {
  margin: 0;
  color: var(--color-bosque);
  font-family: var(--font-serif);
  font-size: clamp(3rem, 5vw, 5rem);
  font-weight: 400;
  line-height: 1;
  letter-spacing: -.035em;
}

.destination-atlas-intro p {
  margin: 0;
  color: #555;
  font-size: 1.05rem;
  line-height: 1.75;
}

.destination-atlas-intro a {
  display: inline-flex;
  gap: .6rem;
  margin-top: 1.4rem;
  color: var(--color-bosque);
  font-size: .85rem;
  font-weight: 600;
  text-decoration: none;
}

.destination-atlas-intro a span {
  transition: transform .2s ease;
}

.destination-atlas-intro a:hover span {
  transform: translate(3px, -3px);
}

.destination-atlas-disclosure {
  border-top: 1px solid rgba(28, 48, 38, .2);
  border-bottom: 1px solid rgba(28, 48, 38, .2);
}

.destination-atlas-disclosure summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 2rem;
  padding: 1.5rem 0;
  cursor: pointer;
  list-style: none;
  color: var(--color-bosque);
  font-family: var(--font-serif);
  font-size: 1.6rem;
}

.destination-atlas-disclosure summary::-webkit-details-marker {
  display: none;
}

.summary-toggle {
  display: grid;
  width: 36px;
  height: 36px;
  place-items: center;
  border: 1px solid rgba(28, 48, 38, .2);
  border-radius: 999px;
  font-family: var(--font-sans);
  font-size: 1.2rem;
  line-height: 1;
  transition: transform .2s ease;
}

.destination-atlas-disclosure[open] .summary-toggle {
  transform: rotate(45deg);
}

.places-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1rem;
  padding: 0 0 2rem;
}

.place-card {
  min-height: 100%;
  padding: 1.5rem;
  border: 1px solid rgba(28, 48, 38, .1);
  border-radius: 18px;
  background: rgba(251, 249, 245, .7);
}

.place-card-topline {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: 1.2rem;
  color: var(--color-cobre);
  font-size: .64rem;
  font-weight: 600;
  letter-spacing: 1.3px;
  line-height: 1.4;
  text-transform: uppercase;
}

.place-card-topline span:last-child {
  color: #777;
  font-weight: 500;
  letter-spacing: .4px;
