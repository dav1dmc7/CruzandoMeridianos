---
import Layout from "../layouts/Layout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
---

<Layout
  title="Página no encontrada | Cruzando Meridianos"
  description="La página que buscas no está disponible. Puedes volver al inicio o seguir explorando Cruzando Meridianos."
>
  <Header />

  <main class="not-found">
    <section class="not-found-inner">
      <p class="eyebrow">404 · PÁGINA NO ENCONTRADA</p>
      <h1>Este camino no lleva a ningún sitio.</h1>
      <p>
        Puede que la página haya cambiado de lugar o que el enlace ya no sea válido.
        El viaje, por suerte, continúa.
      </p>

      <div class="actions">
        <a class="primary" href="/">Volver al inicio</a>
        <a class="secondary" href="/viajes">Explorar nuestras guías</a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .not-found {
    min-height: 58vh;
    display: grid;
    place-items: center;
    padding: 7rem 2rem;
    background: var(--color-papel);
  }

  .not-found-inner {
    width: min(760px, 100%);
    text-align: center;
  }

  .eyebrow {
    margin: 0 0 1.25rem;
    color: var(--color-cobre);
    font-size: .72rem;
    letter-spacing: .14em;
    font-weight: 600;
  }

  h1 {
    max-width: 720px;
    margin: 0 auto;
    font-size: clamp(3rem, 8vw, 6rem);
    line-height: .98;
  }

  .not-found-inner > p:not(.eyebrow) {
    max-width: 560px;
    margin: 1.75rem auto 0;
    color: rgba(26, 26, 26, .72);
    font-size: 1.08rem;
  }

  .actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: .8rem;
    margin-top: 2.25rem;
  }

  .actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: .8rem 1.15rem;
    border: 1px solid var(--color-bosque);
    text-decoration: none;
    transition: transform .2s ease, background .2s ease, color .2s ease;
  }

  .actions a:hover {
    transform: translateY(-1px);
  }

  .primary {
    background: var(--color-bosque);
    color: var(--color-papel);
  }

  .secondary {
    background: transparent;
    color: var(--color-bosque);
  }

  @media (max-width: 600px) {
    .not-found {
      padding: 5rem 1.25rem;
    }

    .actions {
      flex-direction: column;
    }

    .actions a {
      width: 100%;
    }
  }
</style>
