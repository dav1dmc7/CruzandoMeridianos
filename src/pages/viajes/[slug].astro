   SNAPSHOT
   ========================================================= */

.guide-snapshot {
  padding:
    8rem 0;

  background:
    #f3f0e9;
}

.guide-snapshot__header {
  display:
    grid;

  grid-template-columns:
    1fr .7fr;

  gap:
    4rem;

  align-items:
    end;

  margin-bottom:
    4rem;
}

.guide-snapshot__header h2 {
  margin:
    0;

  font-family:
    var(--font-serif);

  font-size:
    clamp(
      3rem,
      5vw,
      5rem
    );

  font-weight:
    400;

  line-height:
    .95;

  letter-spacing:
    -.035em;

  color:
    var(--color-bosque);
}

.guide-snapshot__climate {
  padding-left:
    1.5rem;

  border-left:
    2px solid
    var(--color-cobre);
}

.guide-snapshot__climate span {
  display:
    block;

  margin-bottom:
    .55rem;

  color:
    var(--color-cobre);

  font-size:
    .66rem;

  font-weight:
    600;

  letter-spacing:
    .13em;

  text-transform:
    uppercase;
}

.guide-snapshot__climate p {
  margin:
    0;

  color:
    #666;

  line-height:
    1.7;
}

.guide-snapshot__grid {
  display:
    grid;

  grid-template-columns:
    repeat(2,minmax(0,1fr));

  border-top:
    1px solid
    rgba(28,48,38,.15);
}

.guide-snapshot__grid article {
  padding:
    2.3rem 0;

  border-bottom:
    1px solid
    rgba(28,48,38,.15);
}

.guide-snapshot__grid article:nth-child(odd) {
  padding-right:
    3rem;
}

.guide-snapshot__grid article:nth-child(even) {
  padding-left:
    3rem;

  border-left:
    1px solid
    rgba(28,48,38,.15);
}

.guide-snapshot__grid span {
  display:
    block;

  margin-bottom:
    1.1rem;

  color:
    var(--color-cobre);

  font-size:
    .68rem;

  font-weight:
    500;

  letter-spacing:
    .14em;

  text-transform:
    uppercase;
}

.guide-snapshot__grid p,
.guide-snapshot__grid ul {
  margin:
    0;

  color:
    #555;

  line-height:
    1.7;
}

.guide-snapshot__grid ul {
  padding-left:
    1.1rem;
}

.guide-snapshot__grid li + li {
  margin-top:
    .45rem;
}


/* =========================================================
   TOC
   ========================================================= */

.guide-toc-section {
  padding:
    7rem 0 8rem;

  background:
    #ece9e1;
}

.guide-toc-header {
  display:
    grid;

  grid-template-columns:
    1fr .52fr;

  gap:
    5rem;

  align-items:
    end;

  margin-bottom:
    4rem;
}

.guide-toc-header h2 {
  max-width:
    760px;

  margin:
    0;

  font-family:
    var(--font-serif);

  font-size:
    clamp(
      2.7rem,
      4.5vw,
      4.7rem
    );

  font-weight:
    400;

  line-height:
    1;

  letter-spacing:
    -.035em;

  color:
    var(--color-bosque);
}

.guide-toc-header > p {
  margin:
    0;

  color:
    #666;

  line-height:
    1.75;
}

.guide-toc {
  display:
    grid;

  grid-template-columns:
    repeat(2,minmax(0,1fr));

  border-top:
    1px solid
    rgba(28,48,38,.14);
}

.guide-toc__item {
  display:
    grid;

  grid-template-columns:
    45px
    minmax(0,1fr)
    auto
    26px;

  gap:
    1rem;

  align-items:
    center;

  min-height:
    76px;

  padding:
    1rem 0;

  border-bottom:
    1px solid
    rgba(28,48,38,.14);

  color:
    var(--color-bosque);

  text-decoration:
    none;

  transition:
    color .2s ease,
    padding .25s ease;
}

.guide-toc__item:hover {
  padding-left:
    .5rem;

  color:
    var(--color-cobre);
}

.guide-toc__number {
  color:
    var(--color-cobre);

  font-size:
    .68rem;

  letter-spacing:
    .12em;
}

.guide-toc__title {
  font-size:
    .94rem;

  line-height:
    1.35;
}

.guide-toc__category {
  color:
    #8a8a8a;

  font-size:
    .62rem;

  letter-spacing:
    .06em;

  text-transform:
    uppercase;
}

.guide-toc__arrow {
  justify-self:
    end;

  opacity:
    0;

  transition:
    opacity .2s ease,
    transform .2s ease;
}

.guide-toc__item:hover
.guide-toc__arrow {
  opacity:
    1;

  transform:
    translate(3px,-3px);
}


/* =========================================================
   CONTEXT
   ========================================================= */

.guide-context {
  background:
    var(--color-bosque);
}

.guide-context__grid {
  display:
    grid;

  grid-template-columns:
    repeat(4,minmax(0,1fr));
}

.guide-context__grid article {
  padding:
    2.4rem 1.8rem;

  border-right:
    1px solid
    rgba(251,249,245,.13);
}

.guide-context__grid article:last-child {
  border-right:
    0;
}

.guide-context__grid span {
  display:
    block;

  margin-bottom:
    2rem;

  color:
    var(--color-cobre);

  font-size:
    .68rem;

  letter-spacing:
    .14em;
}

.guide-context__grid strong {
  display:
    block;

  margin-bottom:
    .55rem;

  font-family:
    var(--font-serif);

  font-size:
    1.5rem;

  font-weight:
    400;

  color:
    var(--color-papel);
}

.guide-context__grid p {
  margin:
    0;

  color:
    rgba(251,249,245,.62);

  font-size:
    .84rem;

  line-height:
    1.65;
}


/* =========================================================
   LIVE
   ========================================================= */

.guide-live {
  background:
    var(--color-cobre);

  color:
    var(--color-bosque);
}

.guide-live__inner {
  display:
    flex;

  align-items:
    center;

  justify-content:
    space-between;

  gap:
    2rem;

  min-height:
    72px;
}

.guide-live__heading {
  display:
    flex;

  align-items:
    center;

  gap:
    .8rem;
}

.guide-live__heading span {
  font-size:
    .66rem;

  font-weight:
    600;

  letter-spacing:
    .13em;

  text-transform:
    uppercase;
}

.guide-live__heading strong {
  font-family:
    var(--font-serif);

  font-size:
    1.15rem;

  font-weight:
    400;
}

.guide-live__link {
  color:
    inherit;

  font-size:
    .8rem;

  font-weight:
    600;

  text-decoration:
    none;
}


/* =========================================================
   GUIDE SECTIONS
   ========================================================= */

.guide-section {
  padding:
    8.5rem 0;

  background:
    var(--color-papel);
}

.guide-section:nth-child(even) {
  background:
    #f7f4ef;
}

.guide-section--planning {
  background:
    #f3f0e9 !important;
}

.guide-section--experience {
  background:
    var(--color-papel) !important;
}

.guide-section--practical {
  background:
    #f7f4ef !important;
}

.guide-section--updates {
  background:
    #ece9e1 !important;
}

.guide-section--dark {
  background:
    var(--color-bosque) !important;
}

.guide-section__header {
  display:
    grid;

  grid-template-columns:
    105px 1fr;

  gap:
    2rem;

  align-items:
    start;

  max-width:
    950px;

  margin-bottom:
    4.5rem;
}

.guide-section__number {
  color:
    var(--color-cobre);

  font-size:
    .78rem;

  letter-spacing:
    .14em;
}

.guide-section__category {
  margin:
    0 0 .9rem;

  color:
    var(--color-cobre);

  font-size:
    .68rem;

  font-weight:
    500;

  letter-spacing:
    .15em;

  text-transform:
    uppercase;
}

.guide-section__header h2 {
  margin:
    0;

  font-family:
    var(--font-serif);

  font-size:
    clamp(
      3rem,
      5.8vw,
      5.9rem
    );

  font-weight:
    400;

  line-height:
    .95;

  letter-spacing:
    -.04em;

  color:
    var(--color-bosque);
}

.guide-section--dark
.guide-section__header h2 {
  color:
    var(--color-papel);
}

.guide-section__body {
  display:
    grid;

  grid-template-columns:
    .8fr 1.2fr;

  gap:
    6rem;

  align-items:
    start;
}

.guide-section__intro {
  margin:
    0;

  font-family:
    var(--font-serif);

  font-size:
    1.65rem;

  line-height:
    1.45;

  color:
    var(--color-bosque);
}

.guide-section--dark
.guide-section__intro {
  color:
    var(--color-papel);
}

.guide-section__verified {
  display:
    inline-flex;

  align-items:
    center;

  gap:
    .45rem;

  margin-top:
    1.6rem;

  padding:
    .45rem .7rem;

  border:
    1px solid
    rgba(28,48,38,.13);

  border-radius:
    999px;

  color:
    var(--color-bosque);

  background:
    rgba(255,255,255,.35);

  font-size:
    .65rem;

  font-weight:
    600;

  letter-spacing:
    .04em;
}

.guide-section__verified span {
  color:
    var(--color-cobre);
}

.guide-section__copy {
  max-width:
    760px;
}

.guide-section__copy > p {
  margin:
    0 0 1.5rem;

  color:
    #606060;

  font-size:
    1rem;

  line-height:
    1.85;
}

.guide-section--dark
.guide-section__copy > p {
  color:
    rgba(251,249,245,.72);
}


/* =========================================================
   HIGHLIGHTS
   ========================================================= */

.guide-highlights {
  display:
    grid;

  grid-template-columns:
    repeat(2,minmax(0,1fr));

  gap:
    1rem;

  margin:
    2.5rem 0;
}

.guide-highlight {
  padding:
    1.6rem;

  border:
    1px solid
    rgba(28,48,38,.13);

  background:
    rgba(255,255,255,.3);

  transition:
    transform .25s ease,
    box-shadow .25s ease;
}

.guide-highlight:hover {
  transform:
    translateY(-3px);

  box-shadow:
    0 12px 30px
    rgba(28,48,38,.07);
}

.guide-highlight span {
  display:
    block;

  margin-bottom:
    1rem;

  color:
    var(--color-cobre);

  font-size:
    .66rem;

  font-weight:
    600;

  letter-spacing:
    .13em;

  text-transform:
    uppercase;
}

.guide-highlight h3 {
  margin:
    0 0 .65rem;

  font-family:
    var(--font-serif);

  font-size:
    1.4rem;

  font-weight:
    400;

  color:
    var(--color-bosque);
}

.guide-highlight p {
  margin:
    0;

  color:
    #666;

  font-size:
    .9rem;

  line-height:
    1.7;
}

.guide-highlight--warning {
  border-left:
    2px solid
    var(--color-cobre);
}

.guide-highlight--important {
  background:
    #ebe7de;
}

.guide-highlight--experience {
  background:
    rgba(28,48,38,.04);
}

.guide-highlight--decision {
  background:
    #f4f1e9;
}


/* =========================================================
   BLOCKS
   ========================================================= */

.guide-blocks {
  display:
    grid;

  gap:
    1rem;

  margin:
    2.5rem 0;
}

.guide-block {
  padding:
    1.7rem;

  border:
    1px solid
    rgba(28,48,38,.13);

  background:
    rgba(255,255,255,.3);
}

.guide-block__label {
  display:
    block;

  margin-bottom:
    .75rem;

  color:
    var(--color-cobre);

  font-size:
    .66rem;

  font-weight:
    600;

  letter-spacing:
    .13em;

  text-transform:
    uppercase;
}

.guide-block h3 {
  margin:
    0 0 .65rem;

  font-family:
    var(--font-serif);

  font-size:
    1.45rem;

  font-weight:
    400;

  color:
    var(--color-bosque);
}

.guide-block p,
.guide-block ul {
  margin:
    0;

  color:
    #666;

  line-height:
    1.75;
}

.guide-block ul {
  margin-top:
    1rem;

  padding-left:
    1.15rem;
}

.guide-block li + li {
  margin-top:
    .4rem;
}

.guide-block a {
  display:
    inline-block;

  margin-top:
    1rem;

  color:
    var(--color-bosque);

  font-size:
    .82rem;

  font-weight:
    600;
}

.guide-block--warning {
  border-left:
    2px solid
    var(--color-cobre);

  background:
    #f1ece2;
}

.guide-block--tip {
  background:
    #eef0eb;
}

.guide-block--important {
  background:
    #ebe7de;
}

.guide-block--highlight {
  background:
    #f4f1e9;
}

.guide-block--quote {
  border-left:
    2px solid
    var(--color-cobre);
}

.guide-block--source {
  background:
    #f6f3ed;
}

.guide-block--comparison,
.guide-block--table {
  background:
    #eeeae2;
}

.guide-block--experience {
  background:
    rgba(28,48,38,.04);
}


/* =========================================================
   DURATION
   ========================================================= */

.guide-duration-grid {
  display:
    grid;

  grid-template-columns:
    repeat(2,minmax(0,1fr));

  gap:
    1px;

  margin-top:
    2.5rem;
}

.guide-duration-grid article {
  padding:
    1.6rem;

  border:
    1px solid
    rgba(28,48,38,.13);

  background:
    rgba(255,255,255,.28);
}

.guide-duration-grid__featured {
  background:
    var(--color-bosque) !important;
}

.guide-duration-grid__featured strong,
.guide-duration-grid__featured p {
  color:
    var(--color-papel);
}

.guide-duration-grid span {
  display:
    block;

  margin-bottom:
    2rem;

  color:
    var(--color-cobre);

  font-size:
    .68rem;

  letter-spacing:
    .12em;

  text-transform:
    uppercase;
}

.guide-duration-grid strong {
  display:
    block;

  margin-bottom:
    .7rem;

  font-family:
    var(--font-serif);

  font-size:
    1.55rem;

  font-weight:
    400;

  color:
    var(--color-bosque);
}

.guide-duration-grid p {
  margin:
    0;

  color:
    #666;

  font-size:
    .88rem;

  line-height:
    1.65;
}


/* =========================================================
   ENTRY REQUIREMENTS
   ========================================================= */

.entry-requirements {
  margin-top:
    2.8rem;

  overflow:
    hidden;

  border:
    1px solid
    rgba(28,48,38,.16);

  border-radius:
    24px;

  background:
    #f4f1e9;

  box-shadow:
    0 18px 45px
    rgba(28,48,38,.06);
}

.entry-requirements__header {
  display:
    flex;

  align-items:
    center;

  justify-content:
    space-between;

  gap:
    1.5rem;

  padding:
    1.8rem;

  border-bottom:
    1px solid
    rgba(28,48,38,.12);
}

.entry-requirements__header > div > span {
  display:
    block;

  margin-bottom:
    .55rem;

  color:
    var(--color-cobre);

  font-size:
    .66rem;

  font-weight:
    600;

  letter-spacing:
    .13em;

  text-transform:
    uppercase;
}

.entry-requirements__header h3 {
  margin:
    0;

  font-family:
    var(--font-serif);

  font-size:
    2rem;

  font-weight:
    400;

  color:
    var(--color-bosque);
}

.entry-requirements__badge {
  padding:
    .45rem .7rem;

  border-radius:
    999px;

  background:
    var(--color-bosque);

  color:
    var(--color-papel);

  font-size:
    .65rem;

  font-weight:
    600;

  letter-spacing:
    .08em;

  text-transform:
    uppercase;
}

.entry-requirements__selector {
  display:
    flex;

  align-items:
    center;

  gap:
    1rem;

  padding:
    1.4rem 1.8rem;

  border-bottom:
    1px solid
    rgba(28,48,38,.12);
}

.entry-requirements__selector label {
  color:
    #777;

  font-size:
    .72rem;

  font-weight:
    500;

  letter-spacing:
    .08em;

  text-transform:
    uppercase;
}

.entry-requirements__selector select {
  min-width:
    220px;

  padding:
    .7rem .9rem;

  border:
    1px solid
    rgba(28,48,38,.18);

  border-radius:
    10px;

  background:
    var(--color-papel);

  color:
    var(--color-bosque);

  font:
    inherit;

  cursor:
    pointer;
}

.entry-requirements__help {
  margin:
    0;

  padding:
    1rem 1.8rem;

  border-bottom:
    1px solid
    rgba(28,48,38,.12);

  color:
    #777;

  font-size:
    .74rem;

  line-height:
    1.6;
}

.entry-result {
  display:
    grid;

  grid-template-columns:
    repeat(2,minmax(0,1fr));

  border-bottom:
    1px solid
    rgba(28,48,38,.12);
}

.entry-result > div {
  padding:
    1.5rem 1.8rem;
}

.entry-result > div:nth-child(odd) {
  border-right:
    1px solid
    rgba(28,48,38,.12);
}

.entry-result span {
  display:
    block;

  margin-bottom:
    .5rem;

  color:
    #777;

  font-size:
    .68rem;

  text-transform:
    uppercase;

  letter-spacing:
    .08em;
}

.entry-result strong {
  display:
    block;

  font-family:
    var(--font-serif);

  font-size:
    1.05rem;

  font-weight:
    400;

  line-height:
    1.45;

  color:
    var(--color-bosque);
}

.entry-notes {
  grid-column:
    1 / -1;

  border-top:
    1px solid
    rgba(28,48,38,.12);
}

.entry-notes > span {
  margin-bottom:
    .8rem;
}

.entry-notes p {
  margin:
    0 0 .5rem;

  color:
    #666;

  line-height:
    1.65;
}

.entry-notes p:last-child {
  margin-bottom:
    0;
}

.entry-requirements__footer {
  display:
    flex;

  align-items:
    center;

  justify-content:
    space-between;

  gap:
    1rem;

  padding:
    1.3rem 1.8rem;
}

.entry-requirements__footer span {
  color:
    #777;

  font-size:
    .72rem;
}

.entry-requirements__footer a {
  color:
    var(--color-bosque);

  font-size:
    .78rem;

  font-weight:
    600;
}

.entry-requirements__disclaimer {
  margin:
    0;

  padding:
    0 1.8rem 1.5rem;

  color:
    #777;

  font-size:
    .75rem;

  line-height:
    1.6;
}


/* =========================================================
   CLOSING
   ========================================================= */

.guide-section__closing {
  margin-top:
    2.5rem;

  padding:
    1.7rem 0 0;

  border-top:
    1px solid
    rgba(28,48,38,.15);
}

.guide-section__closing span {
  display:
    block;

  margin-bottom:
    .7rem;

  color:
    var(--color-cobre);

  font-size:
    .66rem;

  font-weight:
    600;

  letter-spacing:
    .13em;

  text-transform:
    uppercase;
}

.guide-section__closing p {
  margin:
    0;

  font-family:
    var(--font-serif);

  font-size:
    1.2rem;

  line-height:
    1.5;

  color:
    var(--color-bosque);
}


/* =========================================================
   ALERTS
   ========================================================= */

.guide-alerts {
  margin-top:
    2.5rem;
}

.guide-alert {
  display:
    grid;

  grid-template-columns:
    150px 1fr;

  gap:
    2rem;

  padding:
    1.7rem 0;

  border-top:
    1px solid
    rgba(28,48,38,.15);
}

.guide-alert--high,
.guide-alert--critical {
  border-left:
    3px solid
    var(--color-cobre);

  padding-left:
    1.2rem;
}

.guide-alert__meta strong,
.guide-alert__meta span,
.guide-alert__meta small {
  display:
    block;
}

.guide-alert__meta strong {
  margin-bottom:
    .4rem;

  font-size:
    .67rem;

  letter-spacing:
    .1em;

  text-transform:
    uppercase;
}

.guide-alert__meta span {
  margin-bottom:
    .4rem;

  color:
    var(--color-cobre);

  font-size:
    .68rem;

  font-weight:
    600;

  letter-spacing:
    .1em;

  text-transform:
    uppercase;
}

.guide-alert__meta small {
  color:
    #777;

  font-size:
    .72rem;
}

.guide-alert h3 {
  margin:
    0 0 .6rem;

  font-family:
    var(--font-serif);

