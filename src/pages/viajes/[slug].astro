---
import { Image } from "astro:assets";

import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/layout/Footer.astro";

import { destinations } from "../../data/destinations";
import { getGuideBySlug } from "../../data/guides";

import type {
  DestinationGuide,
  GuideBlock,
  GuideHighlight,
  GuideSection,
  TravelAlert,
  TravelerRequirement,
  FAQItem,
} from "../../data/guides/types";


/* =========================================================
   ROUTE
   ========================================================= */

const slug =
  Astro.params.slug;

if (!slug) {
  return Astro.redirect("/viajes");
}


/* =========================================================
   DESTINATION
   ========================================================= */

const destination =
  destinations.find(
    (item) =>
      item.slug === slug
  );

if (
  !destination ||
  destination.status !== "ready" ||
  !destination.image
) {
  return Astro.redirect("/viajes");
}


/* =========================================================
   GUIDE
   ========================================================= */

const guide:
  DestinationGuide | undefined =
    getGuideBySlug(slug);

if (!guide) {
  return Astro.redirect("/viajes");
}


/* =========================================================
   CURRENT DATE
   ========================================================= */

const now =
  new Date();


/* =========================================================
   ACTIVE ALERTS
   ========================================================= */

const activeAlerts:
  TravelAlert[] =
    [...guide.alerts]
      .filter(
        (alert) => {

          if (!alert.active) {
            return false;
          }

          if (!alert.expiresAt) {
            return true;
          }

          return (
            new Date(
              `${alert.expiresAt}T23:59:59`
            ).getTime()
            >=
            now.getTime()
          );
        }
      )
      .sort(
        (a, b) =>
          new Date(b.date).getTime()
          -
          new Date(a.date).getTime()
      );

const hasAlerts =
  activeAlerts.length > 0;

const hasFaq =
  guide.faq.length > 0;


/* =========================================================
   ENTRY REQUIREMENTS
   ========================================================= */

const entryRequirements =
  guide.entryRequirements;

const travelerOptions:
  TravelerRequirement[] =
    entryRequirements?.travelers ?? [];

const defaultTraveler:
  TravelerRequirement | undefined =
    entryRequirements
      ? travelerOptions.find(
          (traveler) =>
            traveler.countryCode ===
            entryRequirements.defaultCountryCode
        ) ?? travelerOptions[0]
      : undefined;


/* =========================================================
   SECTION HELPERS
   ========================================================= */

const getSectionCategory =
  (
    section: GuideSection
  ): string => {

    switch (section.category) {
      case "overview":
        return "Guía del destino";

      case "planning":
        return "Planificación";

      case "experience":
        return "Experiencias";

      case "practical":
        return "Información práctica";

      case "updates":
        return "Actualidad";

      default:
        return "Guía del destino";
    }
  };


/* =========================================================
   BLOCK HELPERS
   ========================================================= */

const getBlockClass =
  (
    block: GuideBlock
  ): string =>
    `guide-block guide-block--${block.type}`;


/* =========================================================
   HIGHLIGHT LABELS
   ========================================================= */

const getHighlightLabel =
  (
    highlight: GuideHighlight
  ): string => {

    switch (highlight.type) {
      case "decision":
        return "Decisión";

      case "warning":
        return "Importante";

      case "experience":
        return "Experiencia";

      case "important":
        return "A tener en cuenta";

      case "tip":
        return "Consejo";

      default:
        return "A tener en cuenta";
    }
  };


/* =========================================================
   ALERT LABELS
   ========================================================= */

const getAlertLabel =
  (
    type: TravelAlert["type"]
  ): string => {

    const labels:
      Record<
        TravelAlert["type"],
        string
      > = {

      carretera:
        "Carretera",

      clima:
        "Clima",

      parque:
        "Parque",

      transporte:
        "Transporte",

      entrada:
        "Entrada",

      seguridad:
        "Seguridad",

      salud:
        "Salud",

      volcan:
        "Volcán",

      otro:
        "Información",
    };

    return labels[type];
  };


/* =========================================================
   ALERT SEVERITY
   ========================================================= */

const getAlertSeverityLabel =
  (
    severity:
      TravelAlert["severity"]
  ): string => {

    const labels:
      Record<
        TravelAlert["severity"],
        string
      > = {

      critical:
        "Crítico",

      high:
        "Importante",

      medium:
        "Atención",

      low:
        "Información",
    };

    return labels[severity];
  };


/* =========================================================
   VISA LABEL
   ========================================================= */

const formatVisaRequirement =
  (
    requirement:
      TravelerRequirement["visaRequirement"]
  ): string => {

    const labels:
      Record<
        TravelerRequirement["visaRequirement"],
        string
      > = {

      none:
        "Sin visado",

      consular:
        "Visado consular",

      restricted:
        "Visado restringido",

      special:
        "Condiciones especiales",
    };

    return labels[requirement];
  };


/* =========================================================
   SPECIAL IDS
   ========================================================= */

const durationSectionId =
  "cuantos-dias";

const entrySectionId =
  "documentacion-y-entrada";

const alertsSectionId =
  "actualidad-y-avisos";

const faqSectionId =
  "preguntas-frecuentes";

const errorsSectionId =
  "errores-habituales";


/* =========================================================
   EDITORIAL STATUS
   ========================================================= */

const getEditorialStatus =
  (
    status:
      NonNullable<DestinationGuide["editorial"]>["status"]
  ): string => {

    switch (status) {
      case "published":
        return "Publicada";

      case "in-review":
        return "En revisión";

      case "draft":
      default:
        return "En investigación";
    }
  };


/* =========================================================
   SEO
   ========================================================= */

const pageTitle =
  `${guide.title} | Cruzando Meridianos`;

const pageDescription =
  guide.subtitle;

const canonicalUrl =
  `https://www.cruzandomeridianos.com/viajes/${destination.slug}`;


/* =========================================================
   JSON-LD
   ========================================================= */

const guideSchema = {
  "@context":
    "https://schema.org",

  "@type":
    "Article",

  headline:
    guide.title,

  description:
    guide.subtitle,

  url:
    canonicalUrl,

  inLanguage:
    "es",

  ...(guide.editorial?.updatedAt
    ? {
        dateModified:
          guide.editorial.updatedAt,
      }
    : {}),

  author: {
    "@type":
      "Organization",

    name:
      "Cruzando Meridianos",

    url:
      "https://www.cruzandomeridianos.com",
  },

  publisher: {
    "@type":
      "Organization",

    name:
      "Cruzando Meridianos",

    url:
      "https://www.cruzandomeridianos.com",
  },

  image:
    destination.image.src,

  about: {
    "@type":
      "Place",

    name:
      destination.name,
  },

  mainEntityOfPage: {
    "@type":
      "WebPage",

    "@id":
      canonicalUrl,
  },
};


/* =========================================================
   TRAVELER DATA
   ========================================================= */

const travelerData =
  travelerOptions.map(
    (traveler) => ({
      countryCode:
        traveler.countryCode,

      countryName:
        traveler.countryName,

      visaRequirement:
        traveler.visaRequirement,

      maximumStay:
        traveler.maximumStay ??
        null,

      passportRequirement:
        traveler.passportRequirement ??
        null,

      returnTicketRequired:
        traveler.returnTicketRequired ??
        false,

      proofOfMeansRequired:
        traveler.proofOfMeansRequired ??
        false,

      entryFee:
        traveler.entryFee ??
        null,

      onwardTravelRequired:
        traveler.onwardTravelRequired ??
        false,

      yellowFeverRelevant:
        traveler.yellowFeverRelevant ??
        false,

      notes:
        traveler.notes ??
        [],

      sourceUrl:
        traveler.source?.url ??
        null,

      sourceLabel:
        traveler.source?.label ??
        null,

      reviewedAt:
        traveler.lastReviewed ??
        entryRequirements?.lastReviewed ??
        null,
    })
  );
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={`/viajes/${destination.slug}`}
  ogImage={destination.image.src}
>

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(guideSchema)}
  />
  <main
    class="guide-page"
    data-guide-slug={guide.slug}
  >

    <!-- =====================================================
         HERO
    ====================================================== -->

    <section
      class="guide-hero"
    >

      <div
        class="guide-hero__media"
        aria-hidden="true"
      >

        <Image
          src={destination.image}
          alt={destination.imageAlt}
          widths={[
            900,
            1400,
            1800,
            2200,
          ]}
          sizes="100vw"
          loading="eager"
          decoding="async"
        />

      </div>


      <div
        class="guide-hero__overlay"
        aria-hidden="true"
      ></div>


      <div
        class="guide-hero__content"
      >

        <div
          class="guide-hero__meta"
        >

          <span
            class="guide-hero__number"
          >
            {destination.number}
          </span>

          <span
            class="guide-hero__label"
          >
            Guía de viaje
          </span>

        </div>


        <h1>
          {guide.title}
        </h1>


        <p
          class="guide-hero__subtitle"
        >
          {guide.subtitle}
        </p>


        <div
          class="guide-hero__status"
        >

          <span>
            Estado editorial
          </span>

          <strong>
            {
              guide.editorial
                ? getEditorialStatus(
                    guide.editorial.status
                  )
                : "En investigación"
            }
          </strong>

        </div>


        {
          guide.editorial?.updatedAt && (

            <div
              class="guide-hero__updated"
            >

              Última revisión:

              <strong>
                {guide.editorial.updatedAt}
              </strong>

            </div>

          )
        }


        <a
          href="#en-esta-guia"
          class="guide-hero__scroll"
        >

          Explorar la guía

          <span
            aria-hidden="true"
          >
            ↓
          </span>

        </a>

      </div>

    </section>


    <!-- =====================================================
         INTRO
    ====================================================== -->

    <section
      id="en-esta-guia"
      class="guide-introduction"
    >

      <div
        class="
          guide-shell
          guide-introduction__grid
        "
      >

        <div
          class="guide-introduction__label"
        >

          <p class="eyebrow">
            Antes de empezar
          </p>

          <span>
            {guide.sections.length}
            secciones
          </span>

          {
            guide.editorial?.factsCheckedAt && (

              <span
                class="guide-introduction__checked"
              >
                Datos sensibles comprobados:
                {guide.editorial.factsCheckedAt}
              </span>

            )
          }

        </div>


        <div
          class="
            guide-introduction__content
          "
        >

          <h2>
            Entender el destino
            antes de decidir el viaje.
          </h2>


          <p
            class="guide-introduction__lead"
          >
            {guide.intro}
          </p>


          <p>
            No queremos convertir esta guía
            en una lista interminable de lugares
            que tachar.
          </p>


          <p>
            Queremos reunir investigación,
            información práctica y criterio
            para ayudarte a tomar mejores
            decisiones antes de viajar.
          </p>

        </div>

      </div>

    </section>


    <!-- =====================================================
         SNAPSHOT
    ====================================================== -->

    {
      guide.snapshot && (

        <section
          class="guide-snapshot"
        >

          <div class="guide-shell">

            <div
              class="
                guide-snapshot__header
              "
            >

              <div>

                <p class="eyebrow">
                  01 / Contexto
                </p>

                <h2>
                  {destination.name}
                  <br />
                  de un vistazo.
                </h2>

              </div>


              {
                guide.snapshot
                  .climateSummary && (

                  <div
                    class="
                      guide-snapshot__climate
                    "
                  >

                    <span>
                      Clima
                    </span>

                    <p>
                      {
                        guide.snapshot
                          .climateSummary
                      }
                    </p>

                  </div>

                )
              }

            </div>


            <div
              class="
                guide-snapshot__grid
              "
            >

              {
                guide.snapshot
                  .travelStyle && (

                  <article>

                    <span>
                      Estilo de viaje
                    </span>

                    <p>
                      {
                        guide.snapshot
                          .travelStyle
                      }
                    </p>

                  </article>

                )
              }


              {
                guide.snapshot
                  .mainStrengths &&
                guide.snapshot
                  .mainStrengths.length > 0 && (

                  <article>

                    <span>
                      Puntos fuertes
                    </span>

                    <ul>

                      {
                        guide.snapshot
                          .mainStrengths
                          .map(
                            (
                              item: string
                            ) => (

                              <li>
                                {item}
                              </li>

                            )
                          )
                      }

                    </ul>

                  </article>

                )
              }


              {
                guide.snapshot
                  .mainConsiderations &&
                guide.snapshot
                  .mainConsiderations.length > 0 && (

                  <article>

                    <span>
                      Lo que condiciona el viaje
                    </span>

                    <ul>

                      {
                        guide.snapshot
                          .mainConsiderations
                          .map(
                            (
                              item: string
                            ) => (

                              <li>
                                {item}
                              </li>

                            )
                          )
                      }

                    </ul>

                  </article>

                )
              }

            </div>

          </div>

        </section>

      )
    }


    <!-- =====================================================
         TOC
    ====================================================== -->

    <section
      class="guide-toc-section"
    >

      <div class="guide-shell">

        <div
          class="guide-toc-header"
        >

          <div>

            <p class="eyebrow">
              En esta guía
            </p>

            <h2>
              Una sola página.
              Todas las decisiones importantes.
            </h2>

          </div>


          <p>
            Puedes recorrerla de principio a fin
            o saltar directamente a la decisión
            que necesitas resolver.
          </p>

        </div>


        <nav
          class="guide-toc"
          aria-label="Índice de la guía"
        >

          {
            guide.sections.map(
              (
                section: GuideSection
              ) => (

                <a
                  href={`#${section.id}`}
                  class:list={[
                    "guide-toc__item",
                    `guide-toc__item--${
                      section.category ??
                      "overview"
                    }`,
                  ]}
                >

                  <span
                    class="
                      guide-toc__number
                    "
                  >
                    {section.number}
                  </span>


                  <span
                    class="
                      guide-toc__title
                    "
                  >
                    {section.title}
                  </span>


                  <span
                    class="
                      guide-toc__category
                    "
                  >
                    {getSectionCategory(
                      section
                    )}
                  </span>


                  <span
                    class="
                      guide-toc__arrow
                    "
                    aria-hidden="true"
                  >
                    ↗
                  </span>

                </a>

              )
            )
          }

        </nav>

      </div>

    </section>


    <!-- =====================================================
         CONTEXT STRIP
    ====================================================== -->

    <section
      class="guide-context"
    >

      <div
        class="
          guide-shell
          guide-context__grid
        "
      >

        <article>
          <span>01</span>

          <strong>
            Entender
          </strong>

          <p>
            Geografía, regiones,
            clima y características
            del destino.
          </p>
        </article>


        <article>
          <span>02</span>

          <strong>
            Elegir
          </strong>

          <p>
            Tiempo, zonas,
            experiencias y transporte.
          </p>
        </article>


        <article>
          <span>03</span>

          <strong>
            Preparar
          </strong>

          <p>
            Documentación, salud,
            dinero y conectividad.
          </p>
        </article>


        <article>
          <span>04</span>

          <strong>
            Decidir
          </strong>

          <p>
            Convertir información
            en un viaje coherente.
          </p>
        </article>

      </div>

    </section>


    <!-- =====================================================
         LIVE ALERT
    ====================================================== -->

    {
      hasAlerts && (

        <section
          class="guide-live"
        >

          <div
            class="
              guide-shell
              guide-live__inner
            "
          >

            <div
              class="
                guide-live__heading
              "
            >

              <span>
                Seguimiento activo
              </span>

              <strong>
                {activeAlerts.length}

                {
                  activeAlerts.length === 1
                    ? " aviso relevante"
                    : " avisos relevantes"
                }

              </strong>

            </div>


            <a
              href={`#${alertsSectionId}`}
              class="guide-live__link"
            >

              Ver actualidad

              <span
                aria-hidden="true"
              >
                ↓
              </span>

            </a>

          </div>

        </section>

      )
    }


    <!-- =====================================================
         CONTENT
    ====================================================== -->

    <div
      class="guide-content"
    >

      {
        guide.sections.map(
          (
            section: GuideSection,
            index: number
          ) => {

            const firstSection =
              index === 0;

            const darkSection =
              section.id ===
              errorsSectionId;

            return (

              <section
                id={section.id}
                data-section-category={section.category ?? "overview"}
                data-section-status={section.status ?? "draft"}
                class:list={[
                  "guide-section",

                  {
                    "guide-section--featured":
                      firstSection,

                    "guide-section--planning":
                      section.category ===
                      "planning",

                    "guide-section--experience":
                      section.category ===
                      "experience",

                    "guide-section--practical":
                      section.category ===
                      "practical",

                    "guide-section--updates":
                      section.category ===
                      "updates",

                    "guide-section--dark":
                      darkSection,
                  },
                ]}
              >

                <div
                  class="guide-shell"
                >

                  <div
                    class="
                      guide-section__header
                    "
                  >

                    <div
                      class="
                        guide-section__number
                      "
                    >
                      {section.number}
                    </div>


                    <div>

                      <p
                        class="
                          guide-section__category
                        "
                      >
                        {
                          getSectionCategory(
                            section
                          )
                        }
                      </p>


                      <h2>
                        {section.title}
                      </h2>

                    </div>

                  </div>


                  <div
                    class="
                      guide-section__body
                    "
                  >

                    <div>

                      {
                        section.intro && (

                          <p
                            class="
                              guide-section__intro
                            "
                          >
                            {section.intro}
                          </p>

                        )
                      }

                      {
                        section.status === "reviewed" && (
                          <div
                            class="guide-section__verified"
                            aria-label="Contenido revisado"
                          >
                            <span aria-hidden="true">✓</span>
                            Información revisada
                          </div>
                        )
                      }

                    </div>


                    <div
                      class="
                        guide-section__copy
                      "
                    >

                      {
                        section.paragraphs?.map(
                          (
                            paragraph: string
                          ) => (

                            <p>
                              {paragraph}
                            </p>

                          )
                        )
                      }


                      <!-- ===================================
                           HIGHLIGHTS
                      ==================================== -->

                      {
                        section.highlights &&
                        section.highlights.length > 0 && (

                          <div
                            class="
                              guide-highlights
                            "
                          >

                            {
                              section.highlights.map(
                                (
                                  highlight:
                                    GuideHighlight
                                ) => (

                                  <article
                                    class:list={[
                                      "guide-highlight",
                                      `guide-highlight--${
                                        highlight.type ??
                                        "tip"
                                      }`,
                                    ]}
                                  >

                                    <span>
                                      {
                                        getHighlightLabel(
                                          highlight
                                        )
                                      }
                                    </span>

                                    <h3>
                                      {
                                        highlight.title
                                      }
                                    </h3>

                                    <p>
                                      {
                                        highlight.description
                                      }
                                    </p>

                                  </article>

                                )
                              )
                            }

                          </div>

                        )
                      }


                      <!-- ===================================
                           BLOCKS
                      ==================================== -->

                      {
                        section.blocks &&
                        section.blocks.length > 0 && (

                          <div
                            class="
                              guide-blocks
                            "
                          >

                            {
                              section.blocks.map(
                                (
                                  block:
                                    GuideBlock
                                ) => (

                                  <article
                                    class={
                                      getBlockClass(
                                        block
                                      )
                                    }
                                  >

                                    {
                                      block.label && (

                                        <span
                                          class="
                                            guide-block__label
                                          "
                                        >
                                          {block.label}
                                        </span>

                                      )
                                    }


                                    {
                                      block.title && (

                                        <h3>
                                          {block.title}
                                        </h3>

                                      )
                                    }


                                    {
                                      block.content && (

                                        <p>
                                          {
                                            block.content
                                          }
                                        </p>

                                      )
                                    }


                                    {
                                      block.items &&
                                      block.items.length > 0 && (

                                        <ul>

                                          {
                                            block.items.map(
                                              (
                                                item:
                                                  string
                                              ) => (

                                                <li>
                                                  {item}
                                                </li>

                                              )
                                            )
                                          }

                                        </ul>

                                      )
                                    }


                                    {
                                      block.source && (

                                        <a
                                          href={
                                            block
                                              .source
                                              .url
                                          }
                                          target="_blank"
                                          rel="noopener noreferrer"
                                        >

                                          {
                                            block
                                              .source
                                              .label
                                          }

                                          {" "}↗

                                        </a>

                                      )
                                    }

                                  </article>

                                )
                              )
                            }

                          </div>

                        )
                      }


                      <!-- ===================================
                           DURACIÓN
                      ==================================== -->

                      {
                        section.id ===
                        durationSectionId &&
                        guide.durationOptions &&
                        guide.durationOptions.length > 0 && (

                          <div
                            class="
                              guide-duration-grid
                            "
                          >

                            {
                              guide.durationOptions.map(
                                (
                                  option
                                ) => (

                                  <article
                                    class:list={[
                                      {
                                        "guide-duration-grid__featured":
                                          option.featured,
                                      },
                                    ]}
                                  >

                                    <span>
                                      {option.days}
                                      {" "}
                                      días
                                    </span>

                                    <strong>
                                      {option.title}
                                    </strong>

                                    <p>
                                      {
                                        option.description
                                      }
                                    </p>

                                  </article>

                                )
                              )
                            }

                          </div>

                        )
                      }


                      <!-- ===================================
                           ENTRY REQUIREMENTS
                      ==================================== -->

                      {
                        section.id ===
                        entrySectionId &&
                        entryRequirements &&
                        defaultTraveler && (

                          <div
                            class="
                              entry-requirements
                            "
                            data-entry-requirements
                          >

                            <div
                              class="
                                entry-requirements__header
                              "
                            >

                              <div>

                                <span>
                                  Requisitos según nacionalidad
                                </span>

                                <h3>
