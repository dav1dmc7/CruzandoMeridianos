  <Footer />


  <!-- =====================================================
       TRAVELER DATA
  ====================================================== -->

  {
    entryRequirements &&
    travelerOptions.length > 0 && (

      <script
        type="application/json"
        id="guide-traveler-data"
        is:inline
        set:html={
          JSON.stringify(
            travelerData
          )
        }
      ></script>

    )
  }


  <!-- =====================================================
       NATIONALITY SELECTOR
  ====================================================== -->

  {
    entryRequirements &&
    travelerOptions.length > 0 && (

      <script is:inline>
        (() => {

          const wrapper =
            document.querySelector(
              "[data-entry-requirements]"
            );

          const select =
            wrapper?.querySelector(
              "select"
            );

          const dataElement =
            document.getElementById(
              "guide-traveler-data"
            );

          if (
            !wrapper ||
            !select ||
            !dataElement
          ) {
            return;
          }

          let travelers = [];

          try {
            travelers =
              JSON.parse(
                dataElement.textContent ||
                "[]"
              );
          } catch {
            travelers = [];
          }


          const visaLabels = {
            none:
              "Sin visado",

            consular:
              "Visado consular",

            restricted:
              "Visado restringido",

            special:
              "Condiciones especiales",
          };


          const update =
            () => {

              const countryCode =
                select.value;

              const traveler =
                travelers.find(
                  (item) =>
                    item.countryCode ===
                    countryCode
                );

              if (!traveler) {
                return;
              }


              const setField =
                (
                  field,
                  value
                ) => {

                  const element =
                    wrapper.querySelector(
                      `[data-field="${field}"]`
                    );

                  if (element) {
                    element.textContent =
                      value;
                  }
                };


              setField(
                "visa",
                visaLabels[
                  traveler
                    .visaRequirement
                ] ??
                  traveler
                    .visaRequirement
              );


              setField(
                "stay",
                traveler
                  .maximumStay ??
                  "Consultar condiciones vigentes"
              );


              setField(
                "passport",
                traveler
                  .passportRequirement ??
                  "Consultar requisitos oficiales"
              );


              setField(
                "return",
                traveler
                  .returnTicketRequired
                  ? "Sí"
                  : "Consultar"
              );


              setField(
                "means",
                traveler
                  .proofOfMeansRequired
                  ? "Pueden solicitarse"
                  : "Consultar"
              );


              setField(
                "entryFee",
                traveler
                  .entryFee ??
                  "Consultar"
              );


              const notes =
                wrapper.querySelector(
                  '[data-field="notes"]'
                );

              if (
                notes
              ) {

                notes
                  .replaceChildren();

                (
                  traveler.notes ??
                  []
                )
                  .forEach(
                    (note) => {

                      const paragraph =
                        document
                          .createElement(
                            "p"
                          );

                      paragraph.textContent =
                        note;

                      notes.appendChild(
                        paragraph
                      );
                    }
                  );
              }
            };


          select.addEventListener(
            "change",
            update
          );

          update();

        })();
      </script>

    )
  }

