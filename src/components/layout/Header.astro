---
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const navItems = [
  { href: "/", label: "Inicio" },
  { href: "/como-trabajamos", label: "Cómo trabajamos" },
  { href: "/viajes", label: "Guías de destino" },
  { href: "/nuestros-viajes", label: "Nuestros viajes" },
  { href: "/recursos", label: "Recursos" },
  { href: "/sobre-nosotros", label: "Sobre nosotros" },
  { href: "/contacto", label: "Contacto" },
];

const isActive = (href: string) => {
  if (href === "/") return currentPath === "/";
  return currentPath === href || currentPath.startsWith(`${href}/`);
};
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand" aria-label="Cruzando Meridianos — Inicio">
      <img
        src="/logo.svg"
        alt=""
        class="brand-logo"
        width="1536"
        height="1024"
        fetchpriority="high"
        decoding="async"
      />
    </a>

    <nav class="main-nav" aria-label="Navegación principal">
      {navItems.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <a href="/cuentatuviaje" class="header-cta">Cuéntanos tu viaje</a>

    <button
      class="menu-toggle"
      type="button"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span></span><span></span><span></span>
    </button>
  </div>

  <nav
    id="mobile-menu"
    class="mobile-menu"
    aria-label="Navegación móvil"
    aria-hidden="true"
    inert
  >
    {navItems.map((item) => (
      <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
        {item.label}
      </a>
    ))}
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const mobileMenu = document.querySelector<HTMLElement>(".mobile-menu");
  const header = document.querySelector<HTMLElement>(".site-header");

  if (toggle && mobileMenu && header) {
    const closeMenu = () => {
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", "Abrir menú");
      mobileMenu.setAttribute("aria-hidden", "true");
      mobileMenu.setAttribute("inert", "");
      mobileMenu.classList.remove("is-open");
      document.body.classList.remove("menu-open");
    };

    const openMenu = () => {
      toggle.setAttribute("aria-expanded", "true");
      toggle.setAttribute("aria-label", "Cerrar menú");
      mobileMenu.setAttribute("aria-hidden", "false");
      mobileMenu.removeAttribute("inert");
      mobileMenu.classList.add("is-open");
      document.body.classList.add("menu-open");
    };

    toggle.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      if (isOpen) {
        closeMenu();
        toggle.focus();
      } else {
        openMenu();
        mobileMenu.querySelector<HTMLAnchorElement>("a")?.focus();
      }
    });

    mobileMenu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    document.addEventListener("click", (event) => {
      if (toggle.getAttribute("aria-expanded") !== "true") return;
      const target = event.target;
      if (target instanceof Node && !header.contains(target)) {
        closeMenu();
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
        closeMenu();
        toggle.focus();
      }
    });

    window.addEventListener("resize", () => {
      if (window.matchMedia("(min-width: 1081px)").matches && toggle.getAttribute("aria-expanded") === "true") {
        closeMenu();
      }
    });
  }
</script>

<style>
  .site-header { position: relative; z-index: 100; width: 100%; background: var(--color-papel); border-bottom: 1px solid rgba(28,48,38,.10); }
  .header-inner { width: min(1280px,calc(100% - 3rem)); min-height: 88px; margin: 0 auto; display: flex; align-items: center; gap: 2.2rem; }
  .brand { display:flex; align-items:center; flex-shrink:0; }
  .brand-logo { display:block; width:185px; height:auto; }
  .main-nav { margin-left:auto; display:flex; align-items:center; gap:1.15rem; }
  .main-nav a { position:relative; color:var(--color-bosque); text-decoration:none; white-space:nowrap; font-size:.82rem; font-weight:500; transition:color .2s ease,opacity .2s ease; }
  .main-nav a::after { content:"";position:absolute;left:0;right:0;bottom:-6px;height:1px;background:var(--color-cobre);transform:scaleX(0);transform-origin:center;transition:transform .2s ease; }
  .main-nav a:hover,.main-nav a[aria-current="page"] { color:var(--color-cobre); }
  .main-nav a:hover::after,.main-nav a[aria-current="page"]::after { transform:scaleX(1); }
  .header-cta { flex-shrink:0; display:inline-flex; align-items:center; justify-content:center; min-height:44px; padding:.72rem 1.1rem; border:1px solid var(--color-bosque); border-radius:999px; background:var(--color-bosque); color:var(--color-papel); text-decoration:none; white-space:nowrap; font-size:.78rem; font-weight:500; transition:transform .2s ease,background .2s ease,color .2s ease; }
  .header-cta:hover { transform:translateY(-1px); background:transparent; color:var(--color-bosque); }
  .menu-toggle { display:none; width:44px; height:44px; padding:0; border:1px solid rgba(28,48,38,.20); border-radius:50%; background:transparent; cursor:pointer; flex-shrink:0; align-items:center; justify-content:center; flex-direction:column; gap:5px; }
  .menu-toggle span { display:block; width:17px; height:1px; background:var(--color-bosque); }
  .menu-toggle:focus-visible { outline:2px solid var(--color-cobre); outline-offset:4px; }
  .mobile-menu { display:none; width:min(100% - 2rem,600px); margin:0 auto; padding:1.25rem 0 1.5rem; border-top:1px solid rgba(28,48,38,.08); }
  .mobile-menu a { display:block; min-height:48px; padding:.9rem 0; color:var(--color-bosque); text-decoration:none; font-family:var(--font-serif); font-size:1.25rem; border-bottom:1px solid rgba(28,48,38,.08); }
  .mobile-menu a[aria-current="page"] { color:var(--color-cobre); }
  .mobile-menu a:last-child { border-bottom:0; }
  .mobile-menu a:hover { color:var(--color-cobre); }
  @media (max-width:1180px) { .header-inner { width:min(100% - 2rem,1100px); gap:1rem; } .brand-logo { width:160px; } .main-nav { gap:.72rem; } .main-nav a { font-size:.7rem; } .header-cta { padding:.68rem .78rem; font-size:.7rem; } }
  @media (max-width:1080px) { .header-inner { min-height:80px; } .main-nav { display:none; } .header-cta { margin-left:auto; } .menu-toggle { display:flex; } .mobile-menu.is-open { display:block; } }
  @media (max-width:500px) { .header-inner { width:calc(100% - 1.5rem); gap:.7rem; } .brand-logo { width:135px; } .header-cta { min-height:44px; padding:.62rem .75rem; font-size:.68rem; } .menu-toggle { width:44px; height:44px; } }
  @media (prefers-reduced-motion: reduce) { .main-nav a,.main-nav a::after,.header-cta { transition:none; } }
</style>
