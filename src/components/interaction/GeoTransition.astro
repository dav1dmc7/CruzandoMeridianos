<div class="geo-transition" data-geo-transition-overlay aria-hidden="true">
  <div class="geo-transition-globe" aria-hidden="true">
    <span></span>
    <span></span>
  </div>
  <div class="geo-transition-copy">
    <span class="geo-transition-kicker">CRUZANDO MERIDIANOS</span>
    <strong data-geo-transition-label>Hacia el destino</strong>
  </div>
</div>

<script>
  const transition = document.querySelector<HTMLElement>("[data-geo-transition-overlay]");
  const label = document.querySelector<HTMLElement>("[data-geo-transition-label]");
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  let navigationTimer: number | null = null;

  const resetTransition = () => {
    if (navigationTimer !== null) {
      window.clearTimeout(navigationTimer);
      navigationTimer = null;
    }

    transition?.classList.remove("is-visible");
    transition?.setAttribute("aria-hidden", "true");
  };

  const isDestinationRoot = (pathname: string) => {
    const parts = pathname.split("/").filter(Boolean);
    return parts.length === 2 && (parts[0] === "viajes" || parts[0] === "nuestros-viajes");
  };

  window.addEventListener("pageshow", resetTransition);

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;

    const link = event.target.closest<HTMLAnchorElement>("a[href]");
    if (!link || event.defaultPrevented || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

    const target = new URL(link.href, window.location.href);
    if (target.origin !== window.location.origin || target.pathname === window.location.pathname) return;
    if (!isDestinationRoot(target.pathname) && !link.hasAttribute("data-geo-transition")) return;

    event.preventDefault();

    if (label) {
      label.textContent = link.dataset.geoLabel || link.textContent?.trim() || "Hacia el destino";
    }

    if (prefersReducedMotion || !transition) {
      window.location.href = target.href;
      return;
    }

    resetTransition();
    transition.classList.add("is-visible");
    transition.setAttribute("aria-hidden", "false");
    navigationTimer = window.setTimeout(() => {
      navigationTimer = null;
      window.location.href = target.href;
    }, 360);
  });
</script>

<style>
.geo-transition{position:fixed;inset:0;z-index:9999;display:grid;place-items:center;gap:1.5rem;pointer-events:none;background:rgba(28,48,38,.96);opacity:0;visibility:hidden;transform:translateY(8px);transition:opacity .22s ease,transform .22s ease,visibility .22s ease}
.geo-transition.is-visible{opacity:1;visibility:visible;transform:none;pointer-events:auto}
.geo-transition-globe{position:relative;width:78px;height:78px;border:1px solid rgba(251,249,245,.7);border-radius:50%;overflow:hidden;box-shadow:0 0 0 12px rgba(194,125,56,.08),0 0 0 24px rgba(194,125,56,.04)}
.geo-transition.is-visible .geo-transition-globe{animation:geoGlobeTravel 360ms cubic-bezier(.22,1,.36,1) both}
.geo-transition.is-visible .geo-transition-copy{animation:geoCopyTravel 300ms cubic-bezier(.22,1,.36,1) 40ms both}
.geo-transition-globe::before,.geo-transition-globe::after,.geo-transition-globe span{content:"";position:absolute;inset:8px;border:1px solid rgba(251,249,245,.35);border-radius:50%}
.geo-transition-globe::before{transform:scaleX(.45)}
.geo-transition-globe::after{transform:scaleY(.45)}
.geo-transition-globe span:first-child{inset:18px 3px;border-left:0;border-right:0;border-radius:50%}
.geo-transition-globe span:last-child{inset:3px 18px;border-top:0;border-bottom:0;border-radius:50%}
.geo-transition-copy{text-align:center;color:var(--color-papel,#fbf9f5)}
.geo-transition-kicker{display:block;margin-bottom:.55rem;color:var(--color-cobre,#c27d38);font-size:.65rem;font-weight:600;letter-spacing:2px}
.geo-transition-copy strong{display:block;font-family:var(--font-serif,Georgia,serif);font-size:clamp(2rem,5vw,3.6rem);font-weight:400}
@keyframes geoGlobeTravel{
  from{opacity:.35;transform:scale(.78) rotate(-10deg)}
  65%{opacity:1;transform:scale(1.04) rotate(2deg)}
  to{opacity:1;transform:scale(1) rotate(0deg)}
}
@keyframes geoCopyTravel{
  from{opacity:0;transform:translateY(10px)}
  to{opacity:1;transform:translateY(0)}
}
@media (prefers-reduced-motion:reduce){.geo-transition{transition:none}.geo-transition-globe{box-shadow:none}.geo-transition.is-visible .geo-transition-globe,.geo-transition.is-visible .geo-transition-copy{animation:none}}
</style>
