---
const currentPath = Astro.url.pathname;
const links = [
  ["/viajes/costa-rica", "Guía de Costa Rica"],
  ["/viajes/costa-rica/mejor-epoca", "Mejor época"],
  ["/viajes/costa-rica/parques-nacionales", "Parques nacionales"],
  ["/viajes/costa-rica/alquilar-coche", "Alquilar coche"],
  ["/viajes/costa-rica/caribe-o-pacifico", "Caribe o Pacífico"],
  ["/viajes/costa-rica/cuanto-tiempo", "Cuánto tiempo"],
] as const;

const isActive = (href: string) => currentPath === href;
---

<section class="cr-decision-nav" aria-label="Decisiones para viajar a Costa Rica">
  <div class="cr-decision-inner">
    <div class="cr-decision-copy">
      <p class="eyebrow">COSTA RICA · DECISIONES ÚTILES</p>
      <p>Antes de pensar en la ruta, hay algunas decisiones que cambian cómo merece la pena viajar.</p>
    </div>
    <nav class="cr-decision-links" aria-label="Contenido relacionado de Costa Rica">
      {links.map(([href, label]) => (
        <a
          href={href}
          data-track="costa_rica_decision_nav"
          data-track-label={label}
          class:list={{ active: isActive(href) }}
          aria-current={isActive(href) ? "page" : undefined}
        >
          {label}
        </a>
      ))}
    </nav>
  </div>
</section>

<style>
  .cr-decision-nav { background: var(--color-arena); border-block: 1px solid rgba(28,48,38,.1); }
  .cr-decision-inner { width: min(var(--content-width),calc(100% - 3rem)); margin: 0 auto; padding: 1.1rem 0; display: grid; grid-template-columns: minmax(240px,.65fr) minmax(0,1.35fr); gap: 2rem; align-items: center; }
  .eyebrow { margin: 0 0 .35rem; color: var(--color-cobre); font-size: .66rem; font-weight: 700; letter-spacing: 1.8px; text-transform: uppercase; }
  .cr-decision-copy p:last-child { margin: 0; color: rgba(26,26,26,.66); font-size: .86rem; line-height: 1.5; }
  .cr-decision-links { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: .45rem .8rem; align-items: center; }
  .cr-decision-links a { min-height: 30px; display: inline-flex; align-items: center; padding: .35rem .55rem; color: var(--color-bosque); text-decoration: none; font-size: .72rem; font-weight: 600; border-radius: 999px; }
  .cr-decision-links a:hover, .cr-decision-links a.active { color: var(--color-cobre); }
  @media (max-width: 980px) { .cr-decision-inner { grid-template-columns: 1fr; gap: .8rem; } .cr-decision-links { justify-content: flex-start; overflow-x: auto; flex-wrap: nowrap; padding-bottom: .15rem; scrollbar-width: thin; } .cr-decision-links a { flex: 0 0 auto; } }
</style>
