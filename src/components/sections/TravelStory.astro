---
import { Image } from "astro:assets";
import avestruces from "../../assets/images/avestruces.jpg";
---

<section class="travel-story">

  <div class="story-image">
    <Image
      src={avestruces}
      alt="Avestruces en libertad durante un viaje"
    />
  </div>

  <div class="story-content">

    <p class="eyebrow">
      LA EXPERIENCIA
    </p>

    <h2>
      Hay viajes que empiezan mucho antes de llegar.
    </h2>

    <p class="story-text">
      Una carretera cualquiera. Un desvío que merece la pena.
      Un lugar que no aparecía en la primera búsqueda.
    </p>

    <p class="story-text">
      Ahí es donde empieza nuestro trabajo.
    </p>

    <p class="story-highlight">
      Viajar con criterio también significa saber cuándo
      salirse del camino.
    </p>

  </div>

</section>

<style>

.travel-story {

  max-width: 1200px;
  width: 100%;

  margin: 8rem auto;

  padding: 0 2rem;

  display: grid;

  grid-template-columns: 1.15fr 0.85fr;

  gap: 5rem;

  align-items: center;

}

.story-image {

  width: 100%;

}

.story-image img {

  width: 100%;

  height: 620px;

  object-fit: cover;

  display: block;

  border-radius: 24px;

}

.story-content {

  max-width: 480px;

}

.eyebrow {

  margin: 0 0 1.5rem;

  letter-spacing: 3px;

  text-transform: uppercase;

  font-size: .8rem;

  color: var(--color-cobre);

}

h2 {

  margin: 0;

  font-size: 3.2rem;

  line-height: 1.1;

}

.story-text {

  margin-top: 2rem;

  font-size: 1.1rem;

  line-height: 1.8;

  color: #555;

}

.story-highlight {

  margin-top: 3rem;

  padding-left: 1.5rem;

  border-left: 2px solid var(--color-cobre);

  font-size: 1.15rem;

  line-height: 1.7;

  color: var(--color-bosque);

  font-weight: 600;

}


/* Móvil */

@media (max-width: 768px) {

  .travel-story {

    margin: 5rem auto;

    grid-template-columns: 1fr;

    gap: 3rem;

  }

  .story-image img {

    height: 450px;

  }

  h2 {

    font-size: 2.5rem;

  }

}

</style>