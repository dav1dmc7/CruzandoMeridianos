---
import { Image } from "astro:assets";
import selva from "../../assets/images/costa-rica/selva-costa-rica.jpg";
---

<section class="hero">
  <div class="hero-shell">
    <div class="hero-copy">
      <p class="eyebrow">CRUZANDO MERIDIANOS</p>

      <h1>
        Viajes diseñados para quienes quieren entender un lugar antes de vivirlo.
      </h1>

      <p class="description">
        Investigamos destinos, contrastamos información y ponemos nuestra experiencia al servicio de cada viaje.
        Menos ruido. Mejores decisiones. Más tiempo para disfrutar del camino.
      </p>

      <div class="buttons">
        <a href="/cuentatuviaje" class="button-primary">
          Cuéntanos tu viaje
        </a>

        <a href="/viajes" class="button-secondary">
          Explorar destinos
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <div class="hero-media">
      <div class="hero-image-frame">
        <Image
          src={selva}
          alt="Vegetación tropical en Costa Rica"
          widths={[700, 1000, 1400]}
          sizes="(max-width: 800px) 100vw, 48vw"
          loading="eager"
          decoding="async"
        />
      </div>

      <div class="hero-note" aria-hidden="true">
        <span>01</span>
        <strong>Costa Rica</strong>
        <small>Investigación en curso</small>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: min(820px, calc(100vh - 80px));
    display: flex;
    align-items: center;
    padding: 3rem 2rem 5rem;
    overflow: hidden;
  }

  .hero-shell {
    width: min(1320px, 100%);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(420px, 1.08fr);
    gap: clamp(3rem, 7vw, 7rem);
    align-items: center;
  }

  .hero-copy {
    max-width: 650px;
    padding-left: clamp(0rem, 2vw, 1.5rem);
  }

  .eyebrow {
    margin: 0 0 1.25rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-cobre);
  }

  h1 {
    margin: 0;
    max-width: 12ch;
    font-size: clamp(3.2rem, 5.5vw, 5.7rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .description {
    max-width: 620px;
    margin: 2rem 0 0;
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
    line-height: 1.75;
    color: var(--color-texto-suave, #555);
  }

  .buttons {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 2.5rem;
    flex-wrap: wrap;
  }

  .button-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0.95rem 1.5rem;
    border-radius: 999px;
    background: var(--color-bosque);
    color: white;
    text-decoration: none;
    font-weight: 600;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .button-primary:hover,
  .button-primary:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgb(0 0 0 / 12%);
  }

  .button-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--color-bosque);
    font-weight: 600;
    text-decoration: none;
  }

  .button-secondary span {
    transition: transform 180ms ease;
  }

  .button-secondary:hover span,
  .button-secondary:focus-visible span {
    transform: translateX(4px);
  }

  .hero-media {
    position: relative;
    width: min(100%, 650px);
    margin-left: auto;
  }

  .hero-image-frame {
    aspect-ratio: 0.95;
    min-height: 620px;
    overflow: hidden;
    border-radius: 2rem 2rem 10rem 2rem;
    box-shadow: 0 28px 70px rgb(0 0 0 / 14%);
    background: #ddd;
  }

  .hero-image-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 48%;
  }

  .hero-note {
    position: absolute;
    right: -1.2rem;
    bottom: 2rem;
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 0.65rem;
    row-gap: 0.15rem;
    min-width: 190px;
    padding: 1rem 1.15rem;
    border: 1px solid rgb(0 0 0 / 8%);
    border-radius: 1.1rem;
    background: rgb(251 249 245 / 94%);
    backdrop-filter: blur(14px);
    box-shadow: 0 18px 45px rgb(0 0 0 / 12%);
  }

  .hero-note span {
    grid-row: span 2;
    font-size: 0.8rem;
    color: var(--color-cobre);
  }

  .hero-note strong {
    font-size: 0.9rem;
  }

  .hero-note small {
    font-size: 0.75rem;
    color: var(--color-texto-suave, #666);
  }

  @media (max-width: 1100px) {
    .hero-shell {
      grid-template-columns: minmax(0, 0.9fr) minmax(360px, 1fr);
      gap: 3.5rem;
    }

    .hero-image-frame {
      min-height: 540px;
      border-bottom-right-radius: 7rem;
    }
  }

  @media (max-width: 800px) {
    .hero {
      min-height: auto;
      padding: 3.5rem 1.25rem 4rem;
    }

    .hero-shell {
      grid-template-columns: 1fr;
      gap: 2.75rem;
    }

    .hero-copy {
      padding-left: 0;
    }

    h1 {
      max-width: 11ch;
      font-size: clamp(3rem, 13vw, 4.5rem);
    }

    .description {
      font-size: 1.05rem;
      line-height: 1.7;
    }

    .buttons {
      align-items: flex-start;
      gap: 1rem;
      margin-top: 2rem;
    }

    .hero-media {
      width: 100%;
    }

    .hero-image-frame {
      aspect-ratio: 0.88;
      min-height: 0;
      border-radius: 1.5rem 1.5rem 5rem 1.5rem;
    }

    .hero-note {
      right: 0.75rem;
      bottom: 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .button-primary,
    .button-secondary span {
      transition: none;
    }
  }
</style>
