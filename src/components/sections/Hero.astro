---
import { Image } from "astro:assets";
import selva from "../../assets/images/costa-rica/selva-costa-rica.jpg";
---

<section class="hero">

  <div class="hero-content">

    <div class="hero-text">

      <p class="eyebrow">
        CRUZANDO MERIDIANOS
      </p>

      <h1>
        Viajes diseñados para quienes buscan algo más que un destino.
      </h1>

      <p class="description">
        Diseñamos cada viaje desde cero con investigación,
        experiencia y criterio para que solo tengas que
        disfrutar del camino.
      </p>

      <div class="buttons">
        <a href="/cuentatuviaje" class="button-primary">
          Planifica tu viaje
        </a>

        <a href="/destinos" class="button-secondary">
          Descubrir destinos
        </a>
      </div>

    </div>

    <div class="hero-image">
      <Image
        src={selva}
        alt="Sendero en la selva"
      />
    </div>

  </div>

</section>

<style>

  .hero {
    min-height: 85vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 4rem 2rem;
  }

  .hero-content {
    max-width: 1200px;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .eyebrow {
    letter-spacing: 3px;
    text-transform: uppercase;
    font-size: .85rem;
    color: var(--color-cobre);
    margin-bottom: 1rem;
  }

  h1 {
    font-size: 4rem;
    line-height: 1.1;
    margin: 0;
  }

  .description {
    margin-top: 2rem;
    font-size: 1.2rem;
    line-height: 1.8;
    color: #555;
  }

  .buttons {
    margin-top: 3rem;
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .button-primary {
    background: var(--color-bosque);
    color: white;
    padding: 1rem 2rem;
    border-radius: 999px;
    text-decoration: none;
  }

  .button-secondary {
    text-decoration: none;
    color: var(--color-bosque);
    font-weight: 600;
  }

  .hero-image {
    display: flex;
    justify-content: center;
  }

  .hero-image img {
    width: 420px;
    max-width: 100%;
    height: 620px;
    object-fit: cover;
    border-radius: 24px;
  }

  /* MOBILE */

  @media (max-width: 800px) {

    .hero {
      min-height: auto;
      padding: 5rem 1.5rem;
    }

    .hero-content {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    h1 {
      font-size: clamp(2.8rem, 11vw, 4rem);
      line-height: 1.05;
    }

    .description {
      font-size: 1.05rem;
      line-height: 1.7;
    }

    .buttons {
      justify-content: flex-start;
    }

    .hero-image img {
      width: 100%;
      max-width: none;
      height: 480px;
    }

  }

</style>