---
import { destinations } from "../../data/destinations";

const spain = destinations.filter((destination) => destination.country === "España");
const directSpain = spain.filter((destination) => !destination.region);
const regions = Array.from(new Set(spain.map((destination) => destination.region).filter(Boolean)));
---

<section class="destination-hierarchy" id="espana" aria-labelledby="destination-hierarchy-title">
  <div class="destination-hierarchy-orbit" aria-hidden="true">
    <span class="orbit orbit-one"></span>
    <span class="orbit orbit-two"></span>
    <span class="orbit orbit-three"></span>
    <span class="orbit-dot"></span>
    <span class="orbit-mark">CM</span>
  </div>

  <div class="destination-hierarchy-inner">
    <div class="destination-hierarchy-intro">
      <div>
        <p class="eyebrow">TERRITORIO PROPIO · ESPAÑA</p>
        <h2 id="destination-hierarchy-title">Un territorio más dentro del atlas.</h2>
      </div>
      <p>
        España también forma parte de nuestro mapa, pero el atlas no empieza ni termina aquí.
        La iremos construyendo por territorios y regiones, igual que hacemos con cualquier otro
        destino que investigamos a fondo.
      </p>
    </div>

    <div class="destination-hierarchy-path" aria-label="Jerarquía geográfica">
      <span>Europa</span><span aria-hidden="true">→</span><strong>España</strong>
    </div>

    <div class="destination-hierarchy-country">
      <div>
        <span class="destination-hierarchy-number">01</span>
        <h3>España</h3>
      </div>
      <p>{spain.length} {spain.length === 1 ? "destino" : "destinos"} en el radar · {regions.length} {regions.length === 1 ? "territorio" : "territorios"} con varios destinos.</p>
    </div>

    {regions.map((region, index) => {
      const regionDestinations = spain.filter((destination) => destination.region === region);
      const isCanaryHub = region === "Canarias";

      return (
        <div class="destination-hierarchy-group">
          <div class="destination-hierarchy-heading">
            <div>
              <span class="destination-hierarchy-number">{String(index + 1).padStart(2, "0")}</span>
              <h3>{region}</h3>
            </div>
            <p>
              {isCanaryHub
                ? `${regionDestinations.length} islas reunidas en un mismo espacio.`
                : regionDestinations.length === 1
                  ? "Un territorio más para descubrir."
                  : `${regionDestinations.length} destinos para descubrir con calma.`}
            </p>
          </div>

          <div class="destination-hierarchy-grid">
            {isCanaryHub ? (
              <a
                class="destination-hierarchy-card is-link destination-hierarchy-card--hub"
                href="/viajes/canarias"
                data-geo-transition
                data-geo-label="Islas Canarias"
                aria-label="Explorar las Islas Canarias y elegir una isla"
              >
                <span class="destination-hierarchy-card-number">01</span>
                <span class="destination-hierarchy-card-copy">
                  <strong>Islas Canarias</strong>
                  <small>Elegir entre {regionDestinations.length} islas</small>
                </span>
                <span class="destination-hierarchy-card-arrow" aria-hidden="true">↗</span>
              </a>
            ) : (
              regionDestinations.map((destination) => {
                const isReady = destination.status === "ready";

                return isReady ? (
                  <a
                    class="destination-hierarchy-card is-link"
                    href={`/viajes/${destination.slug}`}
                    data-geo-transition
                    data-geo-label={destination.name}
                    aria-label={`Explorar ${destination.name}`}
                  >
                    <span class="destination-hierarchy-card-number">{destination.number}</span>
                    <span class="destination-hierarchy-card-copy">
                      <strong>{destination.name}</strong>
                      <small>Explorar destino</small>
                    </span>
                    <span class="destination-hierarchy-card-arrow" aria-hidden="true">↗</span>
                  </a>
                ) : (
                  <div class="destination-hierarchy-card" aria-label={`${destination.name}, próximamente`}>
                    <span class="destination-hierarchy-card-number">{destination.number}</span>
                    <span class="destination-hierarchy-card-copy">
                      <strong>{destination.name}</strong>
                      <small>Próximamente</small>
                    </span>
                    <span class="destination-hierarchy-card-arrow" aria-hidden="true">↗</span>
                  </div>
                );
              })
            )}
          </div>
        </div>
      );
    })}

    {directSpain.length > 0 && (
      <div class="destination-hierarchy-group">
        <div class="destination-hierarchy-heading">
          <div>
            <span class="destination-hierarchy-number">{String(regions.length + 1).padStart(2, "0")}</span>
            <h3>Otros destinos de España</h3>
          </div>
          <p>Destinos que pertenecen directamente al país y que crecerán a medida que ampliemos el atlas.</p>
        </div>

        <div class="destination-hierarchy-grid">
          {directSpain.map((destination) => {
            const isReady = destination.status === "ready";
            return isReady ? (
              <a
                class="destination-hierarchy-card is-link"
                href={`/viajes/${destination.slug}`}
                data-geo-transition
                data-geo-label={destination.name}
                aria-label={`Explorar ${destination.name}`}
              >
                <span class="destination-hierarchy-card-number">{destination.number}</span>
                <span class="destination-hierarchy-card-copy">
                  <strong>{destination.name}</strong>
                  <small>Explorar destino</small>
                </span>
                <span class="destination-hierarchy-card-arrow" aria-hidden="true">↗</span>
              </a>
            ) : (
              <div class="destination-hierarchy-card" aria-label={`${destination.name}, próximamente`}>
                <span class="destination-hierarchy-card-number">{destination.number}</span>
                <span class="destination-hierarchy-card-copy">
                  <strong>{destination.name}</strong>
                  <small>Próximamente</small>
                </span>
                <span class="destination-hierarchy-card-arrow" aria-hidden="true">↗</span>
              </div>
            );
          })}
        </div>
      </div>
    )}

    <div class="destination-hierarchy-footer">
      <span>EL ATLAS SIGUE CRECIENDO</span>
      <p>España es una parte del mapa. El foco está en construir profundidad destino a destino.</p>
    </div>
  </div>
</section>

<style>
.destination-hierarchy{position:relative;isolation:isolate;overflow:hidden;padding:6rem 2rem 5rem;background:var(--color-bosque);color:var(--color-papel)}
.destination-hierarchy-inner{position:relative;z-index:2;width:min(var(--content-width),100%);margin:0 auto}
.destination-hierarchy-orbit{position:absolute;z-index:1;top:-145px;right:-110px;width:390px;height:390px;opacity:.38;pointer-events:none}
.orbit{position:absolute;inset:0;border:1px solid rgba(251,249,245,.11);border-radius:50%;transform:rotate(-18deg) scaleY(.38)}
.orbit-one{animation:cm-orbit 18s linear infinite}.orbit-two{inset:38px;transform:rotate(48deg) scaleY(.38);animation:cm-orbit-reverse 24s linear infinite}.orbit-three{inset:78px;transform:rotate(0deg) scaleY(.38);border-color:rgba(194,125,56,.18);animation:cm-orbit 30s linear infinite}.orbit-dot{position:absolute;top:14%;left:58%;width:7px;height:7px;border-radius:50%;background:var(--color-cobre);box-shadow:0 0 0 7px rgba(194,125,56,.07),0 0 26px rgba(194,125,56,.28)}.orbit-mark{position:absolute;top:43%;left:42%;display:grid;place-items:center;width:58px;height:58px;border:1px solid rgba(194,125,56,.42);border-radius:50%;color:var(--color-cobre-on-dark);font-family:var(--font-serif);font-size:1rem;letter-spacing:.12em;background:rgba(28,48,38,.3);backdrop-filter:blur(3px)}
@keyframes cm-orbit{to{transform:rotate(342deg) scaleY(.38)}}@keyframes cm-orbit-reverse{to{transform:rotate(-312deg) scaleY(.38)}}
.destination-hierarchy-intro{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,.55fr);gap:5rem;align-items:end}.destination-hierarchy h2{max-width:780px;margin:0;color:var(--color-papel);font-family:var(--font-serif);font-size:clamp(2.7rem,4.8vw,4.5rem);font-weight:400;line-height:1;letter-spacing:-.04em}.destination-hierarchy-intro>p{margin:0;color:rgba(251,249,245,.66);font-size:.96rem;line-height:1.8}.destination-hierarchy .eyebrow{color:var(--color-cobre-on-dark)}
.destination-hierarchy-path{display:flex;flex-wrap:wrap;align-items:center;gap:.55rem;margin-top:2.5rem;color:rgba(251,249,245,.48);font-size:.7rem;letter-spacing:1px;text-transform:uppercase}.destination-hierarchy-path strong{color:var(--color-papel);font-weight:600}.destination-hierarchy-country{display:flex;align-items:end;justify-content:space-between;gap:2rem;margin-top:2.8rem;padding:1.6rem 0;border-top:1px solid rgba(251,249,245,.14);border-bottom:1px solid rgba(251,249,245,.1)}.destination-hierarchy-country>div{display:flex;align-items:baseline;gap:1rem}.destination-hierarchy-country h3{margin:0;color:var(--color-papel);font-family:var(--font-serif);font-size:2.8rem;font-weight:400}.destination-hierarchy-country>p{margin:0;color:rgba(251,249,245,.5);font-size:.72rem;line-height:1.5;text-align:right;text-transform:uppercase;letter-spacing:.6px}.destination-hierarchy-group{margin-top:3rem}.destination-hierarchy-heading{display:grid;grid-template-columns:minmax(0,1fr) minmax(260px,.55fr);gap:4rem;align-items:end}.destination-hierarchy-heading>div{display:flex;align-items:baseline;gap:1rem}.destination-hierarchy-number{color:var(--color-cobre-on-dark);font-size:.66rem;font-weight:600;letter-spacing:2px}.destination-hierarchy-heading h3{margin:0;color:var(--color-papel);font-family:var(--font-serif);font-size:2.25rem;font-weight:400}.destination-hierarchy-heading>p{margin:0;color:rgba(251,249,245,.58);line-height:1.7;font-size:.92rem}.destination-hierarchy-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:.7rem;margin-top:1.4rem}.destination-hierarchy-card{display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:end;gap:.6rem;min-height:96px;padding:.9rem;border:1px solid rgba(251,249,245,.13);border-radius:14px;background:rgba(251,249,245,.04);color:inherit;text-decoration:none;transition:background .2s ease,border-color .2s ease,transform .2s ease}.destination-hierarchy-card:hover{transform:translateY(-2px);border-color:rgba(194,125,56,.58);background:rgba(194,125,56,.08)}.destination-hierarchy-card--hub{min-width:min(100%,420px)}.destination-hierarchy-card.is-link:focus-visible{outline:2px solid var(--color-cobre);outline-offset:3px}.destination-hierarchy-card-number{align-self:start;color:var(--color-cobre-on-dark);font-size:.62rem;font-weight:600;letter-spacing:1px}.destination-hierarchy-card-copy{min-width:0}.destination-hierarchy-card-copy strong{display:block;color:var(--color-papel);font-family:var(--font-serif);font-size:1.15rem;font-weight:400;line-height:1.05}.destination-hierarchy-card-copy small{display:block;margin-top:.35rem;color:rgba(251,249,245,.48);font-size:.62rem;text-transform:uppercase}.destination-hierarchy-card-arrow{color:var(--color-cobre-on-dark);font-size:.95rem}.destination-hierarchy-footer{display:flex;align-items:baseline;justify-content:space-between;gap:2rem;margin-top:3.2rem;padding-top:1.3rem;border-top:1px solid rgba(251,249,245,.11)}.destination-hierarchy-footer span{color:var(--color-cobre-on-dark);font-size:.64rem;font-weight:600;letter-spacing:2px}.destination-hierarchy-footer p{margin:0;color:rgba(251,249,245,.52);font-family:var(--font-serif);font-size:1rem}
@media(max-width:900px){.destination-hierarchy{padding:5rem 1.5rem}.destination-hierarchy-orbit{right:-180px;top:-170px;opacity:.28}.destination-hierarchy-intro,.destination-hierarchy-heading{grid-template-columns:1fr;gap:2rem}.destination-hierarchy-country{align-items:start;flex-direction:column}.destination-hierarchy-country>p{text-align:left}.destination-hierarchy-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.destination-hierarchy-footer{align-items:start;flex-direction:column}}@media(max-width:600px){.destination-hierarchy-grid{grid-template-columns:1fr}.destination-hierarchy-heading h3{font-size:2rem}.destination-hierarchy-card{min-height:88px}.destination-hierarchy-orbit{width:300px;height:300px;right:-175px}.destination-hierarchy-footer p{font-size:.96rem}}@media(prefers-reduced-motion:reduce){.orbit-one,.orbit-two,.orbit-three{animation:none}}
</style>
