---
import { destinations } from "../../data/destinations";

const spain = destinations.filter((destination) => destination.country === "España");
const directSpain = spain.filter((destination) => !destination.region);
const regions = Array.from(new Set(spain.map((destination) => destination.region).filter(Boolean)));
---

<section class="destination-hierarchy" id="espana" aria-labelledby="destination-hierarchy-title">
  <div class="destination-hierarchy-orbit" aria-hidden="true">
    <span class="orbit orbit-one"></span>
    <span class="orbit orbit-two"></span>
    <span class="orbit orbit-three"></span>
    <span class="orbit-dot"></span>
    <span class="orbit-mark">CM</span>
  </div>

  <div class="destination-hierarchy-inner">
    <div class="destination-hierarchy-intro">
      <div>
        <p class="eyebrow">ATLAS · ESPAÑA</p>
        <h2 id="destination-hierarchy-title">Empieza cerca. Después cruza cualquier meridiano.</h2>
      </div>
      <p>
        España no será una sola página: será un territorio completo dentro del atlas. A medida que
        añadamos destinos, los iremos ordenando por territorio y región para que puedas bajar desde
        el país hasta el lugar que te despierte curiosidad.
      </p>
    </div>

    <div class="destination-hierarchy-path" aria-label="Jerarquía geográfica">
      <span>Europa</span><span aria-hidden="true">→</span><strong>España</strong>
    </div>

    <div class="destination-hierarchy-country">
      <div>
        <span class="destination-hierarchy-number">01</span>
        <h3>España</h3>
      </div>
      <p>{spain.length} destinos en el radar · {regions.length} territorios con varios destinos.</p>
    </div>

    {regions.map((region, index) => {
      const regionDestinations = spain.filter((destination) => destination.region === region);

      return (
        <div class="destination-hierarchy-group">
          <div class="destination-hierarchy-heading">
            <div>
              <span class="destination-hierarchy-number">{String(index + 1).padStart(2, "0")}</span>
              <h3>{region}</h3>
            </div>
            <p>
              {regionDestinations.length === 1
                ? "Un punto del mapa para descubrir."
                : `${regionDestinations.length} destinos para descubrir con calma.`}
            </p>
          </div>

          <div class="destination-hierarchy-grid">
            {regionDestinations.map((destination) => {
              const isReady = destination.status === "ready";

              return isReady ? (
                <a
                  class="destination-hierarchy-card is-link"
                  href={`/viajes/${destination.slug}`}
                  data-geo-transition
                  data-geo-label={destination.name}
                  aria-label={`Explorar ${destination.name}`}
                >
                  <span class="destination-hierarchy-card-number">{destination.number}</span>
                  <span class="destination-hierarchy-card-copy">
                    <strong>{destination.name}</strong>
                    <small>Explorar destino</small>
                  </span>
                  <span class="destination-hierarchy-card-arrow" aria-hidden="true">↗</span>
                </a>
              ) : (
                <div class="destination-hierarchy-card" aria-label={`${destination.name}, próximamente`}>
                  <span class="destination-hierarchy-card-number">{destination.number}</span>
                  <span class="destination-hierarchy-card-copy">
                    <strong>{destination.name}</strong>
                    <small>Próximamente</small>
                  </span>
                  <span class="destination-hierarchy-card-arrow" aria-hidden="true">↗</span>
                </div>
              );
            })}
          </div>
        </div>
      );
    })}

    {directSpain.length > 0 && (
      <div class="destination-hierarchy-group">
        <div class="destination-hierarchy-heading">
          <div>
            <span class="destination-hierarchy-number">{String(regions.length + 1).padStart(2, "0")}</span>
            <h3>Otros destinos de España</h3>
          </div>
          <p>Destinos que pertenecen directamente al país y que crecerán a medida que ampliemos el atlas.</p>
        </div>

        <div class="destination-hierarchy-grid">
          {directSpain.map((destination) => {
            const isReady = destination.status === "ready";
            return isReady ? (
              <a
                class="destination-hierarchy-card is-link"
                href={`/viajes/${destination.slug}`}
                data-geo-transition
                data-geo-label={destination.name}
                aria-label={`Explorar ${destination.name}`}
              >
                <span class="destination-hierarchy-card-number">{destination.number}</span>
                <span class="destination-hierarchy-card-copy">
                  <strong>{destination.name}</strong>
                  <small>Explorar destino</small>
                </span>
                <span class="destination-hierarchy-card-arrow" aria-hidden="true">↗</span>
              </a>
            ) : (
              <div class="destination-hierarchy-card" aria-label={`${destination.name}, próximamente`}>
                <span class="destination-hierarchy-card-number">{destination.number}</span>
                <span class="destination-hierarchy-card-copy">
                  <strong>{destination.name}</strong>
                  <small>Próximamente</small>
                </span>
                <span class="destination-hierarchy-card-arrow" aria-hidden="true">↗</span>
              </div>
            );
          })}
        </div>
      </div>
    )}

    <div class="destination-hierarchy-footer">
      <span>EL ATLAS SIGUE CRECIENDO</span>
      <p>Hoy hay {spain.length} destinos en España. Mañana habrá muchos más.</p>
    </div>
  </div>
</section>

<style>
.destination-hierarchy{position:relative;isolation:isolate;overflow:hidden;padding:7rem 2rem 6rem;background:var(--color-bosque);color:var(--color-papel)}
.destination-hierarchy-inner{position:relative;z-index:2;width:min(var(--content-width),100%);margin:0 auto}
.destination-hierarchy-orbit{position:absolute;z-index:1;top:-120px;right:-70px;width:430px;height:430px;opacity:.55;pointer-events:none}
.orbit{position:absolute;inset:0;border:1px solid rgba(251,249,245,.13);border-radius:50%;transform:rotate(-18deg) scaleY(.38)}
.orbit-one{animation:cm-orbit 18s linear infinite}
.orbit-two{inset:38px;transform:rotate(48deg) scaleY(.38);animation:cm-orbit-reverse 24s linear infinite}
.orbit-three{inset:78px;transform:rotate(0deg) scaleY(.38);border-color:rgba(194,125,56,.22);animation:cm-orbit 30s linear infinite}
.orbit-dot{position:absolute;top:13%;left:58%;width:8px;height:8px;border-radius:50%;background:var(--color-cobre);box-shadow:0 0 0 8px rgba(194,125,56,.08),0 0 30px rgba(194,125,56,.35)}
.orbit-mark{position:absolute;top:43%;left:42%;display:grid;place-items:center;width:66px;height:66px;border:1px solid rgba(194,125,56,.55);border-radius:50%;color:var(--color-cobre);font-family:var(--font-serif);font-size:1.1rem;letter-spacing:.12em;background:rgba(28,48,38,.35);backdrop-filter:blur(3px)}
@keyframes cm-orbit{to{transform:rotate(342deg) scaleY(.38)}}
@keyframes cm-orbit-reverse{to{transform:rotate(-312deg) scaleY(.38)}}
.destination-hierarchy-intro{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(280px,.55fr);gap:5rem;align-items:end}
.destination-hierarchy h2{max-width:830px;margin:0;color:var(--color-papel);font-family:var(--font-serif);font-size:clamp(2.9rem,5.3vw,5rem);font-weight:400;line-height:.98;letter-spacing:-.04em}
.destination-hierarchy-intro>p{margin:0;color:rgba(251,249,245,.72);font-size:1rem;line-height:1.8}
.destination-hierarchy .eyebrow{color:var(--color-cobre)}
.destination-hierarchy-path{display:flex;flex-wrap:wrap;align-items:center;gap:.55rem;margin-top:3rem;color:rgba(251,249,245,.6);font-size:.74rem;letter-spacing:1px;text-transform:uppercase}
.destination-hierarchy-path strong{color:var(--color-papel);font-weight:600}
.destination-hierarchy-country{display:flex;align-items:end;justify-content:space-between;gap:2rem;margin-top:3.2rem;padding:2rem 0;border-top:1px solid rgba(251,249,245,.18);border-bottom:1px solid rgba(251,249,245,.12)}
.destination-hierarchy-country>div{display:flex;align-items:baseline;gap:1rem}
.destination-hierarchy-country h3{margin:0;color:var(--color-papel);font-family:var(--font-serif);font-size:3.2rem;font-weight:400}
.destination-hierarchy-country>p{margin:0;color:rgba(251,249,245,.58);font-size:.78rem;line-height:1.5;text-align:right;text-transform:uppercase;letter-spacing:.6px}
.destination-hierarchy-group{margin-top:3.5rem}
.destination-hierarchy-heading{display:grid;grid-template-columns:minmax(0,1fr) minmax(260px,.55fr);gap:4rem;align-items:end}
.destination-hierarchy-heading>div{display:flex;align-items:baseline;gap:1rem}
.destination-hierarchy-number{color:var(--color-cobre);font-size:.68rem;font-weight:600;letter-spacing:2px}
.destination-hierarchy-heading h3{margin:0;color:var(--color-papel);font-family:var(--font-serif);font-size:2.5rem;font-weight:400}
.destination-hierarchy-heading>p{margin:0;color:rgba(251,249,245,.66);line-height:1.7}
.destination-hierarchy-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:.8rem;margin-top:1.7rem}
.destination-hierarchy-card{display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:end;gap:.65rem;min-height:110px;padding:1rem;border:1px solid rgba(251,249,245,.16);border-radius:16px;background:rgba(251,249,245,.05);color:inherit;text-decoration:none;transition:background .2s ease,border-color .2s ease,transform .2s ease}
a.destination-hierarchy-card:hover{transform:translateY(-3px);border-color:rgba(194,125,56,.75);background:rgba(194,125,56,.1)}
.destination-hierarchy-card.is-link:focus-visible{outline:2px solid var(--color-cobre);outline-offset:3px}
.destination-hierarchy-card-number{align-self:start;color:var(--color-cobre);font-size:.65rem;font-weight:600;letter-spacing:1px}
.destination-hierarchy-card-copy{min-width:0}
.destination-hierarchy-card-copy strong{display:block;color:var(--color-papel);font-family:var(--font-serif);font-size:1.25rem;font-weight:400;line-height:1.05}
.destination-hierarchy-card-copy small{display:block;margin-top:.4rem;color:rgba(251,249,245,.55);font-size:.67rem;text-transform:uppercase}
.destination-hierarchy-card-arrow{color:var(--color-cobre);font-size:1rem}
.destination-hierarchy-footer{display:flex;align-items:baseline;justify-content:space-between;gap:2rem;margin-top:4rem;padding-top:1.6rem;border-top:1px solid rgba(251,249,245,.14)}
.destination-hierarchy-footer span{color:var(--color-cobre);font-size:.67rem;font-weight:600;letter-spacing:2px}
.destination-hierarchy-footer p{margin:0;color:rgba(251,249,245,.6);font-family:var(--font-serif);font-size:1.05rem}
@media(max-width:900px){.destination-hierarchy{padding:5rem 1.5rem}.destination-hierarchy-orbit{right:-170px;top:-160px;opacity:.35}.destination-hierarchy-intro,.destination-hierarchy-heading{grid-template-columns:1fr;gap:2rem}.destination-hierarchy-country{align-items:start;flex-direction:column}.destination-hierarchy-country>p{text-align:left}.destination-hierarchy-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.destination-hierarchy-footer{align-items:start;flex-direction:column}}
@media(max-width:600px){.destination-hierarchy-grid{grid-template-columns:1fr}.destination-hierarchy-heading h3{font-size:2.2rem}.destination-hierarchy-card{min-height:92px}.destination-hierarchy-orbit{width:330px;height:330px;right:-170px}.destination-hierarchy-footer p{font-size:1rem}}
@media(prefers-reduced-motion:reduce){.orbit-one,.orbit-two,.orbit-three{animation:none}}
</style>
