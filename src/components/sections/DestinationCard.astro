---
import { Image } from "astro:assets";
import type { Destination } from "../../data/destinations";

interface Props {
  destination: Destination;
  featured?: boolean;
}

const {
  destination,
  featured = false,
} = Astro.props;

const isReady = destination.status === "ready";
const destinationUrl = `/viajes/${destination.slug}`;
---

<article
  class:list={[
    "destination",
    {
      "destination-featured": featured,
      "destination-disabled": !isReady,
    },
  ]}
>

  <div class="destination-image">

    {isReady ? (

      <a
        href={destinationUrl}
        class="destination-image-link"
        aria-label={`Explorar ${destination.name}`}
      >
        <Image
          src={destination.image}
          alt={destination.imageAlt}
          loading={featured ? "eager" : "lazy"}
        />
      </a>

    ) : (

      <Image
        src={destination.image}
        alt={destination.imageAlt}
        loading={featured ? "eager" : "lazy"}
      />

    )}

    {!isReady && (
      <span class="destination-status">
        Próximamente
      </span>
    )}

  </div>


  <div class="destination-content">

    <span class="destination-number">
      {destination.number}
    </span>

    <h3>
      {isReady ? (
        <a
          href={destinationUrl}
          class="destination-title-link"
        >
          {destination.name}
        </a>
      ) : (
        destination.name
      )}
    </h3>

    <p>
      {destination.description}
    </p>

    {isReady ? (

      <a
        href={destinationUrl}
        class="destination-link"
      >
        Explorar destino
        <span aria-hidden="true">↗</span>
      </a>

    ) : (

      <span class="destination-coming">
        Estamos investigándolo
      </span>

    )}

  </div>

</article>


<style>

.destination {
  min-width: 0;
}


/* =========================================================
   IMAGEN
   ========================================================= */

.destination-image {
  position: relative;

  overflow: hidden;

  border-radius: 24px;

  background: var(--color-arena);
}

.destination-image-link {
  display: block;

  width: 100%;
  height: 100%;

  color: inherit;

  text-decoration: none;
}

.destination-image img {
  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;

  transition: transform .6s ease;
}

.destination:not(.destination-disabled):hover
.destination-image img {
  transform: scale(1.025);
}


/* =========================================================
   DESTINO DESTACADO — DESKTOP
   ========================================================= */

.destination-featured {
  display: grid;

  grid-template-columns: minmax(0, 1.65fr) minmax(320px, .85fr);

  gap: 5rem;

  align-items: center;
}

.destination-featured .destination-image {
  height: 560px;
}


/* =========================================================
   DESTINOS NORMALES — DESKTOP
   ========================================================= */

.destination:not(.destination-featured) .destination-image {
  height: 440px;
}


/* =========================================================
   CONTENIDO
   ========================================================= */

.destination-content {
  padding-top: 1.5rem;
}

.destination-number {
  display: block;

  margin-bottom: 1.4rem;

  color: var(--color-cobre);

  font-size: .8rem;
  letter-spacing: 2px;
}

.destination h3 {
  margin: 0 0 1rem;

  font-family: var(--font-serif);

  font-size: 2.35rem;
  font-weight: 500;
  line-height: 1.1;
}

.destination-title-link {
  color: inherit;

  text-decoration: none;

  transition: color .2s ease;
}

.destination-title-link:hover {
  color: var(--color-cobre);
}

.destination-content p {
  max-width: 460px;

  margin: 0;

  color: #555;

  font-size: 1rem;
  line-height: 1.7;
}


/* =========================================================
   LINKS
   ========================================================= */

.destination-link,
.destination-coming {
  display: inline-flex;

  align-items: center;

  gap: .6rem;

  margin-top: 1.5rem;

  font-size: .85rem;
  font-weight: 500;
}

.destination-link {
  color: var(--color-bosque);

  text-decoration: none;

  transition: color .2s ease;
}

.destination-link span {
  transition: transform .2s ease;
}

.destination-link:hover {
  color: var(--color-cobre);
}

.destination-link:hover span {
  transform: translate(3px, -3px);
}

.destination-coming {
  color: #777;

  font-size: .78rem;
  letter-spacing: .5px;
}


/* =========================================================
   PRÓXIMAMENTE
   ========================================================= */

.destination-status {
  position: absolute;

  top: 1.25rem;
  left: 1.25rem;

  padding: .5rem .8rem;

  border-radius: 999px;

  background: rgba(251, 249, 245, .92);

  color: var(--color-bosque);

  font-size: .7rem;
  font-weight: 500;

  letter-spacing: .5px;
}

.destination-disabled {
  opacity: .9;
}


/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 900px) {

  .destination-featured {
    grid-template-columns: minmax(0, 1.35fr) minmax(280px, .9fr);

    gap: 3rem;
  }

  .destination-featured .destination-image {
    height: 480px;
  }

  .destination:not(.destination-featured) .destination-image {
    height: 380px;
  }

}


/* =========================================================
   MÓVIL
   ORDEN:
   número
   título
   descripción
   enlace
   imagen
   ========================================================= */

@media (max-width: 700px) {

  .destination-featured {
    display: flex;

    flex-direction: column;

    gap: 2rem;

    align-items: stretch;
  }

  .destination {
    display: flex;

    flex-direction: column;

    gap: 1.75rem;
  }

  .destination-content {
    order: 1;

    padding-top: 0;
  }

  .destination-image {
    order: 2;
  }

  .destination-featured .destination-image,
  .destination:not(.destination-featured) .destination-image {
    height: 380px;

    width: 100%;
  }

  .destination h3 {
    font-size: 2rem;
  }

}


/* =========================================================
   MÓVIL PEQUEÑO
   ========================================================= */

@media (max-width: 500px) {

  .destination {
    gap: 1.5rem;
  }

  .destination-featured .destination-image,
  .destination:not(.destination-featured) .destination-image {
    height: 320px;

    border-radius: 18px;
  }

  .destination h3 {
    font-size: 1.85rem;
  }

  .destination-content p {
    font-size: .98rem;

    line-height: 1.7;
  }

}

</style>