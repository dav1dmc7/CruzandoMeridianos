---
import DestinationCard from "./DestinationCard.astro";
import { destinations } from "../../data/destinations";

const featuredDestination = destinations[0];
const otherDestinations = destinations.slice(1);
---

<section class="destinations">

  <div class="destinations-inner">

    <div class="destinations-intro">

      <p class="eyebrow">
        DESTINOS
      </p>

      <h2>
        Algunos lugares.<br />
        Infinitas formas de vivirlos.
      </h2>

      <p>
        No diseñamos viajes siguiendo una fórmula.
        Cada destino cambia cuando cambia la persona que lo recorre.
      </p>

    </div>


    <div class="destinations-grid">

      {featuredDestination && (
        <DestinationCard
          destination={featuredDestination}
          featured
        />
      )}

      {otherDestinations.map((destination) => (
        <DestinationCard
          destination={destination}
        />
      ))}

    </div>

  </div>

</section>


<style>

.destinations {
  padding: 9rem 2rem;

  background: #f7f4ef;
}

.destinations-inner {
  max-width: 1280px;

  margin: 0 auto;
}

.destinations-intro {
  max-width: 760px;

  margin-bottom: 6rem;
}

.eyebrow {
  margin: 0 0 1.5rem;

  color: var(--color-cobre);

  font-size: .8rem;
  letter-spacing: 3px;

  text-transform: uppercase;
}

.destinations-intro h2 {
  margin: 0;

  font-family: var(--font-serif);

  font-size: 3.8rem;
  font-weight: 500;

  line-height: 1.08;
}

.destinations-intro > p:last-child {
  max-width: 620px;

  margin-top: 2rem;

  color: #555;

  font-size: 1.1rem;
  line-height: 1.8;
}


/* ─────────────────────────────
   GRID
───────────────────────────── */

.destinations-grid {
  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 5rem 3rem;
}


/*
 * El primer destino es el protagonista
 * de la sección.
 */

.destinations-grid > :first-child {
  grid-column: 1 / -1;
}


/* ─────────────────────────────
   RESPONSIVE
───────────────────────────── */

@media (max-width: 800px) {

  .destinations {
    padding: 6rem 1.5rem;
  }

  .destinations-intro {
    margin-bottom: 4rem;
  }

  .destinations-intro h2 {
    font-size: 2.7rem;
  }

  .destinations-grid {
    grid-template-columns: 1fr;

    gap: 4rem;
  }

  .destinations-grid > :first-child {
    grid-column: auto;
  }

}


@media (max-width: 500px) {

  .destinations {
    padding: 5rem 1.25rem;
  }

  .destinations-intro h2 {
    font-size: 2.35rem;
  }

  .destinations-intro > p:last-child {
    font-size: 1rem;
    line-height: 1.7;
  }

}

</style>