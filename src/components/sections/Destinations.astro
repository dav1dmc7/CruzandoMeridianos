---
import DestinationCard from "./DestinationCard.astro";
import { destinations } from "../../data/destinations";

const featuredSlugs = [
  "costa-rica",
  "sudafrica",
  "grecia",
  "mauricio",
  "auroras",
];

const featuredDestinations = featuredSlugs
  .map((slug) => destinations.find((destination) => destination.slug === slug))
  .filter((destination) => destination !== undefined);
---

<section class="destinations">

  <div class="destinations-inner">

    <div class="destinations-intro">

      <p class="eyebrow">
        DESTINOS
      </p>

      <h2>
        Algunos lugares.<br />
        Infinitas formas de vivirlos.
      </h2>

      <p>
        No diseñamos viajes siguiendo una fórmula.
        Cada destino cambia cuando cambia la persona que lo recorre.
      </p>

      <p>
        No son un catálogo de viajes cerrados. Son una muestra de cómo investigamos un destino, qué decisiones merece la pena entender y dónde empieza el trabajo de diseñar un viaje a medida.
      </p>

      <a href="/viajes" class="destinations-index-link">
        Explorar todas las guías
        <span aria-hidden="true">↗</span>
      </a>

    </div>


    <div class="destinations-grid">

      {featuredDestinations.map((destination, index) => (
        <DestinationCard
          destination={destination}
          featured={index === 0}
        />
      ))}

    </div>

  </div>

</section>


<style>

.destinations {
  padding: 9rem 2rem;

  background: #f7f4ef;
}

.destinations-inner {
  max-width: 1280px;

  margin: 0 auto;
}

.destinations-intro {
  max-width: 760px;

  margin-bottom: 6rem;
}

.eyebrow {
  margin: 0 0 1.5rem;

  color: var(--color-cobre);

  font-size: .8rem;
  letter-spacing: 3px;

  text-transform: uppercase;
}

.destinations-intro h2 {
  margin: 0;

  font-family: var(--font-serif);

  font-size: 3.8rem;
  font-weight: 500;

  line-height: 1.08;
}

.destinations-intro > p {
  max-width: 620px;

  margin-top: 2rem;

  color: #555;

  font-size: 1.1rem;
  line-height: 1.8;
}

.destinations-index-link {
  display: inline-flex;
  align-items: center;
  gap: .55rem;
  margin-top: 1.5rem;
  color: var(--color-bosque);
  font-size: .8rem;
  font-weight: 600;
  letter-spacing: .03em;
  text-decoration: none;
}

.destinations-index-link span {
  transition: transform .25s ease;
}

.destinations-index-link:hover {
  color: var(--color-cobre);
}

.destinations-index-link:hover span {
  transform: translate(3px, -3px);
}

.destinations-grid {
  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 5rem 3rem;
}

.destinations-grid > :first-child {
  grid-column: 1 / -1;
}

@media (max-width: 800px) {

  .destinations {
    padding: 6rem 1.5rem;
  }

  .destinations-intro {
    margin-bottom: 4rem;
  }

  .destinations-intro h2 {
    font-size: 2.7rem;
  }

  .destinations-grid {
    grid-template-columns: 1fr;

    gap: 4rem;
  }

  .destinations-grid > :first-child {
    grid-column: auto;
  }

}

@media (max-width: 500px) {

  .destinations {
    padding: 5rem 1.25rem;
  }

  .destinations-intro h2 {
    font-size: 2.35rem;
  }

  .destinations-intro > p {
    font-size: 1rem;
    line-height: 1.7;
  }

}

@media (prefers-reduced-motion: reduce) {
  .destinations-index-link span {
    transition: none;
  }
}

</style>