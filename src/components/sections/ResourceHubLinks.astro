---
import { getPublicTravelResources } from "../../data/resources";

const resources = getPublicTravelResources();
---

{
  resources.length > 0 && (
    <section class="resource-hub-links" aria-labelledby="resource-hub-links-title">
      <div class="resource-hub-links__inner">
        <div>
          <p class="eyebrow">ANÁLISIS DE RECURSOS</p>
          <h2 id="resource-hub-links-title">Antes de salir de aquí, conoce por qué recomendamos cada recurso.</h2>
        </div>

        <nav aria-label="Análisis de recursos de viaje">
          {resources.map((resource) => (
            <a
              href={`/recursos/${resource.id}`}
              data-track="interaction"
              data-track-label={`Recursos — análisis de ${resource.title}`}
            >
              <span>{resource.category}</span>
              <strong>{resource.title}</strong>
              <small>Ver análisis →</small>
            </a>
          ))}
        </nav>
      </div>
    </section>
  )
}

<style>
  .resource-hub-links {
    padding: 2.5rem 2rem;
    background: #f3f0e9;
    border-bottom: 1px solid rgba(28,48,38,.12);
  }

  .resource-hub-links__inner {
    width: min(var(--content-width), 100%);
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr);
    gap: 3rem;
    align-items: center;
  }

  .resource-hub-links .eyebrow {
    margin: 0 0 .6rem;
    color: var(--color-cobre);
    font-size: .66rem;
    font-weight: 700;
    letter-spacing: .14em;
  }

  .resource-hub-links h2 {
    max-width: 620px;
    margin: 0;
    color: var(--color-bosque);
    font-family: var(--font-serif);
    font-size: clamp(1.9rem, 3vw, 3rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -.03em;
  }

  .resource-hub-links nav {
    display: grid;
    grid-template-columns: repeat(3, minmax(0,1fr));
    gap: .6rem;
  }

  .resource-hub-links a {
    display: block;
    min-height: 118px;
    padding: 1rem;
    border: 1px solid rgba(28,48,38,.12);
    background: var(--color-papel);
    color: inherit;
    text-decoration: none;
    transition: transform .2s ease, border-color .2s ease;
  }

  .resource-hub-links a:hover {
    transform: translateY(-2px);
    border-color: rgba(194,125,56,.65);
  }

  .resource-hub-links a span,
  .resource-hub-links a small {
    display: block;
    color: #777;
    font-size: .62rem;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .resource-hub-links a strong {
    display: block;
    margin-top: .55rem;
    color: var(--color-bosque);
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 400;
  }

  .resource-hub-links a small {
    margin-top: 1.1rem;
    color: var(--color-cobre);
  }

  @media (max-width: 900px) {
    .resource-hub-links__inner { grid-template-columns: 1fr; gap: 1.5rem; }
    .resource-hub-links nav { grid-template-columns: repeat(3, minmax(0,1fr)); }
  }

  @media (max-width: 600px) {
    .resource-hub-links { padding: 2rem 1rem; }
    .resource-hub-links nav { grid-template-columns: 1fr; }
    .resource-hub-links a { min-height: auto; }
  }

  @media (prefers-reduced-motion: reduce) {
    .resource-hub-links a { transition: none; }
  }
</style>
