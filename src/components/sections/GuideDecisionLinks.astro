---
import { getGuideBySlug } from "../../data/guides";

const match = Astro.url.pathname.match(/^\/viajes\/([^/]+)$/);
const slug = match?.[1];
const guide = slug ? getGuideBySlug(slug) : undefined;

const decisionTargets = guide
  ? [
      guide.sections.find((section) => section.id === "cuantos-dias"),
      guide.sections.find((section) => section.category === "planning"),
      guide.sections.find((section) => section.category === "practical"),
      guide.sections.find((section) => section.category === "updates"),
      guide.sections.find((section) => section.id === "preguntas-frecuentes"),
    ]
      .filter(
        (section): section is NonNullable<typeof section> => Boolean(section),
      )
      .filter(
        (section, index, sections) =>
          sections.findIndex((item) => item.id === section.id) === index,
      )
      .slice(0, 4)
  : [];

const labels: Record<string, string> = {
  "cuantos-dias": "Tiempo de viaje",
  "documentacion-y-entrada": "Preparar la entrada",
  "actualidad-y-avisos": "Comprobar actualidad",
  "preguntas-frecuentes": "Resolver dudas",
};
---

{guide && decisionTargets.length > 0 && (
  <section class="guide-decisions" aria-labelledby="guide-decisions-title">
    <div class="guide-decisions__shell">
      <div class="guide-decisions__header">
        <div>
          <p class="eyebrow">ANTES DE RESERVAR</p>
          <h2 id="guide-decisions-title">Lo que conviene resolver antes de dar forma al viaje.</h2>
        </div>
        <p>
          Hemos agrupado los puntos de la guía que suelen condicionar dónde ir, cuánto tiempo dedicar y qué preparar antes de reservar.
        </p>
      </div>

      <nav class="guide-decisions__grid" aria-label="Cuestiones importantes de esta guía">
        {decisionTargets.map((section) => (
          <a href={`/viajes/${guide.slug}#${section.id}`} class="guide-decision" data-track="interaction" data-track-label={`Guía — decisión — ${guide.slug} — ${section.id}`}>
            <span>{labels[section.id] ?? (section.category === "planning" ? "Planificar" : section.category === "practical" ? "Información práctica" : "A tener en cuenta")}</span>
            <strong>{section.title}</strong>
            <small>Ver esta cuestión <span aria-hidden="true">↗</span></small>
          </a>
        ))}
      </nav>
    </div>
  </section>
)}

<style>
  .guide-decisions {
    padding: 5.5rem 0;
    background: #ece9e1;
    border-top: 1px solid rgba(28,48,38,.1);
    border-bottom: 1px solid rgba(28,48,38,.1);
  }

  .guide-decisions__shell {
    width: min(var(--content-width), calc(100% - 4rem));
    margin-inline: auto;
  }

  .guide-decisions__header {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(280px, .55fr);
    gap: 4rem;
    align-items: end;
  }

  .guide-decisions .eyebrow {
    margin: 0 0 1rem;
    color: var(--color-cobre);
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .15em;
    text-transform: uppercase;
  }

  .guide-decisions h2 {
    max-width: 780px;
    margin: 0;
    color: var(--color-bosque);
    font-family: var(--font-serif);
    font-size: clamp(2.6rem, 5vw, 4.8rem);
    font-weight: 400;
    line-height: .98;
    letter-spacing: -.035em;
  }

  .guide-decisions__header > p {
    margin: 0;
    color: #666;
    line-height: 1.8;
  }

  .guide-decisions__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: .8rem;
    margin-top: 2.2rem;
  }

  .guide-decision {
    display: flex;
    min-height: 180px;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.35rem;
    border: 1px solid rgba(28,48,38,.14);
    background: var(--color-papel);
    color: var(--color-bosque);
    text-decoration: none;
    transition: transform .2s ease, border-color .2s ease;
  }

  .guide-decision:hover {
    transform: translateY(-2px);
    border-color: rgba(194,125,56,.7);
  }

  .guide-decision > span {
    color: var(--color-cobre);
    font-size: .63rem;
    font-weight: 700;
    letter-spacing: .11em;
    text-transform: uppercase;
  }

  .guide-decision strong {
    display: block;
    margin: 2rem 0;
    font-family: var(--font-serif);
    font-size: 1.65rem;
    font-weight: 400;
    line-height: 1.02;
  }

  .guide-decision small {
    color: #6a6a6a;
    font-size: .72rem;
  }

  .guide-decision small span { color: var(--color-cobre); }

  .guide-decision:focus-visible {
    outline: 3px solid var(--color-cobre);
    outline-offset: 3px;
  }

  @media (max-width: 1000px) {
    .guide-decisions__header { grid-template-columns: 1fr; gap: 1.5rem; }
    .guide-decisions__grid { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 600px) {
    .guide-decisions { padding: 4rem 0; }
    .guide-decisions__shell { width: calc(100% - 2rem); }
    .guide-decisions__grid { grid-template-columns: 1fr; }
    .guide-decision { min-height: 150px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .guide-decision { transition: none; }
  }
</style>
