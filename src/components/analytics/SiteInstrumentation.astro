<script>
  type EventPayload = Record<string, unknown>;

  const getReferrer = () => {
    if (!document.referrer) return null;
    try {
      const url = new URL(document.referrer);
      return `${url.origin}${url.pathname}`.slice(0, 1000);
    } catch {
      return null;
    }
  };

  const sendEvent = (name: string, payload: EventPayload = {}) => {
    const params = new URLSearchParams(window.location.search);
    const event = {
      event_name: name,
      path: window.location.pathname,
      label: typeof payload.label === "string" ? payload.label : null,
      href: typeof payload.href === "string" ? payload.href : null,
      referrer: getReferrer(),
      utm_source: params.get("utm_source"),
      utm_medium: params.get("utm_medium"),
      utm_campaign: params.get("utm_campaign"),
      step: typeof payload.step === "number" ? payload.step : null,
    };

    window.dispatchEvent(new CustomEvent("cm:analytics", { detail: event }));

    const analyticsWindow = window as typeof window & { dataLayer?: EventPayload[] };
    analyticsWindow.dataLayer = analyticsWindow.dataLayer ?? [];
    analyticsWindow.dataLayer.push({ event: name, ...event });

    const body = JSON.stringify(event);

    if (navigator.sendBeacon) {
      navigator.sendBeacon("/api/analytics/events", new Blob([body], { type: "application/json" }));
    } else {
      void fetch("/api/analytics/events", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body,
        keepalive: true,
      });
    }
  };

  const getFocusable = (container: Element): HTMLElement | null =>
    container.querySelector<HTMLElement>(
      "textarea:not([disabled]), input:not([disabled]), select:not([disabled]), button:not([disabled]), [tabindex]:not([tabindex='-1'])"
    );

  const ensureTravelFormAccessibility = () => {
    const form = document.querySelector<HTMLFormElement>("#journey-form");
    if (!form) return;

    const mobilityBlock = form.querySelector<HTMLElement>("[data-step='6']");
    const mobilityLabel = mobilityBlock?.querySelector<HTMLElement>(".question-number + label");
    const mobilityOptions = mobilityBlock?.querySelector<HTMLElement>(".transport-options");

    if (mobilityLabel && mobilityOptions) {
      if (!mobilityLabel.id) mobilityLabel.id = "mobility-question-label";
      mobilityOptions.setAttribute("aria-labelledby", mobilityLabel.id);
      mobilityOptions.setAttribute("role", "group");
      mobilityOptions.removeAttribute("aria-label");
    }

    form.querySelectorAll<HTMLElement>(".question-block").forEach((block) => {
      block.setAttribute("aria-current", block.classList.contains("active") ? "step" : "false");
    });
  };

  document.addEventListener("DOMContentLoaded", ensureTravelFormAccessibility, { once: true });

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;

    const element = event.target.closest<HTMLElement>("[data-track]");
    if (element) {
      sendEvent(element.dataset.track ?? "interaction", {
        label: element.dataset.trackLabel ?? element.textContent?.trim() ?? "",
        href: element.getAttribute("href") ?? null,
      });
    }

    const link = event.target.closest<HTMLAnchorElement>('a[href="/cuentatuviaje"]');
    if (link) {
      sendEvent("cta_travel_request", {
        label: link.textContent?.trim() ?? "Cuéntanos tu viaje",
        href: "/cuentatuviaje",
      });
    }

    const next = event.target.closest<HTMLButtonElement>("#journey-form .next-button");
    if (next) {
      const block = next.closest<HTMLElement>(".question-block");
      const step = Number(block?.dataset.step);
      sendEvent("travel_form_step", {
        step: Number.isInteger(step) ? step : null,
        label: block?.dataset.message ?? null,
      });

      window.setTimeout(() => {
        const activeQuestion = document.querySelector<HTMLElement>("#journey-form .question-block.active");
        activeQuestion?.setAttribute("aria-current", "step");
        formSiblingsUpdate(activeQuestion);
        getFocusable(activeQuestion ?? document.body)?.focus({ preventScroll: true });
      }, 60);
    }
  });

  const formSiblingsUpdate = (activeQuestion: HTMLElement | null) => {
    document.querySelectorAll<HTMLElement>("#journey-form .question-block").forEach((question) => {
      question.setAttribute("aria-current", question === activeQuestion ? "step" : "false");
    });
  };

  document.addEventListener("focusin", (event) => {
    if (!(event.target instanceof Element)) return;

    const form = event.target.closest<HTMLFormElement>("#journey-form");
    if (!form || form.hasAttribute("data-cm-form-started")) return;

    form.setAttribute("data-cm-form-started", "true");
    sendEvent("travel_form_start");
  });

  document.addEventListener("submit", (event) => {
    const form = event.target;
    if (form instanceof HTMLFormElement && form.id === "journey-form") {
      sendEvent("travel_form_submit");
    }
  });
</script>