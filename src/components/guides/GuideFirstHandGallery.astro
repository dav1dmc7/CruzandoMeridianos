---
import { Image } from "astro:assets";
import type { DestinationFirstHandMedia } from "../../data/guide-media";

interface Props {
  media: DestinationFirstHandMedia;
  limit?: number;
}

const { media, limit = 6 }: Props = Astro.props;
---

<section class="guide-first-hand" aria-labelledby="guide-first-hand-title">
  <div class="guide-shell">
    <div class="guide-first-hand__heading">
      <div>
        <p class="eyebrow">EXPERIENCIA PROPIA</p>
        <h2 id="guide-first-hand-title">También hemos vivido este destino sobre el terreno.</h2>
      </div>
      <p>
        Estas imágenes forman parte de nuestro viaje. Las utilizamos como contexto y
        prueba de experiencia, no como sustituto de la investigación ni como promesa
        de que tu viaje tenga que parecerse al nuestro.
      </p>
    </div>

    <div class="guide-first-hand__grid">
      {media.gallery.slice(0, limit).map((item, index) => (
        <figure class:list={["guide-first-hand__item", { "guide-first-hand__item--large": index === 0 || index === 3 }]}>
          <Image
            src={item.src}
            alt={item.alt}
            loading="lazy"
            sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 33vw"
          />
          <figcaption>{item.caption}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .guide-first-hand {
    padding: clamp(5rem, 9vw, 8rem) 0;
    background: var(--color-bosque);
    color: var(--color-papel);
  }

  .guide-first-hand__heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, .62fr);
    gap: 4rem;
    align-items: end;
    margin-bottom: 3.5rem;
  }

  .guide-first-hand__heading h2 {
    max-width: 820px;
    margin: 0;
    color: var(--color-papel);
    font-family: var(--font-serif);
    font-size: clamp(2.8rem, 5vw, 5rem);
    font-weight: 400;
    line-height: .97;
    letter-spacing: -.04em;
  }

  .guide-first-hand__heading > p {
    margin: 0;
    color: rgba(251,249,245,.7);
    font-size: .98rem;
    line-height: 1.8;
  }

  .guide-first-hand__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-flow: dense;
    gap: 1rem;
  }

  .guide-first-hand__item {
    position: relative;
    min-width: 0;
    min-height: 300px;
    margin: 0;
    overflow: hidden;
    border-radius: 18px;
    background: rgba(251,249,245,.06);
  }

  .guide-first-hand__item--large {
    grid-column: span 2;
  }

  .guide-first-hand__item img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 300px;
    object-fit: cover;
    transition: transform .6s cubic-bezier(.2,.65,.25,1);
  }

  .guide-first-hand__item:hover img {
    transform: scale(1.025);
  }

  .guide-first-hand__item figcaption {
    position: absolute;
    right: .8rem;
    bottom: .8rem;
    left: .8rem;
    padding: .65rem .75rem;
    border: 1px solid rgba(251,249,245,.18);
    border-radius: 10px;
    background: rgba(16,31,23,.62);
    color: rgba(251,249,245,.88);
    font-size: .72rem;
    line-height: 1.45;
    backdrop-filter: blur(8px);
  }

  @media (max-width: 900px) {
    .guide-first-hand__heading {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .guide-first-hand__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .guide-first-hand__grid {
      grid-template-columns: 1fr;
    }

    .guide-first-hand__item,
    .guide-first-hand__item--large {
      grid-column: span 1;
      min-height: 280px;
    }

    .guide-first-hand__item img {
      min-height: 280px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .guide-first-hand__item img {
      transition: none;
    }

    .guide-first-hand__item:hover img {
      transform: none;
    }
  }
</style>
