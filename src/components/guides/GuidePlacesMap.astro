---
import type { GuidePlace } from "../../data/guides/types";

interface Props {
  places: GuidePlace[];
}

const { places }: Props = Astro.props;

const mapWidth = 1024;
const mapHeight = 512;
const tileSize = 256;
const minZoom = 3;
const maxZoom = 11;

const projectX = (longitude: number, zoom: number): number => {
  const world = tileSize * 2 ** zoom;
  return ((longitude + 180) / 360) * world;
};

const projectY = (latitude: number, zoom: number): number => {
  const clamped = Math.max(-85.05112878, Math.min(85.05112878, latitude));
  const radians = (clamped * Math.PI) / 180;
  const world = tileSize * 2 ** zoom;
  return (
    (1 - Math.log(Math.tan(radians) + 1 / Math.cos(radians)) / Math.PI) / 2
  ) * world;
};

const chooseZoom = (items: GuidePlace[]): number => {
  if (items.length < 2) return 8;

  const longitudes = items.map((item) => item.longitude);
  const latitudes = items.map((item) => item.latitude);
  const minLongitude = Math.min(...longitudes);
  const maxLongitude = Math.max(...longitudes);
  const minLatitude = Math.min(...latitudes);
  const maxLatitude = Math.max(...latitudes);

  for (let zoom = maxZoom; zoom >= minZoom; zoom -= 1) {
    const width = Math.abs(projectX(maxLongitude, zoom) - projectX(minLongitude, zoom));
    const height = Math.abs(projectY(minLatitude, zoom) - projectY(maxLatitude, zoom));
    if (width <= mapWidth * 0.78 && height <= mapHeight * 0.72) return zoom;
  }

  return minZoom;
};

const zoom = chooseZoom(places);
type ProjectedGuidePlace = GuidePlace & {
  x: number;
  y: number;
};

const projected: ProjectedGuidePlace[] = places.map((place: GuidePlace) => ({
  ...place,
  x: projectX(place.longitude, zoom),
  y: projectY(place.latitude, zoom),
}));

const centerX =
  projected.reduce(
    (sum: number, place: ProjectedGuidePlace) => sum + place.x,
    0,
  ) / projected.length;

const centerY =
  projected.reduce(
    (sum: number, place: ProjectedGuidePlace) => sum + place.y,
    0,
  ) / projected.length;

const originX = Math.floor(centerX / tileSize) - 2;
const originY = Math.floor(centerY / tileSize) - 1;

const tiles = Array.from({ length: 8 }, (_, index) => {
  const column = index % 4;
  const row = Math.floor(index / 4);
  const x = originX + column;
  const y = originY + row;
  const tileCount = 2 ** zoom;
  const wrappedX = ((x % tileCount) + tileCount) % tileCount;
  return {
    key: `${wrappedX}-${y}`,
    left: `${column * 25}%`,
    top: `${row * 50}%`,
    src: `https://tile.openstreetmap.org/${zoom}/${wrappedX}/${y}.png`,
  };
});

const mapOriginX = originX * tileSize;
const mapOriginY = originY * tileSize;

const markers = projected.map((place, index) => ({
  ...place,
  index,
  left: `${((place.x - mapOriginX) / mapWidth) * 100}%`,
  top: `${((place.y - mapOriginY) / mapHeight) * 100}%`,
}));
---

<section class="guide-places" id="lugares-clave" aria-labelledby="guide-places-title">
  <div class="guide-shell">
    <div class="guide-places__heading">
      <div>
        <p class="eyebrow">LUGARES CLAVE</p>
        <h2 id="guide-places-title">Pocos lugares. Una lectura más clara del destino.</h2>
      </div>
      <p>
        No es una lista de todo lo que existe. Hemos escogido algunos lugares que ayudan
        a entender cómo se organiza el viaje y qué zonas merece la pena considerar.
      </p>
    </div>

    <div class="guide-places__layout">
      <div class="guide-places__list" aria-label="Lugares clave del destino">
        {places.map((place, index) => (
          <button
            type="button"
            class="guide-place"
            data-place-id={place.id}
          >
            <span class="guide-place__number">{String(index + 1).padStart(2, "0")}</span>
            <span class="guide-place__copy">
              <strong>{place.name}</strong>
              {place.region && <small>{place.region}</small>}
              <span>{place.description}</span>
            </span>
            <span class="guide-place__arrow" aria-hidden="true">↗</span>
          </button>
        ))}
      </div>

      <div class="guide-places__map-wrap">
        <div
          class="guide-places__map"
          role="group"
          aria-label={`Mapa orientativo con ${places.length} lugares clave de ${places.map((place) => place.name).join(", ")}`}
        >
          <div class="guide-places__tiles" aria-hidden="true">
            {tiles.map((tile) => (
              <img
                src={tile.src}
                alt=""
                loading="lazy"
                class="guide-map-tile"
                style={`left:${tile.left};top:${tile.top};`}
              />
            ))}
          </div>

          <div class="guide-places__markers">
            {markers.map((place) => (
              <button
                type="button"
                class="guide-place-marker"
                data-place-id={place.id}
                aria-label={`Ver ${place.name}`}
                style={`left:${place.left};top:${place.top};--marker-index:${place.index};`}
              >
                <span>{String(place.index + 1).padStart(2, "0")}</span>
              </button>
            ))}
          </div>

          <div class="guide-places__map-badge">
            <span>MAPA ORIENTATIVO</span>
            <strong>Zoom {zoom}</strong>
          </div>

          <a
            class="guide-places__attribution"
            href="https://www.openstreetmap.org/copyright"
            target="_blank"
            rel="noreferrer"
          >
            © OpenStreetMap contributors
          </a>
        </div>
      </div>
    </div>
  </div>

  <script>
    const placeControls = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-place-id]")
    );

    const activatePlace = (id: string) => {
      placeControls.forEach((control) => {
        control.classList.toggle("is-active", control.dataset.placeId === id);
      });
    };

    placeControls.forEach((control) => {
      control.addEventListener("click", () => {
        const id = control.dataset.placeId;
        if (!id) return;

        activatePlace(id);

        if (control.classList.contains("guide-place-marker")) {
          const target = document.querySelector<HTMLButtonElement>(
            `.guide-place[data-place-id="${CSS.escape(id)}"]`
          );
          target?.scrollIntoView({ behavior: "smooth", block: "nearest" });
        }
      });
    });
  </script>
</section>

<style>
  .guide-places {
    padding: clamp(5rem, 9vw, 8rem) 0;
    background: #f2efe8;
  }

  .guide-places__heading {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(260px, .55fr);
    gap: 4rem;
    align-items: end;
    margin-bottom: 3.5rem;
  }

  .guide-places__heading h2 {
    max-width: 760px;
    margin: 0;
    color: var(--color-bosque);
    font-family: var(--font-serif);
    font-size: clamp(2.8rem, 5vw, 5rem);
    font-weight: 400;
    line-height: .97;
    letter-spacing: -.04em;
  }

  .guide-places__heading > p {
    margin: 0;
    color: rgba(20,45,35,.62);
    font-size: .98rem;
    line-height: 1.8;
  }

  .guide-places__layout {
    display: grid;
    grid-template-columns: minmax(320px, .78fr) minmax(0, 1.22fr);
    gap: 3rem;
    align-items: start;
  }

  .guide-places__list {
    display: grid;
    gap: .65rem;
  }

  .guide-place {
    display: grid;
    grid-template-columns: 2.2rem minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: start;
    width: 100%;
    padding: 1.1rem 1rem;
    border: 1px solid rgba(28,48,38,.10);
    border-radius: 15px;
    background: rgba(251,249,245,.78);
    color: var(--color-bosque);
    text-align: left;
    cursor: pointer;
    transition: transform .2s ease, border-color .2s ease, background .2s ease;
  }

  .guide-place:focus-visible {
    outline: 2px solid var(--color-cobre);
    outline-offset: 3px;
  }

  .guide-place:hover,
  .guide-place.is-active {
    transform: translateX(4px);
    border-color: rgba(194,125,56,.55);
    background: rgba(251,249,245,1);
  }

  .guide-place__number {
    color: var(--color-cobre);
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: 1px;
  }

  .guide-place__copy strong {
    display: block;
    margin-bottom: .2rem;
    font-family: var(--font-serif);
    font-size: 1.45rem;
    font-weight: 400;
  }

  .guide-place__copy small {
    display: block;
    margin-bottom: .45rem;
    color: rgba(20,45,35,.5);
    font-size: .67rem;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .guide-place__copy span {
    display: block;
    color: rgba(20,45,35,.64);
    font-size: .84rem;
    line-height: 1.65;
  }

  .guide-place__arrow {
    color: var(--color-cobre);
    font-size: 1.05rem;
  }

  .guide-places__map-wrap {
    position: sticky;
    top: 7rem;
  }

  .guide-places__map {
    position: relative;
    aspect-ratio: 2 / 1;
    overflow: hidden;
    border-radius: 18px;
    background: #d7d1c5;
    box-shadow: 0 18px 50px rgba(28,48,38,.11);
    isolation: isolate;
  }

  .guide-places__tiles,
  .guide-places__markers {
    position: absolute;
    inset: 0;
  }

  .guide-map-tile {
    position: absolute;
    width: 25%;
    height: 50%;
    object-fit: cover;
    display: block;
  }

  .guide-places__markers {
    pointer-events: none;
  }

  .guide-place-marker {
    position: absolute;
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    transform: translate(-50%, -50%);
    border: 2px solid var(--color-papel);
    border-radius: 50%;
    background: var(--color-bosque);
    color: var(--color-papel);
    font-size: .58rem;
    font-weight: 700;
    cursor: pointer;
    pointer-events: auto;
    box-shadow: 0 5px 14px rgba(28,48,38,.24);
    opacity: 0;
    animation: guidePlaceMarkerIn .45s ease forwards;
    animation-delay: calc(var(--marker-index) * 70ms);
    transition: transform .18s ease, background .18s ease, box-shadow .18s ease;
  }

  .guide-place-marker:hover,
  .guide-place-marker.is-active {
    transform: translate(-50%, -50%) scale(1.16);
    background: var(--color-cobre);
    box-shadow: 0 8px 22px rgba(28,48,38,.28);
    z-index: 3;
  }

  .guide-places__map-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 4;
    padding: .55rem .7rem;
    border: 1px solid rgba(251,249,245,.45);
    border-radius: 999px;
    background: rgba(28,48,38,.78);
    color: var(--color-papel);
    backdrop-filter: blur(8px);
  }

  .guide-places__map-badge span,
  .guide-places__map-badge strong {
    display: block;
  }

  .guide-places__map-badge span {
    font-size: .56rem;
    font-weight: 700;
    letter-spacing: 1.3px;
  }

  .guide-places__map-badge strong {
    margin-top: .15rem;
    font-size: .7rem;
    font-weight: 500;
    opacity: .78;
  }

  .guide-places__attribution {
    position: absolute;
    right: .55rem;
    bottom: .4rem;
    z-index: 4;
    padding: .2rem .35rem;
    border-radius: 5px;
    background: rgba(251,249,245,.78);
    color: #555;
    font-size: .58rem;
    text-decoration: none;
    backdrop-filter: blur(4px);
  }

  @keyframes guidePlaceMarkerIn {
    from { opacity: 0; transform: translate(-50%, -50%) scale(.55); }
    to { opacity: 1; transform: translate(-50%, -50%) scale(1); }
  }

  @media (max-width: 900px) {
    .guide-places__heading,
    .guide-places__layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .guide-places__map-wrap {
      position: static;
    }
  }

  @media (max-width: 640px) {
    .guide-places {
      padding: 5rem 0;
    }

    .guide-places__heading h2 {
      font-size: clamp(2.6rem, 11vw, 4rem);
    }

    .guide-place__copy strong {
      font-size: 1.25rem;
    }

    .guide-places__map {
      aspect-ratio: 1.35 / 1;
    }

    .guide-map-tile {
      height: 50%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .guide-place,
    .guide-place-marker {
      transition: none;
      animation: none;
      opacity: 1;
    }
  }
</style>
