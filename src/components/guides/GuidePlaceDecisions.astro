---
import type { GuidePlace } from "../../data/guides/types";

interface Props {
  places: GuidePlace[];
}

const { places }: Props = Astro.props;
const enrichedPlaces = places;
---

{
  enrichedPlaces.length > 0 && (
    <section class="guide-place-decisions" aria-labelledby="guide-place-decisions-title">
      <div class="guide-shell">
        <div class="guide-place-decisions__header">
          <div>
            <p class="eyebrow">Cómo leer el mapa</p>
            <h2 id="guide-place-decisions-title">No todos los lugares cumplen la misma función.</h2>
          </div>

          <p>
            El mapa responde a «¿dónde está?». Esta capa enseña las variables que hay que cruzar:
            qué aporta una zona, para quién tiene sentido y cuánto tiempo merece dentro de una ruta.
          </p>
        </div>

        <div class="guide-place-decisions__grid">
          {
            enrichedPlaces.map((place) => (
              <article class="guide-place-decision">
                <div class="guide-place-decision__meta">
                  {place.region && <span>{place.region}</span>}
                  {place.recommendedNights && (
                    <strong>{place.recommendedNights}</strong>
                  )}
                </div>

                <h3>{place.name}</h3>

                <p>{place.description}</p>

                {place.fit && (
                  <div class="guide-place-decision__detail">
                    <span>Encaja especialmente si</span>
                    <p>{place.fit}</p>
                  </div>
                )}

                {place.routeNote ? (
                  <div class="guide-place-decision__detail">
                    <span>Cómo encaja</span>
                    <p>{place.routeNote}</p>
                  </div>
                ) : (
                  <div class="guide-place-decision__detail">
                    <span>La pregunta que queda abierta</span>
                    <p>
                      ¿Qué aporta esta zona que no consigues en otra y cuánto
                      tiempo, energía y desplazamiento cuesta incorporarla?
                    </p>
                  </div>
                )}
              </article>
            ))
          }
        </div>

        <div class="guide-place-decisions__boundary">
          <div>
            <span class="guide-place-decisions__boundary-label">Aquí empieza el trabajo difícil</span>
            <h3>Las piezas las puedes ver. La combinación correcta depende de tu viaje.</h3>
            <p>
              Fechas, presupuesto, ritmo, intereses, noches disponibles y forma de desplazarte
              cambian qué merece entrar y qué conviene dejar fuera. La guía enseña el problema;
              nosotros hacemos la investigación y el cruce de decisiones cuando el viaje es para ti.
            </p>
          </div>

          <a href="/cuentatuviaje">Cuéntanos tu viaje <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>
  )
}

<style>
.guide-place-decisions {
  padding: 7rem 0;
  background: #f3f0e9;
}

.guide-place-decisions__header {
  display: grid;
  grid-template-columns: 1fr .72fr;
  gap: 4rem;
  align-items: end;
  margin-bottom: 3.5rem;
}

.guide-place-decisions__header h2 {
  max-width: 720px;
  margin: .7rem 0 0;
  font-family: var(--font-serif);
  font-size: clamp(3rem, 5vw, 5rem);
  font-weight: 400;
  line-height: .98;
  letter-spacing: -.035em;
  color: var(--color-bosque);
}

.guide-place-decisions__header > p {
  max-width: 540px;
  margin: 0;
  color: #5b5b5b;
  line-height: 1.8;
}

.guide-place-decisions__grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1px;
  border-top: 1px solid rgba(28,48,38,.18);
  border-left: 1px solid rgba(28,48,38,.18);
}

.guide-place-decision {
  min-height: 100%;
  padding: 2rem;
  border-right: 1px solid rgba(28,48,38,.18);
  border-bottom: 1px solid rgba(28,48,38,.18);
  background: rgba(251,249,245,.55);
}

.guide-place-decision__meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1rem;
  margin-bottom: 1.4rem;
  color: #777;
  font-size: .72rem;
  letter-spacing: .08em;
  text-transform: uppercase;
}

.guide-place-decision__meta strong {
  color: var(--color-cobre);
  font-weight: 600;
  white-space: nowrap;
}

.guide-place-decision h3 {
  margin: 0;
  font-family: var(--font-serif);
  font-size: 2rem;
  font-weight: 400;
  color: var(--color-bosque);
}

.guide-place-decision > p {
  margin: 1rem 0 0;
  color: #5b5b5b;
  line-height: 1.7;
}

.guide-place-decision__detail {
  margin-top: 1.4rem;
  padding-top: 1.1rem;
  border-top: 1px solid rgba(28,48,38,.12);
}

.guide-place-decision__detail span {
  display: block;
  margin-bottom: .4rem;
  color: var(--color-bosque);
  font-size: .68rem;
  font-weight: 600;
  letter-spacing: .12em;
  text-transform: uppercase;
}

.guide-place-decision__detail p {
  margin: 0;
  color: #696969;
  font-size: .92rem;
  line-height: 1.65;
}

.guide-place-decisions__boundary {
  display: grid;
  grid-template-columns: minmax(0,1fr) auto;
  gap: 2rem;
  align-items: end;
  margin-top: 3rem;
  padding: 2rem;
  border: 1px solid rgba(28,48,38,.18);
  background: rgba(251,249,245,.68);
}

.guide-place-decisions__boundary-label {
  display: block;
  margin-bottom: .7rem;
  color: var(--color-cobre);
  font-size: .68rem;
  font-weight: 700;
  letter-spacing: .14em;
  text-transform: uppercase;
}

.guide-place-decisions__boundary h3 {
  max-width: 720px;
  margin: 0;
  color: var(--color-bosque);
  font-family: var(--font-serif);
  font-size: clamp(1.8rem, 3vw, 2.8rem);
  font-weight: 400;
  line-height: 1.05;
}

.guide-place-decisions__boundary p {
  max-width: 720px;
  margin: 1rem 0 0;
  color: #5b5b5b;
  line-height: 1.75;
}

.guide-place-decisions__boundary a {
  display: inline-flex;
  align-items: center;
  gap: .6rem;
  padding: .85rem 1.15rem;
  border-radius: 999px;
  background: var(--color-bosque);
  color: var(--color-papel);
  text-decoration: none;
  font-size: .84rem;
  font-weight: 600;
  white-space: nowrap;
}

.guide-place-decisions__boundary a:focus-visible {
  outline: 2px solid var(--color-cobre);
  outline-offset: 4px;
}

@media (max-width: 900px) {
  .guide-place-decisions__header {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
}

@media (max-width: 680px) {
  .guide-place-decisions {
    padding: 5rem 0;
  }

  .guide-place-decisions__grid {
    grid-template-columns: 1fr;
  }

  .guide-place-decision {
    padding: 1.4rem;
  }

  .guide-place-decisions__boundary {
    grid-template-columns: 1fr;
    align-items: start;
    padding: 1.4rem;
  }

  .guide-place-decision__meta {
    align-items: flex-start;
    flex-direction: column;
  }
}
</style>
